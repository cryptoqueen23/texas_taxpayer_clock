---
import units from '../../public/data/tax-units.json';
import debt from '../../public/data/local-debt-2025.json';
const {lang='en'}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const ids=new Set(units.map(r=>r.id));
const rows=debt.records.filter(r=>!ids.has(r.id)).sort((a,b)=>b.principal-a.principal);
const money=(n:number)=>n.toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0});
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Unmatched debt records','Registros de deuda sin coincidencia')}</title><style>body{background:#081526;color:#f4f6fa;font:1rem/1.5 system-ui;margin:0}main{max-width:1100px;margin:auto;padding:1rem}a,h1{color:#e1bd75}nav{display:flex;gap:1rem;flex-wrap:wrap}.scroll{overflow:auto}table{border-collapse:collapse;width:100%}th,td{text-align:left;padding:.6rem;border-bottom:1px solid #42536a}td.num{text-align:right;white-space:nowrap}input{font:inherit;padding:.6rem;width:100%;box-sizing:border-box} :focus-visible{outline:3px solid #e1bd75}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href="/unmatched-debt/">English</a><a href="/es/unmatched-debt/">Español</a></nav><h1>{t('Unmatched FY2025 debt records','Registros de deuda AF2025 sin coincidencia')}</h1><p>{t('These records are included in statewide debt totals but have no exact identifier match in the property tax directory. This is not evidence of concealed debt. No name-based matches are assumed.','Estos registros se incluyen en los totales estatales de deuda, pero no tienen coincidencia exacta de identificador en el directorio tributario. Esto no demuestra deuda oculta. No se presumen coincidencias por nombre.')}</p><p>{rows.length} {t('records','registros')} · {money(rows.reduce((s,r)=>s+r.principal,0))} {t('outstanding principal','principal pendiente')}</p><p>{t('Evidence: FY2025 local debt dataset minus exact identifiers in the property tax dataset. Original agency reconciliation pending.','Evidencia: conjunto de deuda local AF2025 menos identificadores exactos del conjunto tributario. Conciliación con la fuente original pendiente.')}</p><p><a href="/data/local-debt-2025.json">{t('Debt dataset','Datos de deuda')}</a> · <a href="/data/tax-units.json">{t('Tax directory dataset','Datos del directorio tributario')}</a></p><label for="filter">{t('Search name, identifier or type','Buscar nombre, identificador o tipo')}</label><input id="filter" type="search"/><p id="count" aria-live="polite"></p><div class="scroll" tabindex="0"><table><thead><tr>{[t('Identifier','Identificador'),t('Government','Gobierno'),t('Type code','Código de tipo'),t('Principal','Principal'),t('Interest','Intereses'),t('Reported repayment','Pago reportado')].map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{rows.map(r=><tr><td>{r.id}</td><td>{r.name}</td><td>{r.type}</td><td class="num">{money(r.principal)}</td><td class="num">{money(r.interest)}</td><td class="num">{money(r.repayment)}</td></tr>)}</tbody></table></div></main><script>
const input=document.querySelector<HTMLInputElement>('#filter')!;
const rows=Array.from(document.querySelectorAll<HTMLTableRowElement>('tbody tr'));
const count=document.querySelector('#count')!;
function filter(){const q=input.value.trim().toLowerCase();let n=0;for(const row of rows){row.hidden=!row.textContent?.toLowerCase().includes(q);if(!row.hidden)n++;}count.textContent=n+' / '+rows.length;}
input.addEventListener('input',filter);filter();
</script></body></html>

---
import units from '../../public/data/tax-units.json';
import aliases from '../data/profile-aliases.json';
const {lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const records=units.map(u=>({...u,name:u.id.endsWith('-000-00')&&!/ County$/i.test(u.name)?u.name+' County':u.name,type:u.id.endsWith('-000-00')?'county':u.id.endsWith('-02')?'school':u.id.endsWith('-03')?'city':'other',profile:(aliases as Record<string,string>)[u.id]??u.id}));
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Texas Property Tax Leaderboard','Clasificación de impuestos sobre propiedades')}</title><style is:inline>body{background:#081526;color:#f4f6fa;font:1rem system-ui;margin:0}main{max-width:1100px;margin:auto;padding:1rem}a,h1{color:#e1bd75}nav,.controls{display:flex;gap:1rem;flex-wrap:wrap}label{display:grid;gap:.4rem}input,select,button{font:inherit;padding:.6rem;background:#142740;color:#fff;border:1px solid #8190a4;border-radius:6px;max-width:100%}button{cursor:pointer}a:focus-visible,input:focus-visible,select:focus-visible,button:focus-visible{outline:3px solid #e1bd75}table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}th,td{padding:.65rem;text-align:left;border-bottom:1px solid #42536a;white-space:nowrap}.scroll{overflow:auto}button:disabled{opacity:.5}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href="/tax-rates/">🇺🇸 EN</a><a href="/es/tax-rates/">🇵🇷 ES</a></nav><h1>{t('Texas Property Tax Leaderboard','Clasificación de impuestos sobre propiedades')}</h1><p>{t('2021–2025 · Rates in dollars per $100 of taxable value. Rates are not tax bills, levies or collections.','2021–2025 · Tasas en dólares por cada $100 de valor imponible. No son facturas, gravámenes totales ni recaudaciones.')}</p><div class="controls"><label>{t('Name or ID','Nombre o identificador')}<input id="search" type="search"/></label><label>{t('Government type','Tipo de gobierno')}<select id="type"><option value="">{t('All types','Todos')}</option><option value="city">{t('Cities','Ciudades')}</option><option value="county">{t('Counties','Condados')}</option><option value="school">{t('School districts','Distritos escolares')}</option><option value="other">{t('Other taxing units','Otras entidades')}</option></select></label><label>{t('Year','Año')}<select id="year">{[2025,2024,2023,2022,2021].map(y=><option value={y}>{y}</option>)}</select></label><label>{t('Rank by','Clasificar por')}<select id="metric"><option value="rate">{t('Highest rate','Mayor tasa')}</option><option value="increase">{t('Largest annual increase (%)','Mayor aumento anual (%)')}</option><option value="decrease">{t('Largest annual decrease (%)','Mayor reducción anual (%)')}</option></select></label></div><p id="status" role="status"></p><div class="scroll" tabindex="0" aria-label={t('Tax rankings','Clasificación de tasas')}><table><thead><tr><th scope="col">#</th><th scope="col">{t('Government','Gobierno')}</th><th scope="col">{t('Selected rate','Tasa seleccionada')}</th><th scope="col">{t('Annual change','Cambio anual')}</th>{[2021,2022,2023,2024,2025].map(y=><th scope="col">{y}</th>)}</tr></thead><tbody id="results"></tbody></table></div><p><button id="prev">{t('Previous','Anterior')}</button> <button id="next">{t('Next','Siguiente')}</button></p><p>{t('Missing rates and undefined percentage changes are excluded from the relevant rankings. Annual change requires a positive prior-year rate. Rankings precede name filtering. Taxing unit categories are based on identifier suffixes.','Las tasas faltantes y cambios porcentuales indefinidos se excluyen. El cambio anual requiere una tasa previa positiva. La clasificación precede al filtro por nombre. Las categorías se basan en los sufijos de identificadores.')}</p><a href="https://comptroller.texas.gov/taxes/property-tax/rates/index.php">{t('Texas Comptroller · official source','Contraloría de Texas · fuente oficial')}</a><noscript>{t('Enable JavaScript to view rankings.','Active JavaScript para ver la clasificación.')}</noscript></main><script is:inline define:vars={{records,es}}>
const q=document.getElementById('search'),type=document.getElementById('type'),year=document.getElementById('year'),metric=document.getElementById('metric'),out=document.getElementById('results'),status=document.getElementById('status'),prev=document.getElementById('prev'),next=document.getElementById('next');let page=0;
const rate=v=>v==null?'—':'$'+v.toFixed(6);
function render(){const y=Number(year.value),m=metric.value,term=q.value.trim().toLowerCase();const ranked=records.filter(r=>!type.value||r.type===type.value).map(r=>{const v=r.rates[y],p=r.rates[y-1];return {...r,v,change:v!=null&&p>0?(v-p)/p*100:null}}).filter(r=>r.v!=null&&(m==='rate'||(r.change!=null&&(m==='increase'?r.change>0:r.change<0)))).sort((a,b)=>(m==='rate'?b.v-a.v:m==='increase'?b.change-a.change:a.change-b.change)||a.id.localeCompare(b.id)).map((r,i)=>({...r,rank:i+1}));const matches=ranked.filter(r=>(r.name+' '+r.id).toLowerCase().includes(term));out.replaceChildren();for(const r of matches.slice(page*50,page*50+50)){const tr=document.createElement('tr');const rank=document.createElement('td');rank.textContent=r.rank;tr.append(rank);const name=document.createElement('td'),a=document.createElement('a');a.href=(es?'/es':'')+'/government/'+r.profile+'/';a.textContent=r.name+' · '+r.id;name.append(a);tr.append(name);for(const value of [rate(r.v),r.change==null?'—':r.change.toFixed(2)+'%',...[2021,2022,2023,2024,2025].map(y=>rate(r.rates[y]))]){const td=document.createElement('td');td.textContent=value;tr.append(td)}out.append(tr)}status.textContent=matches.length+(es?' resultados · página ':' results · page ')+(page+1)+' / '+Math.max(1,Math.ceil(matches.length/50));prev.disabled=page===0;next.disabled=(page+1)*50>=matches.length}
for(const el of [q,type,year,metric])el.addEventListener('input',()=>{page=0;render()});prev.onclick=()=>{page--;render()};next.onclick=()=>{page++;render()};render();
</script></body></html>
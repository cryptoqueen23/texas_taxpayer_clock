---
import finance from '../../public/data/texas-state-finances-2026.json';
import taxes from '../data/taxes.json';
const {lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const money=(n:number)=>new Intl.NumberFormat(es?'es-US':'en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
const rows=[{name:t('Property tax levies','Gravámenes sobre propiedades'),value:taxes.property},{name:t('State sales tax','Impuesto estatal sobre ventas'),value:taxes.stateSales},{name:t('Local sales taxes','Impuestos locales sobre ventas'),value:taxes.localSales},{name:t('Other state taxes','Otros impuestos estatales'),value:taxes.otherState}];
const cash=(label:string)=>finance.cashRevenue.find(r=>r.label===label)?.amount;
const expense=(label:string)=>finance.cashExpenditure.find(r=>r.label===label)?.amount;
const flow=(label:string)=>finance.localFlows.find(r=>r.label===label)?.amount;
const historical=finance.historical as Record<string,{category:string,annual:number|null,monthly:(number|null)[]}[]>;
const categories=[...new Set(Object.values(historical).flatMap(rows=>rows.map(r=>r.category)))].sort();
const sources=[{name:t('State cash report','Informe estatal de efectivo'),url:'https://comptroller.texas.gov/transparency/reports/cash-report/'},{name:t('State revenue watch','Seguimiento de ingresos estatales'),url:'https://comptroller.texas.gov/transparency/revenue/watch/'},{name:t('Property tax rates and levies','Tasas y gravámenes sobre propiedades'),url:'https://comptroller.texas.gov/taxes/property-tax/rates/index.php'},{name:t('Economic development corporations','Corporaciones de desarrollo económico'),url:'https://comptroller.texas.gov/transparency/reports/economic-development-corporation/'}];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Revenue and Spending Explorer','Explorador de ingresos y gastos')}</title><style is:inline>body{margin:0;background:#081526;color:#f4f6fa;font:1rem system-ui}main{max-width:1000px;margin:auto;padding:1rem}a,h1,strong{color:#e1bd75}nav{display:flex;gap:1rem;flex-wrap:wrap}article{background:#142740;border:1px solid #42536a;padding:1rem;border-radius:10px;margin:1rem 0}strong{font-size:clamp(1.2rem,5vw,2rem);overflow-wrap:anywhere}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:.6rem .25rem;border-bottom:1px solid #42536a}td:last-child{text-align:right}meter{width:100%;height:1rem}a:focus-visible{outline:3px solid white}small{color:#c4cfdd}h2{font-size:1.25rem}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href="/revenue/">🇺🇸 EN</a><a href="/es/revenue/">🇵🇷 ES</a></nav><h1>{t('Revenue and Spending Explorer','Explorador de ingresos y gastos')}</h1><p>{t('Follow the money from taxes to government finances. Reporting periods and accounting measures are identified separately.','Siga el dinero desde los impuestos hasta las finanzas públicas. Los períodos y las medidas contables se identifican por separado.')}</p><article><h2>{t('Reported statewide tax measures · 2023','Medidas tributarias estatales reportadas · 2023')}</h2><strong>{money(taxes.total)}</strong><p>{t('Combined tax measures reported by the Comptroller, including property tax levies. Not consolidated cash revenue or total government revenue.','Medidas tributarias combinadas reportadas por la Contraloría, incluidos gravámenes sobre propiedades. No representan ingresos consolidados en efectivo ni ingresos públicos totales.')}</p>{rows.map(r=><div><p>{r.name}: <b>{money(r.value)}</b> · {(r.value/taxes.total*100).toFixed(2)}%</p><meter min="0" max={taxes.total} value={r.value} aria-label={r.name}/></div>)}<p><a href={taxes.source}>{t('Official report · Exhibit 1, page 5','Informe oficial · Cuadro 1, página 5')}</a></p></article><article><h2>{t('FY2026 Annual Cash Report · All Funds','Informe anual de efectivo AF2026 · Todos los fondos')}</h2><p>{t('Year ended August 31, 2026. Net revenue and expenditures exclude separately reported other sources and uses.','Ejercicio terminado el 31 de agosto de 2026. Los ingresos y gastos netos excluyen otras fuentes y usos reportados por separado.')}</p><table><tbody>{[{n:t('Net revenue','Ingresos netos'),v:cash('TOTAL NET REVENUE')},{n:t('Net expenditures','Gastos netos'),v:expense('TOTAL NET EXPENDITURES')},{n:t('Tax collections','Recaudación tributaria'),v:cash('Tax Collections')},{n:t('Federal income','Ingresos federales'),v:cash('Federal Income')}].map(r=><tr><th scope="row">{r.n}</th><td>{r.v==null?t('Unavailable','No disponible'):money(r.v)}</td></tr>)}</tbody></table><p>{t('Detailed expenditure classifications are withheld pending reconciliation of unmatched source labels.','Las clasificaciones detalladas de gastos están pendientes de conciliación de etiquetas sin identificar.')}</p><a href={finance.cashSource}>{t('Annual Cash Report · Table 1','Informe anual de efectivo · Cuadro 1')}</a></article>
<article><h2>{t('Funds to local governments · FY2026','Fondos a gobiernos locales · AF2026')}</h2><table><tbody>{[{n:t('Total funds','Fondos totales'),v:flow('TOTAL FUNDS TO LOCAL GOVERNMENTS')},{n:t('State and federal grants','Subvenciones estatales y federales'),v:flow('TOTAL STATE AND FEDERAL GRANTS')},{n:t('Shared revenue','Ingresos compartidos'),v:flow('TOTAL SHARED REVENUE')},{n:t('Taxes collected in trust','Impuestos recaudados en fideicomiso'),v:flow('TOTAL TAXES COLLECTED IN TRUST')},{n:t('City sales tax (included above)','Impuesto municipal sobre ventas (incluido arriba)'),v:flow('City Sales Tax')},{n:t('County sales tax (included above)','Impuesto de condado sobre ventas (incluido arriba)'),v:flow('County Sales Tax')}].map(r=><tr><th scope="row">{r.n}</th><td>{r.v==null?t('Unavailable','No disponible'):money(r.v)}</td></tr>)}</tbody></table><p>{t('These transfers and allocations are not additional statewide revenue. Do not add them to the cash report totals.','Estas transferencias y asignaciones no son ingresos estatales adicionales. No deben sumarse a los totales del informe de efectivo.')}</p></article>
<article><h2>{t('Historical revenue · FY2003–2026','Ingresos históricos · AF2003–2026')}</h2><p>{t('All Funds (Excluding Trusts). Separate reporting scope from the Annual Cash Report. Original source category names are retained in English.','Todos los fondos (excluidos fideicomisos). Alcance distinto del informe anual de efectivo. Se conservan los nombres originales de las categorías en inglés.')}</p><label for="rev-category">{t('Revenue category','Categoría de ingresos')}</label><select id="rev-category" style="display:block;max-width:100%;padding:.5rem;font:inherit">{categories.map(c=><option value={c} selected={c==='Total Net Revenue'}>{c}</option>)}</select><label for="rev-year">{t('Fiscal year for monthly detail','Año fiscal para detalle mensual')}</label><select id="rev-year" style="display:block;padding:.5rem;font:inherit">{Object.keys(historical).reverse().map(y=><option value={y}>{y}</option>)}</select><h3>{t('Annual comparison','Comparación anual')}</h3><table><thead><tr><th>{t('Fiscal year','Año fiscal')}</th><th>{t('Reported amount','Monto reportado')}</th></tr></thead><tbody id="rev-annual"></tbody></table><h3>{t('Monthly detail · September–August','Detalle mensual · Septiembre–agosto')}</h3><table><tbody id="rev-monthly"></tbody></table><p><a href={finance.historicalSource}>{t('Official historical revenue source','Fuente oficial de ingresos históricos')}</a></p></article>
<script is:inline define:vars={{historical,es}}>const cat=document.getElementById('rev-category'),yr=document.getElementById('rev-year');const fmt=v=>v==null?(es?'No disponible':'Unavailable'):new Intl.NumberFormat(es?'es-US':'en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(v);function row(body,label,value){const tr=document.createElement('tr'),th=document.createElement('th'),td=document.createElement('td');th.scope='row';th.textContent=label;td.textContent=fmt(value);tr.append(th,td);body.append(tr)}function render(){const annual=document.getElementById('rev-annual'),monthly=document.getElementById('rev-monthly');annual.replaceChildren();monthly.replaceChildren();for(const y of Object.keys(historical).reverse())row(annual,y,historical[y].find(r=>r.category===cat.value)?.annual);const rec=historical[yr.value].find(r=>r.category===cat.value);for(let i=0;i<12;i++)row(monthly,new Intl.DateTimeFormat(es?'es':'en',{month:'long',timeZone:'UTC'}).format(new Date(Date.UTC(2000,(i+8)%12,1))),rec?.monthly?.[i]);}cat.addEventListener('change',render);yr.addEventListener('change',render);render();</script><article><h2>{t('Revenue and expenditure datasets','Datos de ingresos y gastos')}</h2><p>{t('Remaining datasets not yet imported. No amounts are estimated or treated as zero.','Datos restantes aún no importados. No se estiman montos ni se consideran cero.')}</p><table><thead><tr><th>{t('Dataset','Datos')}</th><th>{t('Status','Estado')}</th></tr></thead><tbody>{[t('School district levies','Gravámenes de distritos escolares'),t('Appraisal district budgets','Presupuestos de distritos de tasación'),t('Economic development expenditures','Gastos de desarrollo económico')].map(n=><tr><td>{n}</td><td>{t('Pending','Pendiente')}</td></tr>)}</tbody></table></article><article><h2>{t('Local sales tax allocations','Asignaciones locales del impuesto sobre ventas')}</h2><a href={es?'/es/local-sales-tax/':'/local-sales-tax/'}>{t('Explore November 2026 allocations','Explore las asignaciones de noviembre de 2026')}</a></article><h2>{t('Official source directory','Directorio de fuentes oficiales')}</h2>{sources.map(s=><p><a href={s.url}>{s.name}</a></p>)}</main></body></html>
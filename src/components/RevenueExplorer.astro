---
import taxes from '../data/taxes.json';
const {lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const money=(n:number)=>new Intl.NumberFormat(es?'es-US':'en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
const rows=[{name:t('Property tax levies','Gravámenes sobre propiedades'),value:taxes.property},{name:t('State sales tax','Impuesto estatal sobre ventas'),value:taxes.stateSales},{name:t('Local sales taxes','Impuestos locales sobre ventas'),value:taxes.localSales},{name:t('Other state taxes','Otros impuestos estatales'),value:taxes.otherState}];
const sources=[{name:t('State cash report','Informe estatal de efectivo'),url:'https://comptroller.texas.gov/transparency/reports/cash-report/'},{name:t('State revenue watch','Seguimiento de ingresos estatales'),url:'https://comptroller.texas.gov/transparency/revenue/watch/'},{name:t('Property tax rates and levies','Tasas y gravámenes sobre propiedades'),url:'https://comptroller.texas.gov/taxes/property-tax/rates/index.php'},{name:t('Economic development corporations','Corporaciones de desarrollo económico'),url:'https://comptroller.texas.gov/transparency/reports/economic-development-corporation/'}];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Revenue and Spending Explorer','Explorador de ingresos y gastos')}</title><style is:inline>body{margin:0;background:#081526;color:#f4f6fa;font:1rem system-ui}main{max-width:1000px;margin:auto;padding:1rem}a,h1,strong{color:#e1bd75}nav{display:flex;gap:1rem;flex-wrap:wrap}article{background:#142740;border:1px solid #42536a;padding:1rem;border-radius:10px;margin:1rem 0}strong{font-size:clamp(1.2rem,5vw,2rem);overflow-wrap:anywhere}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:.6rem .25rem;border-bottom:1px solid #42536a}td:last-child{text-align:right}meter{width:100%;height:1rem}a:focus-visible{outline:3px solid white}small{color:#c4cfdd}h2{font-size:1.25rem}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href="/revenue/">🇺🇸 EN</a><a href="/es/revenue/">🇵🇷 ES</a></nav><h1>{t('Revenue and Spending Explorer','Explorador de ingresos y gastos')}</h1><p>{t('Follow the money from taxes to government finances. Reporting periods and accounting measures are identified separately.','Siga el dinero desde los impuestos hasta las finanzas públicas. Los períodos y las medidas contables se identifican por separado.')}</p><article><h2>{t('Reported statewide tax measures · 2023','Medidas tributarias estatales reportadas · 2023')}</h2><strong>{money(taxes.total)}</strong><p>{t('Combined tax measures reported by the Comptroller, including property tax levies. Not consolidated cash revenue or total government revenue.','Medidas tributarias combinadas reportadas por la Contraloría, incluidos gravámenes sobre propiedades. No representan ingresos consolidados en efectivo ni ingresos públicos totales.')}</p>{rows.map(r=><div><p>{r.name}: <b>{money(r.value)}</b> · {(r.value/taxes.total*100).toFixed(2)}%</p><meter min="0" max={taxes.total} value={r.value} aria-label={r.name}/></div>)}<p><a href={taxes.source}>{t('Official report · Exhibit 1, page 5','Informe oficial · Cuadro 1, página 5')}</a></p></article><article><h2>{t('Revenue and expenditure datasets','Datos de ingresos y gastos')}</h2><p>{t('Not yet imported. No amounts are estimated or treated as zero.','Aún no importados. No se estiman montos ni se consideran cero.')}</p><table><thead><tr><th>{t('Dataset','Datos')}</th><th>{t('Status','Estado')}</th></tr></thead><tbody>{[t('State cash revenue and expenditures','Ingresos y gastos estatales en efectivo'),t('Local sales tax allocations','Asignaciones locales del impuesto sobre ventas'),t('School district levies','Gravámenes de distritos escolares'),t('Appraisal district budgets','Presupuestos de distritos de tasación'),t('Economic development expenditures','Gastos de desarrollo económico')].map(n=><tr><td>{n}</td><td>{t('Pending','Pendiente')}</td></tr>)}</tbody></table></article><h2>{t('Official source directory','Directorio de fuentes oficiales')}</h2>{sources.map(s=><p><a href={s.url}>{s.name}</a></p>)}</main></body></html>
---
import sales from '../../public/data/local-sales-tax-2026-11.json';
import finances from '../../public/data/texas-state-finances-2026.json';
import debt from '../data/debt.json';
import taxes from '../data/taxes.json';
const {lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const rows=[
{n:t('State and local debt','Deuda estatal y local'),period:debt.asOf,kind:t('Annual snapshot','Corte anual'),url:debt.local.source,year:2025},
{n:t('State cash revenue and spending','Ingresos y gastos estatales'),period:'FY'+finances.fiscalYear,kind:t('Annual report','Informe anual'),url:finances.cashSource,year:finances.fiscalYear},
{n:t('Local sales tax allocations','Asignaciones locales de ventas'),period:sales.latestPeriod,kind:t('Monthly report','Informe mensual'),url:'https://data.texas.gov/api/views/53pa-m7sm.json',year:null},
{n:t('Statewide property tax rates','Tasas estatales de propiedad'),period:'2021–2025',kind:t('Historical series','Serie histórica'),url:'https://comptroller.texas.gov/taxes/property-tax/rates/index.php',year:2025},
{n:t('Combined Texas tax report','Informe combinado de impuestos'),period:'2023',kind:t('Historical benchmark','Referencia histórica'),url:taxes.source,year:2023}];
---
<section id="data-freshness" aria-labelledby="freshness-title"><h2 id="freshness-title">{t('Data freshness and source status','Vigencia de datos y estado de fuentes')}</h2><p>{t('Published reporting periods, not retrieval dates. A successful source check does not mean published financial values have changed.','Períodos publicados, no fechas de descarga. Una consulta exitosa no significa que los valores publicados hayan cambiado.')}</p><div class="fresh-grid">{rows.map(r=><article><h3>{r.n}</h3><strong>{r.period}</strong><small>{r.kind}</small>{r.year!==null&&<small class="report-age" data-year={r.year}></small>}<a href={r.url}>{t('Official source','Fuente oficial')}</a></article>)}</div><article class="fresh-status"><h3>{t('Automated sales tax monitoring','Monitoreo automático de ventas')}</h3><p>{t('Recorded acquisition milestone: November 24, 2026 Central Time (historical repository note, not a live status). Consult workflow logs for newer runs. Staged data requires reconciliation.','Hito de descarga registrado: 24 de noviembre de 2026, hora central (nota histórica del repositorio, no estado en vivo). Consulte los registros para ejecuciones posteriores. Los datos en preparación requieren conciliación.')}</p><p id="fresh-age" data-period={sales.latestPeriod}></p><p><a href="https://github.com/cryptoqueen23/texas_taxpayer_clock/actions/workflows/monitor-sources.yml">{t('Source monitoring logs','Registro de monitoreo')}</a> · <a href="https://github.com/cryptoqueen23/texas_taxpayer_clock/actions/workflows/stage-sales-tax.yml">{t('Acquisition and validation logs','Registro de descarga y validación')}</a></p><small>{t('Live source availability is not asserted here. Check the latest workflow results. Moving counters are models, not live transactions.','Aquí no se afirma disponibilidad en tiempo real. Consulte los últimos resultados. Los contadores dinámicos son modelos, no transacciones reales.')}</small></article><article class="fresh-status"><h3>{t('Historical coverage and limitations','Cobertura histórica y limitaciones')}</h3><ul><li>{t('Local debt: 2016–2025; exact tax-directory matches are incomplete.','Deuda local: 2016–2025; coincidencias exactas con el directorio tributario incompletas.')}</li><li>{t('School levies: 2021–2025; 2023 publication discrepancy unresolved.','Gravámenes escolares: 2021–2025; diferencia de publicaciones de 2023 pendiente.')}</li><li>{t('Economic development: 1997–2024; 2024 is partial.','Desarrollo económico: 1997–2024; 2024 es parcial.')}</li><li>{t('Appraisal operations: 253 records per year in 2024 and 2025.','Operaciones de tasación: 253 registros por año en 2024 y 2025.')}</li><li>{t('Census local finance: 1,461 records in 2022 and 221 in 2024; coverage differs.','Finanzas locales del Censo: 1,461 registros en 2022 y 221 en 2024; cobertura diferente.')}</li></ul><p>{t('Reporting-year age is descriptive, not proof that a newer release exists. Original-source verification is not established by this display.','La antigüedad del año informado es descriptiva; no demuestra que exista una publicación más reciente. Esta presentación no establece verificación de fuentes originales.')}</p><a href={es?'/es/evidence/':'/evidence/'}>{t('Financial evidence and reconciliation','Evidencia financiera y conciliación')}</a></article></section>
<style>.fresh-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem}.fresh-status{margin-top:.75rem}@media(max-width:700px){.fresh-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}</style>
<script>const el=document.querySelector<HTMLElement>('#fresh-age');if(el){const [y,m]=(el.dataset.period||'').split('-').map(Number);const now=new Date();const parts=new Intl.DateTimeFormat('en-US',{timeZone:'America/Chicago',year:'numeric',month:'numeric'}).formatToParts(now);const get=(k:string)=>Number(parts.find(p=>p.type===k)?.value);const age=(get('year')-y)*12+get('month')-m;const es=document.documentElement.lang==='es';if(Number.isFinite(age)&&age>=0)el.textContent=age>2?(es?'Aviso: el período publicado tiene más de dos meses.':'Notice: published period is more than two months old.'):(es?'Antigüedad del período publicado (meses): ':'Published period age (months): ')+age;}const currentYear=Number(new Intl.DateTimeFormat('en-US',{timeZone:'America/Chicago',year:'numeric'}).format(new Date()));for(const node of document.querySelectorAll<HTMLElement>('.report-age')){const year=Number(node.dataset.year);const age=currentYear-year;const spanish=document.documentElement.lang==='es';if(Number.isFinite(age)&&age>=0)node.textContent=(spanish?'Diferencia de años calendario: ':'Calendar-year difference: ')+age;}</script>

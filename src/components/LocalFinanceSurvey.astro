---
const {lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Local finance survey','Encuesta de finanzas locales')} | Texas Taxpayer Clock</title><style is:inline>body{background:#081526;color:#f4f6fa;font:1rem system-ui;margin:0}main{max-width:1000px;margin:auto;padding:1rem}a,h1,strong{color:#e1bd75}nav,.controls{display:flex;gap:1rem;flex-wrap:wrap}label{display:grid;gap:.4rem;max-width:100%}input,select,button{font:inherit;padding:.6rem;background:#142740;color:white;border:1px solid #8190a4;border-radius:6px;max-width:100%;box-sizing:border-box}article{background:#142740;border:1px solid #42536a;border-radius:8px;padding:1rem;margin:.6rem 0}summary{cursor:pointer}button:disabled{opacity:.5}:focus-visible{outline:3px solid #e1bd75}h2{font-size:1.1rem}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href="/local-finances/">🇺🇸 EN</a><a href="/es/local-finances/">🇵🇷 ES</a></nav><h1>{t('Municipal and county finance survey','Encuesta financiera municipal y de condados')}</h1><p>{t('Census Bureau individual-unit survey records, not audited local accounts. These records support statewide estimates and should not be used as a reliable individual-government time series. 2024 coverage is sampled; missing items are not zero.','Registros individuales del Censo, no cuentas locales auditadas. Sirven para estimaciones estatales, no como series históricas fiables de gobiernos individuales. Cobertura muestral en 2024; datos faltantes no equivalen a cero.')}</p><div class="controls"><label>{t('Government or county','Gobierno o condado')}<input id="q" type="search"/></label><label>{t('Year','Año')}<select id="y"><option>2022</option><option>2024</option></select></label><label>{t('Government type','Tipo de gobierno')}<select id="type"><option value="">{t('All','Todos')}</option><option value="1">{t('County','Condado')}</option><option value="2">{t('Municipality','Municipio')}</option></select></label><label>{t('Financial item','Partida financiera')}<select id="code"></select></label><label>{t('Reporting flag','Indicador de reporte')}<select id="flag"><option value="">{t('All','Todos')}</option></select></label></div><p id="status" role="status">{t('Loading…','Cargando…')}</p><div id="results"></div><button id="prev" disabled>{t('Previous','Anterior')}</button> <button id="next" disabled>{t('Next','Siguiente')}</button><p>{t('Original Census item labels are retained in English. Amounts converted from thousands of dollars. Individual items may overlap; no combined totals are calculated.','Se conservan las etiquetas originales del Censo en inglés. Montos convertidos de miles de dólares. Las partidas pueden superponerse; no se calculan totales combinados.')}</p><a href="https://www.census.gov/programs-surveys/gov-finances.html">US Census Bureau · Government Finances</a></main><script define:vars={{es}}>
const by=id=>document.getElementById(id),q=by('q'),y=by('y'),type=by('type'),code=by('code'),flag=by('flag');let data,page=0;q.value=new URLSearchParams(location.search).get('q')||'';const money=v=>Number.isFinite(v)?(v*1000).toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}):'N/A';const translated={R:'Reportado',I:'Imputado',A:'Corrección del analista',M:'Desconocido',N:'No aplicable',S:'Fuente alternativa'};const label=f=>f+' · '+(es?translated[f]:data.flags[f]);
function render(){if(!data)return;const query=q.value.trim().toLowerCase(),c=code.value;const rows=Object.entries(data.years[y.value]).filter(([id,g])=>(!type.value||id[2]===type.value)&&(!flag.value||g.items[c]?.[1]===flag.value)&&[g.name,g.county,id].join(' ').toLowerCase().includes(query)).sort((a,b)=>{const av=a[1].items[c]?.[0],bv=b[1].items[c]?.[0];return (bv??-Infinity)-(av??-Infinity)||a[1].name.localeCompare(b[1].name)});page=Math.max(0,Math.min(page,Math.ceil(rows.length/25)-1));by('results').replaceChildren();for(const [id,g] of rows.slice(page*25,page*25+25)){const a=document.createElement('article'),h=document.createElement('h2');h.textContent=g.name;a.append(h);const p=document.createElement('p');p.textContent=g.county+' · '+id;a.append(p);const v=g.items[c],s=document.createElement('strong');s.textContent=money(v?.[0]);a.append(s);const f=document.createElement('p');f.textContent=v?label(v[1]):(es?'No disponible':'Unavailable');a.append(f);const d=document.createElement('details'),sum=document.createElement('summary');sum.textContent=es?'Todas las partidas disponibles':'All available financial items';d.append(sum);d.addEventListener('toggle',()=>{if(!d.open||d.dataset.loaded)return;d.dataset.loaded='1';for(const [k,item] of Object.entries(g.items)){const p=document.createElement('p');p.textContent=k+' · '+data.codes[k]+': '+money(item[0])+' · '+label(item[1]);d.append(p)}});a.append(d);by('results').append(a)}by('status').textContent=rows.length+(es?' gobiernos · ':' governments · ')+(rows.length?page+1:0)+' / '+Math.ceil(rows.length/25);by('prev').disabled=page===0;by('next').disabled=(page+1)*25>=rows.length}
for(const el of [q,y,type,code,flag])el.addEventListener(el===q?'input':'change',()=>{page=0;render()});by('prev').onclick=()=>{page--;render()};by('next').onclick=()=>{page++;render()};fetch('/data/texas-census-local-finance-2022-2024.json').then(r=>{if(!r.ok)throw Error();return r.json()}).then(d=>{data=d;for(const [k,v] of Object.entries(d.codes))code.add(new Option(k+' · '+v,k));code.value='T01';for(const k of Object.keys(d.flags))flag.add(new Option(label(k),k));render()}).catch(()=>by('status').textContent=es?'Error al cargar datos.':'Unable to load data.');
</script></body></html>

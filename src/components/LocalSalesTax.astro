---
import data from '../../public/data/local-sales-tax-2026-11.json';
const {lang}=Astro.props;const es=lang==='es',t=(a:string,b:string)=>es?b:a;
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Local Sales Tax Explorer','Explorador de impuestos locales sobre ventas')}</title><style is:inline>body{margin:0;background:#081526;color:#f4f6fa;font:1rem system-ui}main{max-width:1100px;margin:auto;padding:1rem}a,h1{color:#e1bd75}nav{display:flex;gap:1rem;flex-wrap:wrap}label{display:grid;gap:.4rem;margin:.7rem 0}input,select,button{font:inherit;padding:.6rem;background:#142740;color:white;border:1px solid #8190a4;border-radius:5px}button:disabled{opacity:.5}a:focus-visible,input:focus-visible,select:focus-visible,button:focus-visible{outline:3px solid white}.scroll{overflow:auto}table{border-collapse:collapse;width:100%;min-width:740px}th,td{padding:.65rem;text-align:left;border-bottom:1px solid #42536a}td:nth-child(n+4){text-align:right;white-space:nowrap}small{color:#c4cfdd}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href={es?'/es/revenue/':'/revenue/'}>{t('Revenue explorer','Explorador de ingresos')}</a><a href="/local-sales-tax/">🇺🇸 EN</a><a href="/es/local-sales-tax/">🇵🇷 ES</a><a href={es?'/es/local-sales-tax-history/':'/local-sales-tax-history/'}>{t('Historical allocations','Asignaciones históricas')}</a></nav><h1>{t('Local Sales Tax Explorer','Explorador de impuestos locales sobre ventas')}</h1><p>{t('November 2026 allocation payments · calendar year-to-date through November. Allocations are not total government revenue.','Asignaciones de noviembre de 2026 · acumulado del año calendario hasta noviembre. Las asignaciones no representan todos los ingresos públicos.')}</p><label>{t('Search name or county','Buscar nombre o condado')}<input id="search" type="search"/></label><label>{t('Government type','Tipo de gobierno')}<select id="type"><option value="">{t('All types','Todos los tipos')}</option><option value="CITY">{t('Cities','Ciudades')}</option><option value="COUNTY">{t('Counties','Condados')}</option><option value="MTA">{t('Transit authorities','Autoridades de transporte')}</option><option value="SPD">{t('Special-purpose districts','Distritos especiales')}</option></select></label><label>{t('Sort by','Ordenar por')}<select id="sort"><option value="4">{t('Monthly payment','Pago mensual')}</option><option value="6">{t('Year-to-date payments','Pagos acumulados')}</option><option value="change">{t('Year-to-date percentage change','Cambio porcentual acumulado')}</option><option value="3">{t('Tax rate','Tasa tributaria')}</option></select></label><p id="count" role="status"></p><div class="scroll" tabindex="0" aria-label={t('Allocation comparison table','Tabla de comparación de asignaciones')}><table><thead><tr>{[t('Name','Nombre'),t('Type','Tipo'),t('County','Condado'),t('Rate','Tasa'),t('November payment','Pago de noviembre'),t('Prior November','Noviembre anterior'),t('YTD','Acumulado'),t('Prior YTD','Acumulado anterior'),t('YTD change','Cambio acumulado')].map(x=><th scope="col">{x}</th>)}</tr></thead><tbody id="rows"></tbody></table></div><p><button id="prev">{t('Previous','Anterior')}</button> <span id="page"></span> <button id="next">{t('Next','Siguiente')}</button></p><p>{t('Percentage change is unavailable when the prior-year amount is zero or negative. Records are shown as reported; no cross-government totals or profile matches are inferred.','El cambio porcentual no está disponible cuando el monto anterior es cero o negativo. Se muestran registros reportados; no se infieren totales entre gobiernos ni coincidencias con perfiles.')}</p><p><a href="https://data.texas.gov/Government-and-Taxes/Sales-Tax-Allocation-City-County-Comparison-Summar/53pa-m7sm">{t('Official city dataset','Datos oficiales de ciudades')}</a> · <a href="https://data.texas.gov/dataset/Sales-Tax-Allocation-County-MTA-SPD/qsh8-tby8">{t('Official county, MTA and SPD dataset','Datos oficiales de condados, MTA y SPD')}</a></p></main><script is:inline define:vars={{records:data.records,es}}>const el=id=>document.getElementById(id),search=el('search'),type=el('type'),sort=el('sort');let page=0;const money=v=>new Intl.NumberFormat(es?'es-US':'en-US',{style:'currency',currency:'USD'}).format(v/100),change=r=>r[7]>0?(r[6]-r[7])/r[7]*100:null,metric=r=>sort.value==='change'?change(r):r[Number(sort.value)];const names={CITY:es?'Ciudad':'City',COUNTY:es?'Condado':'County',MTA:'MTA',SPD:'SPD'};function render(){const q=search.value.trim().toLowerCase();const filtered=records.filter(r=>(!type.value||r[0]===type.value)&&[r[1],r[2]].some(v=>String(v??'').toLowerCase().includes(q))).sort((a,b)=>(metric(b)??-Infinity)-(metric(a)??-Infinity)||String(a[1]).localeCompare(String(b[1])));const pages=Math.max(1,Math.ceil(filtered.length/50));page=Math.min(page,pages-1);el('rows').replaceChildren();for(const r of filtered.slice(page*50,page*50+50)){const tr=document.createElement('tr');for(const v of [r[1],names[r[0]]??r[0],r[2]||'—',r[3].toFixed(3)+'%',money(r[4]),money(r[5]),money(r[6]),money(r[7]),change(r)==null?'—':change(r).toFixed(2)+'%']){const td=document.createElement('td');td.textContent=v;tr.append(td)}el('rows').append(tr)}el('count').textContent=filtered.length+' / '+records.length;el('page').textContent=(page+1)+' / '+pages;el('prev').disabled=page===0;el('next').disabled=page+1>=pages;}for(const x of [search,type,sort])x.addEventListener(x===search?'input':'change',()=>{page=0;render()});el('prev').onclick=()=>{page--;render()};el('next').onclick=()=>{page++;render()};render();</script></body></html>
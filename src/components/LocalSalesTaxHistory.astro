---
import data from '../../public/data/local-sales-tax-history.json';
const {lang}=Astro.props;const es=lang==='es',t=(a:string,b:string)=>es?b:a;
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Historical local sales tax','Historial de impuestos locales sobre ventas')}</title><style is:inline>body{margin:0;background:#081526;color:#f4f6fa;font:1rem system-ui}main{max-width:1000px;margin:auto;padding:1rem}a,h1{color:#e1bd75}nav{display:flex;gap:1rem;flex-wrap:wrap}label{display:grid;gap:.4rem;margin:1rem 0}input,select{font:inherit;background:#142740;color:white;border:1px solid #8190a4;padding:.6rem;width:100%;box-sizing:border-box}table{width:100%;border-collapse:collapse}td,th{padding:.5rem;text-align:left;border-bottom:1px solid #42536a}td:last-child{text-align:right}meter{width:100%;height:1rem}a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid white}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href={es?'/es/local-sales-tax/':'/local-sales-tax/'}>{t('Current allocations','Asignaciones actuales')}</a><a href="/local-sales-tax-history/">🇺🇸 EN</a><a href="/es/local-sales-tax-history/">🇵🇷 ES</a></nav><h1>{t('Historical local sales tax allocations','Historial de asignaciones de impuestos locales sobre ventas')}</h1><p>{t('2013–2026 · Nominal dollars. Allocations are not total government revenue. Historical names may change; records are grouped by reported type, name and county.','2013–2026 · Dólares nominales. Las asignaciones no son ingresos públicos totales. Los nombres históricos pueden cambiar; los registros se agrupan por tipo, nombre y condado reportados.')}</p><label>{t('Search government or county','Buscar gobierno o condado')}<input id="query" type="search"/></label><label>{t('Government','Gobierno')}<select id="entity"></select></label><label>{t('Comparable period','Período comparable')}<select id="period"><option value="12">{t('Full calendar year (2013–2025)','Año calendario completo (2013–2025)')}</option><option value="11">{t('January–November (2013–2026)','Enero–noviembre (2013–2026)')}</option></select></label><h2 id="name"></h2><p id="summary" role="status"></p><table><thead><tr><th>{t('Year','Año')}</th><th>{t('Allocation','Asignación')}</th><th>{t('Annual change','Cambio anual')}</th></tr></thead><tbody id="history"></tbody></table><p>{t('Missing values are not zero. Bars represent nonnegative amounts relative to the largest available amount for the selected entity and period.','Los valores ausentes no son cero. Las barras representan montos no negativos en relación con el mayor monto disponible para la entidad y período seleccionados.')}</p><p><a href="https://data.texas.gov/Government-and-Taxes/Sales-Tax-Allocation-City-County-Comparison-Summar/53pa-m7sm">{t('Official city data','Datos oficiales de ciudades')}</a> · <a href="https://data.texas.gov/dataset/Sales-Tax-Allocation-County-MTA-SPD/qsh8-tby8">{t('Official county and district data','Datos oficiales de condados y distritos')}</a></p></main><script is:inline define:vars={{records:data.records,es}}>const el=id=>document.getElementById(id),q=el('query'),entity=el('entity'),period=el('period');const money=v=>v==null?'N/A':new Intl.NumberFormat(es?'es-US':'en-US',{style:'currency',currency:'USD'}).format(v/100);function choices(){const prev=entity.value;entity.replaceChildren();records.forEach((r,i)=>{if(r.slice(0,3).join(' ').toLowerCase().includes(q.value.trim().toLowerCase())){const o=document.createElement('option');o.value=String(i);o.textContent=r.slice(0,3).filter(Boolean).join(' · ');entity.append(o)}});if(Array.from(entity.options).some(o=>o.value===prev))entity.value=prev;render()}function render(){const body=el('history');body.replaceChildren();const r=entity.value===''?null:records[Number(entity.value)];el('name').textContent=r?r.slice(0,3).filter(Boolean).join(' · '):'';el('summary').textContent=r?'':(es?'Sin coincidencias':'No matches');if(!r)return;const m=period.value,end=m==='12'?2025:2026,years=Array.from({length:end-2013+1},(_,i)=>2013+i),max=Math.max(1,...years.map(y=>r[3][y+'-'+m]??0));for(const y of years){const v=r[3][y+'-'+m],p=r[3][(y-1)+'-'+m],tr=document.createElement('tr'),th=document.createElement('th'),td=document.createElement('td'),ch=document.createElement('td');th.scope='row';th.textContent=y;td.textContent=money(v);if(v!=null&&v>=0){const bar=document.createElement('meter');bar.min=0;bar.max=max;bar.value=v;bar.setAttribute('aria-label',money(v));td.append(bar)}ch.textContent=v!=null&&p>0?((v-p)/p*100).toFixed(2)+'%':'N/A';tr.append(th,td,ch);body.append(tr)}}q.addEventListener('input',choices);entity.addEventListener('change',render);period.addEventListener('change',render);choices();</script></body></html>
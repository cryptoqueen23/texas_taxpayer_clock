---
import geo from '../../public/data/texas-county-boundaries-2025.json';
import units from '../../public/data/tax-units.json';
import debt from '../../public/data/local-debt-2025.json';
import den from '../../public/data/local-debt-denominators-2025.json';
import aliases from '../data/profile-aliases.json';
const {lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const records=geo.counties.map(c=>{const u=units.find(x=>x.id===c.taxId);const d=debt.records.find(x=>x.id===c.taxId&&x.type==='COUNTY');const p=(den.records as Record<string,(number|null)[]>)[c.taxId]?.[0];const rates=u?.rates as Record<string,number|null>|undefined;const v=rates?.['2025'],prev=rates?.['2024'];return {...c,rate:v??null,change:v!=null&&prev!=null&&prev>0?(v-prev)/prev*100:null,principal:d?.principal??null,perResident:d&&p&&p>0?d.principal/p:null,profile:(aliases as Record<string,string>)[c.taxId]??c.taxId}});
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Texas County Financial Map','Mapa financiero de condados de Texas')}</title><style is:inline>body{background:#081526;color:#f4f6fa;font:1rem system-ui;margin:0}main{max-width:1000px;margin:auto;padding:1rem}a,h1{color:#e1bd75}nav{display:flex;gap:1rem;flex-wrap:wrap}select{font:inherit;background:#142740;color:white;padding:.6rem;max-width:100%;border:1px solid #8190a4}label{display:grid;gap:.4rem;margin:.8rem 0}svg{width:100%;height:auto;background:#101f33}path{stroke:#081526;stroke-width:1;cursor:pointer}svg a:focus path,svg a:hover path{stroke:white;stroke-width:3}a:focus-visible,select:focus-visible{outline:3px solid white}.legend{display:flex;gap:.5rem;flex-wrap:wrap}.swatch{display:inline-block;width:1rem;height:1rem;margin-right:.3rem;vertical-align:middle}article{border:1px solid #42536a;padding:1rem;border-radius:8px}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href="/county-map/">🇺🇸 EN</a><a href="/es/county-map/">🇵🇷 ES</a></nav><h1>{t('Texas County Financial Map','Mapa financiero de condados de Texas')}</h1><p>{t('254 counties · FY 2025 debt and 2025 property tax rates. County government only, not all governments within county boundaries.','254 condados · Deuda AF 2025 y tasas de 2025. Solo gobierno del condado, no todas las entidades dentro de sus límites.')}</p><label>{t('Financial indicator','Indicador financiero')}<select id="metric"><option value="rate">{t('Property tax rate','Tasa de propiedad')}</option><option value="change">{t('Annual rate change (%)','Cambio anual (%)')}</option><option value="principal">{t('Outstanding principal','Principal pendiente')}</option><option value="perResident">{t('Principal per resident','Principal por habitante')}</option></select></label><label>{t('Choose county','Seleccione condado')}<select id="county">{records.map(c=><option value={c.taxId}>{c.name}</option>)}</select></label><article id="detail" aria-live="polite"><h2 id="name"></h2><p id="amount"></p><a id="profile">{t('Open financial profile','Abrir perfil financiero')}</a></article><svg viewBox={geo.viewBox} aria-label={t('Texas county map, select a county to open its profile','Mapa de Texas, seleccione un condado para abrir su perfil')} >{records.map(c=><a href={(es?'/es':'')+'/government/'+c.profile+'/'} aria-label={c.name}><path data-id={c.taxId} d={c.path} fill="#526175" fill-rule="evenodd"><title>{c.name}</title></path></a>)}</svg><div class="legend" id="legend"></div><p id="coverage" role="status"></p><p>{t('Colors show relative rank groups among available county values, not financial health. Gray means unavailable, not zero.','Los colores muestran grupos de clasificación relativa entre valores disponibles, no salud financiera. Gris significa no disponible, no cero.')}</p><p><a href="https://www.census.gov/geographies/mapping-files/time-series/geo/cartographic-boundary.html">U.S. Census Bureau · 2025 · 1:5,000,000</a> · <a href="https://data.brb.texas.gov/local/">Texas Bond Review Board</a> · <a href="https://comptroller.texas.gov/taxes/property-tax/rates/index.php">Texas Comptroller</a></p></main><script is:inline define:vars={{records,es}}>
const metric=document.getElementById('metric'),county=document.getElementById('county'),colors=['#f5e4b8','#d9b66b','#ad803c','#805622','#563612'],tr=(a,b)=>es?b:a;const paths=new Map(Array.from(document.querySelectorAll('path[data-id]')).map(p=>[p.dataset.id,p]));function fmt(v){return v==null?tr('Unavailable','No disponible'):metric.value==='rate'?'$'+v.toFixed(6)+' / $100':metric.value==='change'?v.toFixed(2)+'%':new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:2}).format(v)}function detail(){const c=records.find(r=>r.taxId===county.value);document.getElementById('name').textContent=c.name+' County';document.getElementById('amount').textContent=fmt(c[metric.value]);document.getElementById('profile').href=(es?'/es':'')+'/government/'+c.profile+'/'}function render(){const key=metric.value,values=records.map(r=>r[key]).filter(v=>v!=null).sort((a,b)=>a-b);const cuts=[.2,.4,.6,.8].map(q=>values[Math.floor((values.length-1)*q)]);for(const c of records){const v=c[key],p=paths.get(c.taxId);p.setAttribute('fill',v==null?'#526175':colors[cuts.filter(x=>v>x).length]);p.querySelector('title').textContent=c.name+': '+fmt(v)}const legend=document.getElementById('legend');legend.replaceChildren();for(let i=0;i<6;i++){const s=document.createElement('span'),b=document.createElement('span');b.className='swatch';b.style.background=i===5?'#526175':colors[i];s.append(b, i===5?tr('Unavailable','No disponible'):i===0?'≤ '+fmt(cuts[0]):i===4?'> '+fmt(cuts[3]):fmt(cuts[i-1])+' – '+fmt(cuts[i]));legend.append(s)}document.getElementById('coverage').textContent=values.length+' / 254 '+tr('counties with data','condados con datos');detail()}metric.addEventListener('change',render);county.addEventListener('change',detail);render();
</script></body></html>
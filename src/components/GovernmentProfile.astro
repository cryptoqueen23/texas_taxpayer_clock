---
const {g,lang}=Astro.props;
const es=lang==='es';const t=(a:string,b:string)=>es?b:a;
const fmt=(v:number|null)=>v===null?t('Unavailable','No disponible'):new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(v);
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{g.name} | Texas Taxpayer Clock</title><style is:inline>body{background:#081526;color:#f4f6fa;font:1rem system-ui;margin:0}main{max-width:900px;margin:auto;padding:1rem}a,h1,strong{color:#e1bd75}nav{display:flex;gap:1rem;flex-wrap:wrap}article{background:#142740;border:1px solid #42536a;border-radius:10px;padding:1rem;margin:1rem 0}strong{display:block;font-size:clamp(1.3rem,5vw,2rem);overflow-wrap:anywhere}a:focus-visible{outline:3px solid white}</style></head><body><main><nav><a href={es?'/es/#explorer':'/#explorer'}>{t('Back to Explorer','Volver al explorador')}</a><a href={'/government/'+g.id+'/'}>🇺🇸 EN</a><a href={'/es/government/'+g.id+'/'}>🇵🇷 ES</a></nav><h1>{g.name}</h1><p>{t('Local government debt · FY 2025','Deuda gubernamental local · AF 2025')}</p>{[[t('Outstanding principal','Principal pendiente'),g.principal],[t('Remaining interest','Intereses restantes'),g.interest],[t('Reported remaining debt service','Servicio de deuda restante reportado'),g.repayment]].map(([label,value])=><article><h2>{label}</h2><strong>{fmt(value as number|null)}</strong></article>)}<p>{g.count===null?t('No exact name match in this source extract. This does not establish zero debt.','Sin coincidencia exacta en esta fuente. Esto no demuestra deuda cero.'):t('Issuance records aggregated: ','Registros de emisiones agregados: ')+g.count}</p><p>{t('Reported source balances, not live debt or a complete statement of liabilities.','Saldos reportados, no deuda en tiempo real ni declaración completa de obligaciones.')}</p><a href="https://data.brb.texas.gov/local/">{t('Texas Bond Review Board · official source','Texas Bond Review Board · fuente oficial')}</a></main></body></html>
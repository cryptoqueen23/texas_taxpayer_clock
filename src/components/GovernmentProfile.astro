---
const {g,lang}=Astro.props;
const es=lang==='es';const t=(a:string,b:string)=>es?b:a;
const fmt=(v:number|null)=>v===null?t('Unavailable','No disponible'):new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(v);
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{g.name} | Texas Taxpayer Clock</title><style is:inline>body{background:#081526;color:#f4f6fa;font:1rem system-ui;margin:0}main{max-width:900px;margin:auto;padding:1rem}a,h1,strong{color:#e1bd75}nav{display:flex;gap:1rem;flex-wrap:wrap}article{background:#142740;border:1px solid #42536a;border-radius:10px;padding:1rem;margin:1rem 0}strong{display:block;font-size:clamp(1.3rem,5vw,2rem);overflow-wrap:anywhere}a:focus-visible{outline:3px solid white}article{padding:.85rem;margin:.65rem 0}article h2,article h3{font-size:1.1rem;margin:0 0 .5rem}article p{margin:.5rem 0}details{margin:1.2rem 0;padding:1rem;border:1px solid #42536a;border-radius:8px}summary{cursor:pointer;color:#e1bd75}h1{font-size:clamp(1.6rem,6vw,2.4rem)}</style></head><body><main><nav><a href={es?'/es/#explorer':'/#explorer'}>{t('Back to Explorer','Volver al explorador')}</a><a href={'/government/'+g.id+'/'}>🇺🇸 EN</a><a href={'/es/government/'+g.id+'/'}>🇵🇷 ES</a></nav><h1>{g.name}</h1>{g.id==='copperas-cove-isd' && <section><h2>{t('School property taxes','Impuestos escolares sobre propiedades')}</h2><p>{t('Adopted rates per $100 taxable value, as announced by the district.','Tasas adoptadas por cada $100 de valor imponible, según el distrito.')}</p><article><h3>2025–26</h3><p>M&amp;O: $0.757500 · I&amp;S: $0.000000</p><strong>$0.757500</strong><a href="https://www.ccisd.com/apps/news/article/2223671?categoryId=25893">{t('District announcement','Anuncio del distrito')}</a></article><article><h3>2026–27</h3><p>M&amp;O: $0.757500 · I&amp;S: $0.297400</p><strong>$1.054900</strong><a href="https://cchs.ccisd.com/apps/news/article/2226569?categoryId=25894">{t('District announcement','Anuncio del distrito')}</a></article><article><h3>{t('Voter-approved bonds · November 2025','Bonos aprobados por votantes · noviembre de 2025')}</h3><strong>$154,500,000</strong><p>{t('Authorization is not outstanding principal. Issuance and remaining repayment require separate verification.','La autorización no equivale al principal pendiente. La emisión y los pagos restantes requieren verificación independiente.')}</p><a href="https://cchs.ccisd.com/apps/news/article/2226569?categoryId=25894">{t('Source','Fuente')}</a></article><p>{t('The district announced its 2005 bonds were paid off August 15, 2025. This does not establish that all liabilities were zero.','El distrito anunció el pago de sus bonos de 2005 el 15 de agosto de 2025. Esto no demuestra que todas sus obligaciones fueran cero.')}</p><p><a href="https://comptroller.texas.gov/taxes/property-tax/rates/index.php">{t('Historical rates and levies source','Fuente de tasas y gravámenes históricos')}</a></p></section>}{g.count===null ? <details><summary>{t('Historical debt records · FY 2025','Registros históricos de deuda · AF 2025')}</summary><p>{t('Outstanding principal, remaining interest and debt service are not verified in this extract. Missing figures are not zero.','Principal, intereses y servicio de deuda no verificados en este extracto. Los datos faltantes no equivalen a cero.')}</p><a href="https://data.brb.texas.gov/local/">{t('Official debt source','Fuente oficial de deuda')}</a></details> : <section><p>{t('Local government debt · FY 2025','Deuda gubernamental local · AF 2025')}</p>{[[t('Outstanding principal','Principal pendiente'),g.principal],[t('Remaining interest','Intereses restantes'),g.interest],[t('Reported remaining debt service','Servicio de deuda restante reportado'),g.repayment]].map(([label,value])=><article><h2>{label}</h2><strong>{fmt(value as number|null)}</strong></article>)}<p>{g.count===null?t('No exact name match in this source extract. This does not establish zero debt.','Sin coincidencia exacta en esta fuente. Esto no demuestra deuda cero.'):t('Issuance records aggregated: ','Registros de emisiones agregados: ')+g.count}</p><p>{t('Reported source balances, not live debt or a complete statement of liabilities.','Saldos reportados, no deuda en tiempo real ni declaración completa de obligaciones.')}</p><a href="https://data.brb.texas.gov/local/">{t('Texas Bond Review Board · official source','Texas Bond Review Board · fuente oficial')}</a></section>}</main></body></html>
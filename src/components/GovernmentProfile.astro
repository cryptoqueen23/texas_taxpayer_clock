---
import LocalFinancialClock from './LocalFinancialClock.astro';
import ProfileSalesTax from './ProfileSalesTax.astro';
import history from '../../public/data/local-debt-history.json';
import denominators from '../../public/data/local-debt-denominators-2025.json';
const {g,lang}=Astro.props;
const den=(denominators.records as Record<string,(number|null)[]>)[g.taxId]??[];
const ratio=(n:number|null,d:number|null|undefined,m=1)=>n!=null&&d!=null&&d>0?n/d*m:null;
const historical=(history.records as Record<string,Record<string,number[]>>)[g.taxId]??{};
const maxPrincipal=Math.max(1,...Object.values(historical).map(r=>r[0]));
const years=['2021','2022','2023','2024','2025'];
const es=lang==='es';const t=(a:string,b:string)=>es?b:a;
const fmt=(v:number|null)=>v===null?t('Unavailable','No disponible'):new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(v);
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{g.name} | Texas Taxpayer Clock</title><style is:inline>body{background:#081526;color:#f4f6fa;font:1rem system-ui;margin:0}main{max-width:900px;margin:auto;padding:1rem}a,h1,strong{color:#e1bd75}nav{display:flex;gap:1rem;flex-wrap:wrap}article{background:#142740;border:1px solid #42536a;border-radius:10px;padding:1rem;margin:1rem 0}strong{display:block;font-size:clamp(1.3rem,5vw,2rem);overflow-wrap:anywhere}a:focus-visible{outline:3px solid white}article{padding:.85rem;margin:.65rem 0}article h2,article h3{font-size:1.1rem;margin:0 0 .5rem}article p{margin:.5rem 0}details{margin:1.2rem 0;padding:1rem;border:1px solid #42536a;border-radius:8px}summary{cursor:pointer;color:#e1bd75}h1{font-size:clamp(1.6rem,6vw,2.4rem)}</style></head><body><main><nav><a href={es?'/es/#explorer':'/#explorer'}>{t('Back to Explorer','Volver al explorador')}</a><a href={'/government/'+g.id+'/'}>🇺🇸 EN</a><a href={'/es/government/'+g.id+'/'}>🇵🇷 ES</a></nav><h1>{g.name}</h1><LocalFinancialClock g={g} lang={lang}/><section><h2>{t('Historical property tax rates','Tasas históricas de impuestos')}</h2><p>{g.taxId} · {t('Dollars per $100 taxable value','Dólares por cada $100 de valor imponible')}</p><article><table style="width:100%;text-align:left"><thead><tr><th scope="col">{t('Year','Año')}</th><th scope="col">{t('Rate','Tasa')}</th><th scope="col">{t('Annual change','Cambio anual')}</th></tr></thead><tbody>{years.map((y,i)=>{const v=g.rates?.[y],prev=g.rates?.[years[i-1]];return <tr><td>{y}</td><td>{v==null?t('Unavailable','No disponible'):'$'+v.toFixed(6)}</td><td>{v==null||prev==null||prev===0?'—':((v-prev)/prev*100).toFixed(2)+'%'}</td></tr>})}</tbody></table></article><p>{t('Missing rates are not zero. Rates are not tax bills or collections. The 2021 change is unavailable because the series starts in 2021.','Los datos faltantes no equivalen a cero. Las tasas no son facturas ni recaudaciones. No hay cambio para 2021 porque la serie comienza en 2021.')}</p><a href="https://comptroller.texas.gov/taxes/property-tax/rates/index.php">{t('Official source','Fuente oficial')}</a></section>{g.id==='copperas-cove-isd' && <section><h2>{t('Bond sale and historical debt','Venta de bonos y deuda histórica')}</h2><article><h3>{t('First bond sale · February 3, 2026','Primera venta de bonos · 3 de febrero de 2026')}</h3><strong>≈ $79.5 million</strong><p>{t('District-reported sale amount; approximate true interest cost: 4.12%. Not a current outstanding balance or coupon rate.','Monto de venta reportado por el distrito; costo verdadero de intereses aproximado: 4.12%. No es saldo pendiente actual ni tasa de cupón.')}</p><a href="https://hhe.ccisd.com/apps/news/article/2223778?categoryId=25901">{t('District sale announcement','Anuncio de venta del distrito')}</a></article><article><h3>{t('FY 2025 outstanding principal · BRB','Principal pendiente AF 2025 · BRB')}</h3><strong>$0</strong><p>{t('Historical reported bond debt only; before the 2026 sale.','Solo deuda histórica en bonos reportada; anterior a la venta de 2026.')}</p><a href="https://data.brb.texas.gov/local/isd/">{t('Official BRB school district directory','Directorio oficial BRB')}</a></article><p>{t('November 2026 board documents describe additional bond issuance authorization. Final sale, closing, current outstanding principal and repayment schedule remain unverified.','Documentos de noviembre de 2026 describen autorización adicional de emisión. Venta final, cierre, principal actual y calendario de pagos aún no verificados.')}</p><a href="https://meetings.boardbook.org/Public/DownloadAgenda/665?meeting=774748">{t('November 2026 bond order materials','Documentos de bonos de noviembre de 2026')}</a></section>}
{g.id==='copperas-cove-isd' && <section><h2>{t('School property taxes','Impuestos escolares sobre propiedades')}</h2><p>{t('Adopted rates per $100 taxable value, as announced by the district.','Tasas adoptadas por cada $100 de valor imponible, según el distrito.')}</p><article><h3>2025–26</h3><p>M&amp;O: $0.757500 · I&amp;S: $0.000000</p><strong>$0.757500</strong><a href="https://www.ccisd.com/apps/news/article/2223671?categoryId=25893">{t('District announcement','Anuncio del distrito')}</a></article><article><h3>2026–27</h3><p>M&amp;O: $0.757500 · I&amp;S: $0.297400</p><strong>$1.054900</strong><a href="https://cchs.ccisd.com/apps/news/article/2226569?categoryId=25894">{t('District announcement','Anuncio del distrito')}</a></article><article><h3>{t('Voter-approved bonds · November 2025','Bonos aprobados por votantes · noviembre de 2025')}</h3><strong>$154,500,000</strong><p>{t('Authorization is not outstanding principal. Issuance and remaining repayment require separate verification.','La autorización no equivale al principal pendiente. La emisión y los pagos restantes requieren verificación independiente.')}</p><a href="https://cchs.ccisd.com/apps/news/article/2226569?categoryId=25894">{t('Source','Fuente')}</a></article><p>{t('The district announced its 2005 bonds were paid off August 15, 2025. This does not establish that all liabilities were zero.','El distrito anunció el pago de sus bonos de 2005 el 15 de agosto de 2025. Esto no demuestra que todas sus obligaciones fueran cero.')}</p><p><a href="https://comptroller.texas.gov/taxes/property-tax/rates/index.php">{t('Historical rates and levies source','Fuente de tasas y gravámenes históricos')}</a></p></section>}{g.count===null && g.id!=='copperas-cove-isd' ? <article><h2>{t('Debt records','Registros de deuda')}</h2><p>{t('Debt data not yet matched. This does not establish zero debt.','Datos de deuda aún no vinculados. Esto no demuestra deuda cero.')}</p></article> : g.count===null ? <details><summary>{t('Historical debt records · FY 2025','Registros históricos de deuda · AF 2025')}</summary><p>{t('The issuance extract has no matching row. The separate BRB district directory reports $0 principal for FY 2025; interest and repayment are not independently verified.','Sin fila coincidente en el extracto. El directorio BRB reporta $0 de principal para AF 2025; intereses y pagos no verificados independientemente.')}</p><a href="https://data.brb.texas.gov/local/">{t('Official debt source','Fuente oficial de deuda')}</a></details> : <section><p>{t('Local government debt · FY 2025','Deuda gubernamental local · AF 2025')}</p>{[[t('Outstanding principal','Principal pendiente'),g.principal],[t('Remaining interest','Intereses restantes'),g.interest],[t('Reported remaining debt service','Servicio de deuda restante reportado'),g.repayment]].map(([label,value])=><article><h2>{label}</h2><strong>{fmt(value as number|null)}</strong></article>)}<p>{g.count===null?t('No matching government identifier in this source extract. This does not establish zero debt.','Sin identificador gubernamental coincidente en esta fuente. Esto no demuestra deuda cero.'):t('Issuance records aggregated: ','Registros de emisiones agregados: ')+g.count}</p><p>{t('Matched government identifier: ','Identificador gubernamental coincidente: ')}{g.taxId} · {g.debtName}</p><p>{t('Reported source balances, not live debt or a complete statement of liabilities.','Saldos reportados, no deuda en tiempo real ni declaración completa de obligaciones.')}</p><a href="https://data.brb.texas.gov/local/">{t('Texas Bond Review Board · official source','Texas Bond Review Board · fuente oficial')}</a></section>}<section><h2>{t('Historical debt · FY 2016–2025','Deuda histórica · AF 2016–2025')}</h2><p>{t('Annual outstanding balances, not cumulative borrowing. Missing years do not establish zero debt. Nominal dollars.','Saldos pendientes anuales, no préstamos acumulados. Los años faltantes no demuestran deuda cero. Dólares nominales.')}</p>{Object.keys(historical).length>0?<><div aria-hidden="true">{history.years.map(y=><div style="margin:.6rem 0"><span>{y} · {historical[y]?fmt(historical[y][0]):t('Unavailable','No disponible')}</span><div style="height:10px;background:#42536a;border-radius:3px"><div style={`height:10px;background:#e1bd75;width:${historical[y]?historical[y][0]/maxPrincipal*100:0}%`}></div></div></div>)}</div><div style="overflow:auto" tabindex="0" aria-label={t('Historical debt table','Tabla de deuda histórica')}><table style="width:100%;text-align:left;white-space:nowrap"><thead><tr><th scope="col">{t('Year','Año')}</th><th scope="col">{t('Principal','Principal')}</th><th scope="col">{t('Interest','Intereses')}</th><th scope="col">{t('Reported repayment','Pago reportado')}</th></tr></thead><tbody>{history.years.map(y=><tr><th scope="row">{y}</th>{[0,1,2].map(i=><td>{fmt(historical[y]?.[i]??null)}</td>)}</tr>)}</tbody></table></div></>:<p>{t('No matching historical issuance records.','Sin registros históricos de emisiones coincidentes.')}</p>}<a href="https://data.brb.texas.gov/local/">{t('Texas Bond Review Board · official source','Texas Bond Review Board · fuente oficial')}</a></section><section><h2>{t('Relative debt burden · FY 2025','Carga relativa de deuda · AF 2025')}</h2><p>{t('Ratios use reported denominators from the same source extract. Debt per resident is not personal liability. Total principal relative to taxable value is not a tax rate; principal relative to budget is not annual debt service.','Los indicadores usan denominadores del mismo extracto. La deuda por habitante no es responsabilidad personal. El principal respecto al valor imponible no es una tasa fiscal; respecto al presupuesto no es servicio anual de deuda.')}</p>{[[t('Principal per resident','Principal por habitante'),['CITY','COUNTY'].includes(g.type)?ratio(g.principal,den[0]):null,false],[t('Repayment per resident','Pago restante por habitante'),['CITY','COUNTY'].includes(g.type)?ratio(g.repayment,den[0]):null,false],[t('Principal per average daily attendance (ADA)','Principal por asistencia diaria promedio (ADA)'),g.type==='ISD'?ratio(g.principal,den[4]):null,false],[t('Principal / taxable value','Principal / valor imponible'),ratio(g.principal,den[2],100),true],[t('Principal / budgeted expenditures','Principal / gastos presupuestados'),ratio(g.principal,den[3],100),true]].map(([label,value,pct])=><article><h3>{label}</h3><strong>{value==null?t('Unavailable','No disponible'):pct?Number(value).toFixed(2)+'%':new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(Number(value))}</strong></article>)}<a href="https://data.brb.texas.gov/local/">{t('Official source','Fuente oficial')}</a></section><ProfileSalesTax g={g} lang={lang}/></main></body></html>
---
import localDebt from '../../public/data/local-debt-2025.json';
import finances from '../../public/data/texas-state-finances-2026.json';
import PropertyLevies from './PropertyLevies.astro';
import DataFreshness from './DataFreshness.astro';
import taxes from '../data/taxes.json';
import debt from '../data/debt.json';
import governments from '../data/governments.json';
const {lang}=Astro.props;
const es=lang==='es';
const t=(a:string,b:string)=>es?b:a;
const money=(n:number)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
const localPrincipal=localDebt.records.reduce((s,r)=>s+r.principal,0);
const localInterest=localDebt.records.reduce((s,r)=>s+r.interest,0);
const localRepayment=localDebt.records.reduce((s,r)=>s+r.repayment,0);
const revenue=finances.cashRevenue.find(r=>r.label==='TOTAL NET REVENUE')!.amount;
const spending=finances.cashExpenditure.find(r=>r.label==='TOTAL NET EXPENDITURES')!.amount;
const stateTaxes=finances.cashRevenue.find(r=>r.label==='Tax Collections')!.amount;
const federal=finances.cashRevenue.find(r=>r.label==='Federal Income')!.amount;
const cards=[{name:t('Property tax levies','Gravámenes sobre propiedades'),value:taxes.property},{name:t('State sales tax','Impuesto estatal sobre ventas'),value:taxes.stateSales},{name:t('Local sales taxes','Impuestos locales sobre ventas'),value:taxes.localSales},{name:t('Other state taxes','Otros impuestos estatales'),value:taxes.otherState}];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Texas Taxpayer Clock</title><style is:inline>
:root{color-scheme:dark;font-family:system-ui,sans-serif;background:#081526;color:#f4f6fa}*{box-sizing:border-box}body{margin:0}header,main,footer{max-width:1240px;margin:auto;padding:clamp(.8rem,3vw,1.5rem)}header{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;border-bottom:1px solid #42536a}.brand{font-weight:800;text-decoration:none;font-size:.9rem;margin-right:auto}a,.eyebrow{color:#e1bd75}a:focus-visible,summary:focus-visible{outline:3px solid white;outline-offset:4px}details a{display:block;padding:.4rem}summary{cursor:pointer}.hero{padding:1rem 0 1.3rem;background:radial-gradient(ellipse at top right,#243e5d,transparent 75%)}h1{font-size:clamp(1.8rem,5vw,3.8rem);line-height:1.12;max-width:900px;color:#e1bd75;margin:.5rem 0}.hero p{margin:.5rem 0}.eyebrow{font-size:.85rem}.headline{text-align:center;border:1px solid #b99a5d;background:#142740;padding:1rem;border-radius:12px;margin-bottom:.75rem}.headline h2{font-size:clamp(1.5rem,5.5vw,3.4rem);margin:.4rem 0;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.headline p{margin:.5rem 0}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem}article{background:#142740;border:1px solid #42536a;border-radius:10px;padding:.8rem;min-width:0}article h3{font-size:.85rem;margin:0 0 .5rem}article strong{display:block;color:#e1bd75;font-size:clamp(.85rem,3.4vw,1.5rem);overflow-wrap:anywhere;font-variant-numeric:tabular-nums}small{display:block;color:#c4cfdd;margin-top:.4rem}.rate{margin-top:.75rem}.rate p{font-size:.85rem;margin:.4rem 0}section{margin-bottom:1.4rem}footer{border-top:1px solid #42536a}.skip{position:absolute;left:-9999px}.skip:focus{left:1rem;top:1rem;background:#081526;padding:1rem}@media(max-width:700px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
.clock strong{font-size:clamp(1.6rem,6vw,3rem)}.clock button{background:#e1bd75;color:#081526;border:0;border-radius:6px;padding:.6rem 1rem;margin-right:.5rem;font:inherit;cursor:pointer}.clock button:focus-visible{outline:3px solid white;outline-offset:3px}.hero{position:relative;isolation:isolate;overflow:hidden;border:1px solid #42536a;border-radius:16px;padding:clamp(1.2rem,4vw,3rem);min-height:240px;display:flex;align-items:center}.hero-art{position:absolute;inset:0;z-index:-2;background:url('https://commons.wikimedia.org/wiki/Special:FilePath/Texas_Capitol_night.jpg?width=1200'),url('/images/capitol-illustration.svg') center right/cover no-repeat;animation:capitol-drift 24s ease-in-out infinite alternate}.hero:after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,#081526 5%,#081526e8 35%,#08152655 100%)}.hero-copy{max-width:720px}.hero h1{max-width:650px;text-wrap:balance}.hero .eyebrow{letter-spacing:.07em;text-transform:uppercase}.headline{background:linear-gradient(135deg,#142740,#0b1b30);box-shadow:0 8px 24px #0003}article{transition:border-color .2s ease}article:hover{border-color:#b99a5d}header{position:sticky;top:0;z-index:5;background:#081526f5;backdrop-filter:blur(10px)}header details{position:relative}header details[open]{z-index:6}header details a{background:#142740;min-width:100px}@keyframes capitol-drift{from{transform:scale(1)}to{transform:scale(1.055)}}@media(max-width:700px){.hero{min-height:210px}.hero-art{background-position:70% center;opacity:.65}.hero:after{background:linear-gradient(90deg,#081526f5,#08152688)}.hero h1{font-size:clamp(1.65rem,6vw,2.4rem)}}@media(prefers-reduced-motion:reduce){.hero-art{animation:none}article{transition:none}}.brand{display:flex;align-items:center;gap:.4rem}.brand img{flex:none}header summary{list-style:none;font-size:1.5rem}header summary::-webkit-details-marker{display:none}header details[open] a{padding:.65rem}#gov-search{display:block;width:100%;padding:.8rem;margin:.5rem 0;background:#142740;color:white;border:1px solid #8295ae;border-radius:8px;font:inherit}#gov-results{padding-left:1.4rem;line-height:1.9}header nav{white-space:nowrap}@media(max-width:480px){header{gap:.5rem}.brand{font-size:.72rem}.brand img{width:28px;height:28px}header nav{font-size:.8rem}}.photo-credit{font-size:.72rem;color:#c4cfdd;margin:-.9rem 0 1rem}.hero-art{background-position:center 42%;background-size:cover}.hero:after{background:linear-gradient(90deg,#081526f5 5%,#081526c9 45%,#08152635 100%)}@media(max-width:700px){.hero-art{opacity:.8}.hero:after{background:linear-gradient(90deg,#081526ed,#08152685)}} .hero{display:block;padding:0;min-height:0;background:#0d1e32}.hero-art{position:relative;inset:auto;z-index:auto;width:100%;aspect-ratio:16/9;background-position:center center;background-size:cover;opacity:1;animation:none}.hero:after{display:none}.hero-copy{position:relative;max-width:none;padding:clamp(1rem,3vw,2rem);background:#0d1e32}.hero h1{max-width:850px}.hero .eyebrow{margin-top:0}@media(max-width:700px){.hero{min-height:0}.hero-art{opacity:1;aspect-ratio:4/3;background-position:center center}.hero-copy{padding:1rem}} .hero-art{background:none;aspect-ratio:auto}.hero-art img{display:block;width:100%;height:auto;max-height:440px;object-fit:contain;background:#081526}#statewide-search{display:block;width:100%;box-sizing:border-box;padding:.8rem;background:#142740;color:white;border:1px solid #8295ae;border-radius:8px;font:inherit}#financial-clock .clock strong{font-size:clamp(.85rem,3vw,1.6rem)}#financial-clock .clock{margin-top:1rem}#financial-clock .headline h2{color:#e1bd75}html{scroll-padding-top:7rem}.skip:focus{position:fixed;z-index:20}header summary{min-width:44px;min-height:44px;display:grid;place-items:center}header nav a{display:inline-flex;align-items:center;min-height:44px}header details[open]{position:relative}header details[open] a{overflow-wrap:anywhere}main:focus{outline:none}@media(max-width:360px){.grid{grid-template-columns:minmax(0,1fr)}}

.hero-art{overflow:hidden;position:relative;isolation:isolate}
.hero-art img{position:relative;z-index:0}
.hero-motion{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:1}
.hero-motion svg{width:100%;height:100%;position:absolute;inset:0}
.hero-stream{fill:none;stroke:#eac478;stroke-width:2;stroke-dasharray:5 24;stroke-linecap:round;animation:hero-flow 9s linear infinite;filter:drop-shadow(0 0 5px #ffcf70)}
.hero-stream:nth-child(2){animation-duration:13s;animation-direction:reverse}
.hero-stream:nth-child(3){animation-duration:17s}
.hero-glow{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 42%,#ffce7529,transparent 45%);mix-blend-mode:screen;animation:hero-pulse 8s ease-in-out infinite alternate}
.hero-haze{position:absolute;inset:-15%;background:radial-gradient(ellipse at 20% 15%,#a9c7ed24,transparent 35%);animation:hero-haze 20s ease-in-out infinite alternate}
.hero-motion-toggle{position:absolute;right:.65rem;bottom:.65rem;z-index:2;background:#081526ed;color:#fff;border:1px solid #e1bd75;border-radius:6px;min-height:44px;padding:.5rem .8rem;font:inherit;cursor:pointer}
.hero-motion-toggle:focus-visible{outline:3px solid white;outline-offset:3px}
.hero-art[data-paused="true"] .hero-motion *{animation-play-state:paused}
@keyframes hero-flow{to{stroke-dashoffset:-290}}
@keyframes hero-pulse{from{opacity:.25}to{opacity:.9}}
@keyframes hero-haze{to{transform:translateX(12%)}}
@media(prefers-reduced-motion:reduce){.hero-motion *{animation:none!important}}

/* Cinematic composition: stationary copy, moving decorative light only. */
.hero{display:grid;min-height:460px;background:#081526;isolation:isolate}
.hero-art,.hero-copy{grid-area:1/1}
.hero-art{height:100%;min-height:460px;aspect-ratio:auto;background:#081526}
.hero-art img{width:100%;height:100%;max-height:none;object-fit:cover;object-position:center 42%;filter:brightness(.83) sepia(.15)}
.hero-art:after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(0deg,#081526 0%,#081526e8 22%,#08152635 65%,#08152610),linear-gradient(90deg,#08152688,transparent 80%)}
.hero-copy{align-self:end;z-index:2;background:transparent;pointer-events:none;padding:clamp(1rem,4vw,3rem);text-shadow:0 2px 12px #000}
.hero-copy h1{font-size:clamp(1.65rem,4.5vw,3.4rem);max-width:760px}
.hero-motion{z-index:1}
.hero-stream{stroke:url(#hero-gold);stroke-width:2.8;stroke-dasharray:180 900;animation:hero-flow 6s linear infinite;opacity:.85;filter:drop-shadow(0 0 7px #ffc36a)}
.hero-stream:nth-of-type(2){animation-duration:9s;animation-delay:-4s}
.hero-stream:nth-of-type(3){animation-duration:12s;animation-delay:-7s}
@keyframes hero-flow{from{stroke-dashoffset:1080}to{stroke-dashoffset:0}}
.hero-glow{background:radial-gradient(ellipse at 50% 40%,#ffce7544,transparent 50%)}
.hero-haze{background:radial-gradient(ellipse at 20% 15%,#648dc83b,transparent 55%)}
.hero-motion-toggle{top:.65rem;bottom:auto;right:.65rem;width:44px;height:44px;padding:0;font-size:1.15rem;z-index:4}
.hero-motion-toggle[hidden]{display:none}
.hero-copy .hero-debt{font-size:clamp(1.4rem,4vw,2.5rem);font-weight:800;color:#f4d18c;font-variant-numeric:tabular-nums;overflow-wrap:anywhere;margin:.65rem 0 0}
.hero-copy .hero-debt-label{font-size:.8rem;color:#e1e8f2}
@media(max-width:700px){.hero,.hero-art{min-height:500px}.hero-art img{object-position:center top}.hero-copy{padding:1rem}.hero-art:after{background:linear-gradient(0deg,#081526 0%,#081526f5 26%,#08152655 62%,transparent 85%)}}
/* Keep the Capitol visible above the headline on narrow screens. */
@media(max-width:700px){.hero,.hero-art{min-height:620px}.hero-art img{position:absolute;top:0;left:0;height:380px;object-fit:cover;object-position:center 42%}.hero-art:after{background:linear-gradient(0deg,#081526 0%,#081526 38%,#08152600 75%)}.hero-copy{align-self:end;padding:1rem}.hero-motion{height:380px}}
@media(max-width:700px){.hero-art img{object-fit:contain;object-position:center top;filter:none}.hero-art:after{background:linear-gradient(0deg,#081526 0%,#081526 38%,transparent 65%)}}.hero-art img{filter:none}.hero-stream{opacity:.4}
</style></head><body>
<a class="skip" href="#main">{t('Skip to content','Ir al contenido')}</a>
<header><a class="brand" href={es?'/es/':'/'}><img src="/images/texas-clock.svg" alt="" width="38" height="38"/> <span>TEXAS TAXPAYER CLOCK</span></a><nav aria-label={t('Language','Idioma')}><a href="/" lang="en" aria-label="English">🇺🇸 EN</a> · <a href="/es/" lang="es" aria-label="Español">🇵🇷 ES</a></nav><details><summary aria-label={t('Navigation menu','Menú de navegación')}><span aria-hidden="true">☰</span></summary><a href="#taxes">{t('Taxes','Impuestos')}</a><a href="#debt">{t('Debt','Deuda')}</a><a href="#explorer">{t("Government explorer","Explorador de gobiernos")}</a><a href="#data-freshness">{t("Data freshness","Vigencia de datos")}</a><a href="#sources">{t('Sources','Fuentes')}</a></details></header>
<main id="main" tabindex="-1"><section class="hero"><div class="hero-art"><img src="/images/file_00000000556481f692557d4ff810be30.png" alt={t("Texas State Capitol at night","Capitolio de Texas de noche")} width="1179" height="1312" /><div class="hero-motion" aria-hidden="true"><div class="hero-haze"></div><div class="hero-glow"></div><svg viewBox="0 0 1200 440" preserveAspectRatio="none"><defs><linearGradient id="hero-gold"><stop stop-color="#b47c35" stop-opacity=".15"/><stop offset=".5" stop-color="#ffe2a0"/><stop offset="1" stop-color="#d9a14c" stop-opacity=".25"/></linearGradient></defs><path class="hero-stream" d="M-40 410 Q300 400 600 245 T1240 360"/><path class="hero-stream" d="M-40 440 Q360 310 600 280 T1240 425"/><path class="hero-stream" d="M-40 350 Q260 420 600 300 T1240 390"/></svg></div><button hidden class="hero-motion-toggle" id="hero-motion-toggle" type="button" aria-label={t("Pause animation","Pausar animación")} data-pause={t("Pause animation","Pausar animación")} data-resume={t("Resume animation","Reanudar animación")}>Ⅱ</button></div><div class="hero-copy"><p class="eyebrow">{t('Independent financial transparency','Transparencia financiera independiente')}</p><h1>{t('254 Counties. Thousands of Governments. Your Money.','254 condados. Miles de gobiernos. Su dinero.')}</h1><p>{t('Follow the Debt. Follow the Taxes. Follow the Money.','Siga la deuda. Siga los impuestos. Siga el dinero.')}</p><p class="hero-debt">{money(debt.state.principal+localPrincipal)}</p><p class="hero-debt-label">{t('Reported FY2025 state + local principal · not a live balance','Principal estatal + local reportado AF2025 · no es saldo en tiempo real')}</p></div></section>
<p><a href={es?'/es/methodology/':'/methodology/'}>{t('Data methodology, limitations and corrections','Metodología, limitaciones y correcciones')}</a></p><p class="photo-credit">{t("AI-generated artistic illustration of the Texas Capitol","Ilustración artística del Capitolio de Texas generada por IA")}</p><section id="financial-clock" aria-labelledby="clock-title"><div class="headline"><p class="eyebrow">{t('Texas financial clock · reported debt FY2025','Reloj financiero de Texas · deuda reportada AF2025')}</p><h2 id="clock-title">{money(debt.state.principal+localPrincipal)}</h2><p>{t('State + local outstanding principal · August 31, 2025','Principal estatal + local pendiente · 31 de agosto de 2025')}</p><small>{t('Arithmetic sum, not consolidated debt or a live balance.','Suma aritmética, no deuda consolidada ni saldo en tiempo real.')}</small></div><div class="grid">{[{n:t('State principal','Principal estatal'),v:debt.state.principal},{n:t('Local principal','Principal local'),v:localPrincipal},{n:t('Local remaining interest','Intereses locales restantes'),v:localInterest},{n:t('Local reported repayment','Pago local restante reportado'),v:localRepayment}].map(c=><article><h3>{c.n}</h3><strong>{money(c.v)}</strong><small>FY2025</small></article>)}</div><p><a href="https://data.brb.texas.gov/local/">{t('Official debt source','Fuente oficial de deuda')}</a></p><p><a href={es?'/es/evidence/':'/evidence/'}>{t('View financial evidence and calculations','Ver evidencia financiera y cálculos')}</a></p><div class="grid">{[{n:t('State net revenue','Ingresos estatales netos'),v:revenue},{n:t('State net expenditures','Gastos estatales netos'),v:spending},{n:t('State tax collections','Recaudación estatal'),v:stateTaxes},{n:t('Federal income','Ingresos federales'),v:federal}].map(c=><article><h3>{c.n}</h3><strong>{money(c.v)}</strong><small>FY2026</small></article>)}</div><p><a href={finances.cashSource}>{t('Official cash report','Informe oficial de efectivo')}</a></p><article class="clock"><h2>{t('Moving financial counters','Contadores financieros dinámicos')}</h2><p>{t('Illustrative daily amounts since midnight Central Time, using FY2026 annual averages. Not actual collections, expenditures or forecasts.','Montos diarios ilustrativos desde medianoche hora central, según promedios anuales AF2026. No son recaudaciones, gastos ni pronósticos reales.')}</p><div class="grid">{[{n:t('Modeled revenue today','Ingresos simulados hoy'),v:revenue},{n:t('Modeled spending today','Gastos simulados hoy'),v:spending},{n:t('Modeled state taxes today','Impuestos estatales simulados hoy'),v:stateTaxes},{n:t('Modeled federal income today','Ingresos federales simulados hoy'),v:federal}].map(c=><article><h3>{c.n}</h3><strong data-daily-rate={c.v/31536000}>—</strong><small>{money(c.v/365)} / {t('average day','día promedio')}</small></article>)}</div><p><button id="clock-toggle" type="button" data-pause={t('Pause','Pausar')} data-resume={t('Resume','Continuar')}>{t('Pause','Pausar')}</button></p><noscript>{t('Moving estimates require JavaScript.','Las estimaciones dinámicas requieren JavaScript.')}</noscript></article></section><section id="taxes" aria-labelledby="tax-title"><div class="headline"><p class="eyebrow">{t('Reported Texas taxes · 2023','Impuestos reportados de Texas · 2023')}</p><h2 id="tax-title">{money(taxes.total)}</h2><p>{t('Annual reported total, not a live balance','Total anual reportado, no saldo en tiempo real')}</p><a href={taxes.source}>{t('Official report · Exhibit 1, p. 5','Informe oficial · Cuadro 1, p. 5')}</a></div>
<div class="grid">{cards.map(c=><article><h3>{c.name}</h3><strong>{money(c.value)}</strong><small>2023</small></article>)}</div>
<article class="rate"><h3>{t('Average annual equivalent per second','Equivalente anual promedio por segundo')}</h3><strong>{(taxes.total/31536000).toLocaleString('en-US',{style:'currency',currency:'USD'})}</strong><p>{t('Annual total divided by 365 days. Not actual live collections.','Total anual dividido entre 365 días. No representa recaudación en tiempo real.')}</p></article></section>
<section id="debt"><h2>{t('Government debt','Deuda gubernamental')} · FY 2025</h2><div class="grid">{[{name:t('State principal','Principal estatal'),value:debt.state.principal,url:debt.state.source},{name:t('Local principal','Principal local'),value:debt.local.principal,url:debt.local.source},{name:t('Local tax-supported debt','Deuda local respaldada por impuestos'),value:debt.local.tax,url:debt.local.source},{name:t('Local revenue-supported debt','Deuda local respaldada por ingresos'),value:debt.local.revenue,url:debt.local.source}].map(c=><article><h3>{c.name}</h3><strong>{money(c.value)}</strong><small>2025-08-31</small><a href={c.url}>{t('Official dataset','Datos oficiales')}</a></article>)}</div><p>{t('Reported outstanding principal, not total repayment or live borrowing. State and local balances are not consolidated.','Principal pendiente reportado, no pago total ni endeudamiento en tiempo real. Los saldos estatales y locales no están consolidados.')}</p><p>{t('Local remaining interest and reported repayment are shown above from the issuance dataset. The local principal in the pledge breakdown differs by $4 from the issuance total.','Los intereses locales y pagos reportados aparecen arriba según el conjunto de emisiones. El principal por respaldo difiere por $4 del total de emisiones.')}</p><details><summary>{t('Source discrepancies under review','Discrepancias entre fuentes en revisión')}</summary><p>{t('Other official reports show different FY 2025 balances. The figures above use the BRB Data Center series; differences remain unresolved.','Otros informes oficiales muestran saldos distintos para 2025. Las cifras anteriores corresponden al centro de datos BRB; las diferencias siguen sin resolverse.')}</p>{debt.discrepancies.map(d=><p><a href={d.source}>{d.id} · {t('Official report','Informe oficial')}</a></p>)}</details></section>
<section id="debt-leaderboard"><h2>{t('Texas Debt Leaderboard','Clasificación de deuda de Texas')}</h2><p>{t('Compare 3,319 FY 2025 reporting entities by principal, interest and repayment.','Compare 3,319 entidades del AF 2025 por principal, intereses y pagos.')}</p><a href={es?'/es/debt/':'/debt/'}>{t('Explore statewide debt rankings','Explorar clasificación estatal de deuda')}</a><p><a href={es?'/es/unmatched-debt/':'/unmatched-debt/'}>{t('Explore debt records without an exact tax-directory match','Explorar registros de deuda sin coincidencia exacta en el directorio tributario')}</a></p></section><section id="revenue"><h2>{t('Revenue and Spending Explorer','Explorador de ingresos y gastos')}</h2><a href={es?'/es/revenue/':'/revenue/'}>{t('Follow government revenue and spending','Siga los ingresos y gastos públicos')}</a></section><section id="local-sales-tax"><h2>{t('Local sales tax allocations','Asignaciones locales de impuestos sobre ventas')}</h2><p><a href={es?'/es/local-sales-tax/':'/local-sales-tax/'}>{t('Current allocations','Asignaciones actuales')}</a> · <a href={es?'/es/local-sales-tax-history/':'/local-sales-tax-history/'}>{t('Historical allocations','Asignaciones históricas')}</a></p></section><section id="county-map"><h2>{t('Texas County Financial Map','Mapa financiero de condados de Texas')}</h2><a href={es?'/es/county-map/':'/county-map/'}>{t('Explore all 254 counties','Explore los 254 condados')}</a></section><section id="explorer"><h2>{t('Government Explorer','Explorador de gobiernos')}</h2><p>{t('Featured profiles · 4,963 governments in the statewide directory below.','Perfiles destacados · 4,963 gobiernos en el directorio estatal abajo.')}</p><label for="gov-search">{t('Find a government','Buscar un gobierno')}</label><input id="gov-search" type="search" placeholder={t('City, county or school district','Ciudad, condado o distrito escolar')}/><ul id="gov-results">{governments.map(g=><li data-name={g.name.toLowerCase()}><a href={(es?'/es':'')+'/government/'+g.id+'/'}>{g.name}</a></li>)}</ul><p id="gov-empty" hidden>{t('No matches in pilot directory.','Sin coincidencias en el directorio piloto.')}</p></section>
<section id="calculator"><h2>{t('Household Property Tax Calculator','Calculadora de impuestos sobre propiedades')}</h2><p>{t('Estimate your annual and monthly property tax burden using official historical rates.','Estime sus impuestos anuales y mensuales con tasas oficiales históricas.')}</p><a href={es?'/es/calculator/':'/calculator/'}>{t('Calculate your property taxes','Calcular sus impuestos')}</a></section><section id="tax-leaderboard"><h2>{t('Texas Property Tax Leaderboard','Clasificación de impuestos sobre propiedades')}</h2><p>{t('Compare historical rates and annual changes across 4,963 taxing units.','Compare tasas históricas y cambios anuales de 4,963 entidades.')}</p><a href={es?'/es/tax-rates/':'/tax-rates/'}>{t('Explore property tax rankings','Explorar clasificación de tasas')}</a></section><section id="statewide"><h2>{t('Statewide property tax directory','Directorio estatal de impuestos sobre propiedades')}</h2><p>{t('Official taxing unit IDs and annual rates per $100 taxable value. Missing rates are not zero.','Identificadores oficiales y tasas anuales por cada $100 de valor imponible. Datos faltantes no equivalen a cero.')}</p><label for="statewide-search">{t('Search name or taxing unit ID','Buscar nombre o identificador')}</label><input id="statewide-search" type="search" placeholder="Copperas Cove" /><p id="statewide-status" role="status">{t('Loading official directory…','Cargando directorio oficial…')}</p><div id="statewide-results"></div><a href="https://comptroller.texas.gov/taxes/property-tax/rates/index.php">{t('Official source','Fuente oficial')}</a></section><script>
const q=document.querySelector<HTMLInputElement>('#statewide-search'),out=document.querySelector<HTMLElement>('#statewide-results'),status=document.querySelector<HTMLElement>('#statewide-status');
if(q&&out&&status){const es=document.documentElement.lang==='es';fetch('/data/tax-units.json').then(r=>{if(!r.ok)throw Error();return r.json()}).then((units:{id:string,name:string,rates:Record<string,number|null>}[])=>{const render=()=>{const term=q.value.trim().toLowerCase();const matches=term?units.filter(u=>(u.name+(u.id.endsWith('-000-00')?' County Condado':'')+' '+u.id).toLowerCase().includes(term)):[];status.textContent=term?String(matches.length)+(es?' coincidencias':' matches'):(es?'Escriba un nombre.':'Enter a name to search.')+' ('+units.length+')';out.replaceChildren();for(const u of matches.slice(0,50)){const a=document.createElement('article'),h=document.createElement('h3');h.textContent=(u.id.endsWith('-000-00')?u.name+' County':u.name)+' · '+u.id;a.append(h);const link=document.createElement('a');const aliases:Record<string,string>={"227-104-03":"austin","141-000-00":"lampasas-county","050-101-03":"copperas-cove","050-902-02":"gatesville-isd","050-102-03":"gatesville","014-000-00":"bell-county","050-000-00":"coryell-county","050-910-02":"copperas-cove-isd"};link.href=(es?'/es':'')+'/government/'+(aliases[u.id]||u.id)+'/';link.textContent=es?'Ver perfil financiero':'View financial profile';a.append(link);for(const y of ['2021','2022','2023','2024','2025']){const p=document.createElement('p');const v=u.rates[y];p.textContent=y+': '+(v==null?(es?'No disponible':'Unavailable'):'$'+v.toFixed(6));a.append(p)}out.append(a)}};q.addEventListener('input',render);render()}).catch(()=>{status.textContent=es?'Importación pendiente.':'Data import pending.'})}
</script><PropertyLevies lang={lang}/><p><a href={lang==='es'?'/es/household-burden/':'/household-burden/'}>{lang==='es'?'Calculadora de carga tributaria familiar':'Household taxpayer burden calculator'}</a></p><p><a href={lang==='es'?'/es/pensions/':'/pensions/'}>{lang==='es'?'Responsabilidad de pensiones':'Pension accountability explorer'}</a></p><p><a href={lang==='es'?'/es/local-finances/':'/local-finances/'}>{lang==='es'?'Encuesta financiera municipal y de condados':'Municipal and county finance survey'}</a></p><p><a href={lang==='es'?'/es/economic-development/':'/economic-development/'}>{lang==='es'?'Explorar desarrollo económico':'Explore economic development finances'}</a></p><p><a href={lang==='es'?'/es/appraisal-districts/':'/appraisal-districts/'}>{lang==='es'?'Explorar distritos de tasación':'Explore appraisal districts'}</a></p><p><a href={lang==='es'?'/es/school-spending/':'/school-spending/'}>{lang==='es'?'Explorar gastos escolares':'Explore school spending'}</a></p><p><a href={lang==='es'?'/es/school-rankings/':'/school-rankings/'}>{lang==='es'?'Explorar clasificación financiera de distritos escolares':'Explore school district financial rankings'}</a></p><DataFreshness lang={lang}/><section id="sources"><h2>{t('Source library','Biblioteca de fuentes')}</h2><p><a href={taxes.source}>Texas Comptroller · 2022–2023</a></p><p><a href="https://www.brb.texas.gov/">Texas Bond Review Board</a></p><p>{t('Historical snapshots are not live transactions. Missing figures are not zero.','Los datos históricos no son transacciones en tiempo real. Los datos faltantes no son cero.')}</p></section></main><footer><a href={es?'/es/compare/':'/compare/'}>{t('Compare governments','Comparar gobiernos')}</a> · <a href={es?'/es/watchlist/':'/watchlist/'}>{t('My taxpayer watchlist','Mi lista de vigilancia tributaria')}</a> · Texas Taxpayer Clock · <a href={es?'/es/support/':'/support/'}>{t('Support this project','Apoye este proyecto')}</a></footer><script>
const counters=Array.from(document.querySelectorAll<HTMLElement>('[data-daily-rate]'));
const toggle=document.querySelector<HTMLButtonElement>('#clock-toggle');
const time=new Intl.DateTimeFormat('en-US',{timeZone:'America/Chicago',hourCycle:'h23',hour:'2-digit',minute:'2-digit',second:'2-digit'});
const format=new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0});
let running=!window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const render=()=>{const parts=time.formatToParts(new Date());const get=(k:string)=>Number(parts.find(p=>p.type===k)?.value??0);const seconds=get('hour')*3600+get('minute')*60+get('second');for(const c of counters)c.textContent=format.format(Number(c.dataset.dailyRate)*seconds);};
const label=()=>{if(toggle)toggle.textContent=running?toggle.dataset.pause!:toggle.dataset.resume!;};
toggle?.addEventListener('click',()=>{running=!running;label();if(running)render();});label();render();window.setInterval(()=>{if(running&&!document.hidden)render();},1000);
const search=document.querySelector<HTMLInputElement>('#gov-search');
const entries=Array.from(document.querySelectorAll<HTMLElement>('#gov-results li'));
const empty=document.querySelector<HTMLElement>('#gov-empty');
search?.addEventListener('input',()=>{const q=search.value.trim().toLowerCase();let count=0;for(const e of entries){e.hidden=!(e.dataset.name||'').includes(q);if(!e.hidden)count++;}if(empty)empty.hidden=count!==0;});
</script><script>
const heroButton=document.querySelector<HTMLButtonElement>('#hero-motion-toggle');
const heroArt=heroButton?.closest<HTMLElement>('.hero-art');
const motionPreference=window.matchMedia('(prefers-reduced-motion: reduce)');
if(heroButton&&heroArt&&!motionPreference.matches){
 heroButton.hidden=false;
 heroButton.addEventListener('click',()=>{
 const paused=heroArt.dataset.paused!=='true';
 heroArt.dataset.paused=String(paused);
 heroButton.textContent=paused?"▶":"Ⅱ"; heroButton.setAttribute("aria-label",paused?heroButton.dataset.resume!:heroButton.dataset.pause!);
 });
 motionPreference.addEventListener('change',()=>{heroButton.hidden=motionPreference.matches;});
}
</script></body></html>

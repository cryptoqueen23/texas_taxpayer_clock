---
const {lang} = Astro.props;
const es = lang === 'es';
const t = (en:string, sp:string) => es ? sp : en;
const sections = [['Debt','Deuda'],['Property taxes','Impuestos sobre propiedades'],['Sales taxes','Impuestos sobre ventas'],['Revenue','Ingresos'],['Spending','Gastos'],['Pensions','Pensiones'],['Economic development','Desarrollo económico'],['School finance','Finanzas escolares']];
---
<!doctype html>
<html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Texas Taxpayer Clock</title></head>
<body><a class="skip" href="#main">{t('Skip to content','Ir al contenido')}</a><header><strong>TEXAS TAXPAYER CLOCK</strong><nav aria-label={t('Language','Idioma')}><a href="/">English</a> · <a href="/es/">Español</a></nav></header>
<main id="main"><section class="hero"><p class="eyebrow">{t('Independent financial transparency','Transparencia financiera independiente')}</p><h1>{t('254 Counties. Thousands of Governments. Your Money.','254 condados. Miles de gobiernos. Su dinero.')}</h1><p>{t('Follow the Debt. Follow the Taxes. Follow the Money.','Siga la deuda. Siga los impuestos. Siga el dinero.')}</p></section>
<section aria-labelledby="status"><h2 id="status">{t('Financial dashboard','Panel financiero')}</h2><p>{t('Development preview. Financial datasets are pending validation.','Vista de desarrollo. Datos financieros pendientes de validación.')}</p><div class="grid">{sections.map(([en,sp])=><article><h3>{t(en,sp)}</h3><p class="amount">—</p><p>{t('Data pending','Datos pendientes')}</p></article>)}</div></section>
<section><h2>{t('Official sources','Fuentes oficiales')}</h2><p><a href="https://www.brb.texas.gov/">Texas Bond Review Board</a></p><p><a href="https://comptroller.texas.gov/taxes/property-tax/rates/index.php">Texas Comptroller: {t('Tax rates and levies','Tasas y gravámenes')}</a></p><p>{t('Reported balances are snapshots. Modeled counters are not live transactions.','Los saldos corresponden a fechas específicas. Los contadores estimados no son transacciones en tiempo real.')}</p></section></main><footer>Texas Taxpayer Clock · {t('Independent project','Proyecto independiente')}</footer></body></html>
<style is:global>
:root{color-scheme:dark;font-family:system-ui,sans-serif;background:#081526;color:#f4f6fa}*{box-sizing:border-box}body{margin:0}header,main,footer{max-width:1200px;margin:auto;padding:1.5rem}header{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;border-bottom:1px solid #42536a}a,strong,.eyebrow{color:#e1bd75}a:focus-visible{outline:3px solid white;outline-offset:4px}.hero{padding:clamp(2rem,8vw,6rem) 0;background:radial-gradient(ellipse at top right,#243e5d,transparent 70%)}h1{font-size:clamp(2rem,6vw,4.5rem);max-width:900px;line-height:1.1;color:#e1bd75}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:1rem}article{background:#142740;border:1px solid #42536a;border-radius:12px;padding:1.25rem}.amount{font-size:2rem;color:#e1bd75}footer{border-top:1px solid #42536a;margin-top:2rem}.skip{position:absolute;left:-9999px}.skip:focus{left:1rem;top:1rem;background:#081526;padding:1rem}
</style>
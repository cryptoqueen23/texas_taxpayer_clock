---
import taxes from '../data/taxes.json';
import debt from '../data/debt.json';
const {lang}=Astro.props;
const es=lang==='es';
const t=(a:string,b:string)=>es?b:a;
const money=(n:number)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
const cards=[{name:t('Property tax levies','Gravámenes sobre propiedades'),value:taxes.property},{name:t('State sales tax','Impuesto estatal sobre ventas'),value:taxes.stateSales},{name:t('Local sales taxes','Impuestos locales sobre ventas'),value:taxes.localSales},{name:t('Other state taxes','Otros impuestos estatales'),value:taxes.otherState}];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Texas Taxpayer Clock</title></head><body>
<a class="skip" href="#main">{t('Skip to content','Ir al contenido')}</a>
<header><a class="brand" href={es?'/es/':'/'}>✯ TEXAS TAXPAYER CLOCK</a><nav aria-label={t('Language','Idioma')}><a href="/" lang="en">EN</a> · <a href="/es/" lang="es">ES</a></nav><details><summary>{t('Menu','Menú')}</summary><a href="#taxes">{t('Taxes','Impuestos')}</a><a href="#debt">{t('Debt','Deuda')}</a><a href="#sources">{t('Sources','Fuentes')}</a></details></header>
<main id="main"><section class="hero"><p class="eyebrow">{t('Independent financial transparency','Transparencia financiera independiente')}</p><h1>{t('254 Counties. Thousands of Governments. Your Money.','254 condados. Miles de gobiernos. Su dinero.')}</h1><p>{t('Follow the Debt. Follow the Taxes. Follow the Money.','Siga la deuda. Siga los impuestos. Siga el dinero.')}</p></section>
<section id="taxes" aria-labelledby="tax-title"><div class="headline"><p class="eyebrow">{t('Reported Texas taxes · 2023','Impuestos reportados de Texas · 2023')}</p><h2 id="tax-title">{money(taxes.total)}</h2><p>{t('Annual reported total, not a live balance','Total anual reportado, no saldo en tiempo real')}</p><a href={taxes.source}>{t('Official report · Exhibit 1, p. 5','Informe oficial · Cuadro 1, p. 5')}</a></div>
<div class="grid">{cards.map(c=><article><h3>{c.name}</h3><strong>{money(c.value)}</strong><small>2023</small></article>)}</div>
<article class="rate"><h3>{t('Average annual equivalent per second','Equivalente anual promedio por segundo')}</h3><strong>{(taxes.total/31536000).toLocaleString('en-US',{style:'currency',currency:'USD'})}</strong><p>{t('Annual total divided by 365 days. Not actual live collections.','Total anual dividido entre 365 días. No representa recaudación en tiempo real.')}</p></article></section>
<section id="debt"><h2>{t('Government debt','Deuda gubernamental')} · FY 2025</h2><div class="grid">{[{name:t('State principal','Principal estatal'),value:debt.state.principal,url:debt.state.source},{name:t('Local principal','Principal local'),value:debt.local.principal,url:debt.local.source},{name:t('Local tax-supported debt','Deuda local respaldada por impuestos'),value:debt.local.tax,url:debt.local.source},{name:t('Local revenue-supported debt','Deuda local respaldada por ingresos'),value:debt.local.revenue,url:debt.local.source}].map(c=><article><h3>{c.name}</h3><strong>{money(c.value)}</strong><small>2025-08-31</small><a href={c.url}>{t('Official dataset','Datos oficiales')}</a></article>)}</div><p>{t('Reported outstanding principal, not total repayment or live borrowing. State and local balances are not consolidated.','Principal pendiente reportado, no pago total ni endeudamiento en tiempo real. Los saldos estatales y locales no están consolidados.')}</p><p>{t('Remaining interest and total repayment: pending source-level verification.','Intereses restantes y pago total: pendientes de verificación.')}</p><details><summary>{t('Source discrepancies under review','Discrepancias entre fuentes en revisión')}</summary><p>{t('Other official reports show different FY 2025 balances. The figures above use the BRB Data Center series; differences remain unresolved.','Otros informes oficiales muestran saldos distintos para 2025. Las cifras anteriores corresponden al centro de datos BRB; las diferencias siguen sin resolverse.')}</p>{debt.discrepancies.map(d=><p><a href={d.source}>{d.id} · {t('Official report','Informe oficial')}</a></p>)}</details></section>
<section id="sources"><h2>{t('Source library','Biblioteca de fuentes')}</h2><p><a href={taxes.source}>Texas Comptroller · 2022–2023</a></p><p><a href="https://www.brb.texas.gov/">Texas Bond Review Board</a></p><p>{t('Historical snapshots are not live transactions. Missing figures are not zero.','Los datos históricos no son transacciones en tiempo real. Los datos faltantes no son cero.')}</p></section></main><footer>Texas Taxpayer Clock</footer></body></html>
<style is:global>
:root{color-scheme:dark;font-family:system-ui,sans-serif;background:#081526;color:#f4f6fa}*{box-sizing:border-box}body{margin:0}header,main,footer{max-width:1240px;margin:auto;padding:clamp(.8rem,3vw,1.5rem)}header{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;border-bottom:1px solid #42536a}.brand{font-weight:800;text-decoration:none;font-size:.9rem;margin-right:auto}a,.eyebrow{color:#e1bd75}a:focus-visible,summary:focus-visible{outline:3px solid white;outline-offset:4px}details a{display:block;padding:.4rem}summary{cursor:pointer}.hero{padding:1rem 0 1.3rem;background:radial-gradient(ellipse at top right,#243e5d,transparent 75%)}h1{font-size:clamp(1.8rem,5vw,3.8rem);line-height:1.12;max-width:900px;color:#e1bd75;margin:.5rem 0}.hero p{margin:.5rem 0}.eyebrow{font-size:.85rem}.headline{text-align:center;border:1px solid #b99a5d;background:#142740;padding:1rem;border-radius:12px;margin-bottom:.75rem}.headline h2{font-size:clamp(1.5rem,5.5vw,3.4rem);margin:.4rem 0;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.headline p{margin:.5rem 0}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem}article{background:#142740;border:1px solid #42536a;border-radius:10px;padding:.8rem;min-width:0}article h3{font-size:.85rem;margin:0 0 .5rem}article strong{display:block;color:#e1bd75;font-size:clamp(.85rem,3.4vw,1.5rem);overflow-wrap:anywhere;font-variant-numeric:tabular-nums}small{display:block;color:#c4cfdd;margin-top:.4rem}.rate{margin-top:.75rem}.rate p{font-size:.85rem;margin:.4rem 0}section{margin-bottom:1.4rem}footer{border-top:1px solid #42536a}.skip{position:absolute;left:-9999px}.skip:focus{left:1rem;top:1rem;background:#081526;padding:1rem}@media(max-width:700px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
---
import taxes from '../data/taxes.json';
import debt from '../data/debt.json';
import governments from '../data/governments.json';
const {lang}=Astro.props;
const es=lang==='es';
const t=(a:string,b:string)=>es?b:a;
const money=(n:number)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
const cards=[{name:t('Property tax levies','Gravámenes sobre propiedades'),value:taxes.property},{name:t('State sales tax','Impuesto estatal sobre ventas'),value:taxes.stateSales},{name:t('Local sales taxes','Impuestos locales sobre ventas'),value:taxes.localSales},{name:t('Other state taxes','Otros impuestos estatales'),value:taxes.otherState}];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Texas Taxpayer Clock</title><style is:inline>
:root{color-scheme:dark;font-family:system-ui,sans-serif;background:#081526;color:#f4f6fa}*{box-sizing:border-box}body{margin:0}header,main,footer{max-width:1240px;margin:auto;padding:clamp(.8rem,3vw,1.5rem)}header{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;border-bottom:1px solid #42536a}.brand{font-weight:800;text-decoration:none;font-size:.9rem;margin-right:auto}a,.eyebrow{color:#e1bd75}a:focus-visible,summary:focus-visible{outline:3px solid white;outline-offset:4px}details a{display:block;padding:.4rem}summary{cursor:pointer}.hero{padding:1rem 0 1.3rem;background:radial-gradient(ellipse at top right,#243e5d,transparent 75%)}h1{font-size:clamp(1.8rem,5vw,3.8rem);line-height:1.12;max-width:900px;color:#e1bd75;margin:.5rem 0}.hero p{margin:.5rem 0}.eyebrow{font-size:.85rem}.headline{text-align:center;border:1px solid #b99a5d;background:#142740;padding:1rem;border-radius:12px;margin-bottom:.75rem}.headline h2{font-size:clamp(1.5rem,5.5vw,3.4rem);margin:.4rem 0;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.headline p{margin:.5rem 0}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem}article{background:#142740;border:1px solid #42536a;border-radius:10px;padding:.8rem;min-width:0}article h3{font-size:.85rem;margin:0 0 .5rem}article strong{display:block;color:#e1bd75;font-size:clamp(.85rem,3.4vw,1.5rem);overflow-wrap:anywhere;font-variant-numeric:tabular-nums}small{display:block;color:#c4cfdd;margin-top:.4rem}.rate{margin-top:.75rem}.rate p{font-size:.85rem;margin:.4rem 0}section{margin-bottom:1.4rem}footer{border-top:1px solid #42536a}.skip{position:absolute;left:-9999px}.skip:focus{left:1rem;top:1rem;background:#081526;padding:1rem}@media(max-width:700px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
.clock strong{font-size:clamp(1.6rem,6vw,3rem)}.clock button{background:#e1bd75;color:#081526;border:0;border-radius:6px;padding:.6rem 1rem;margin-right:.5rem;font:inherit;cursor:pointer}.clock button:focus-visible{outline:3px solid white;outline-offset:3px}.hero{position:relative;isolation:isolate;overflow:hidden;border:1px solid #42536a;border-radius:16px;padding:clamp(1.2rem,4vw,3rem);min-height:240px;display:flex;align-items:center}.hero-art{position:absolute;inset:0;z-index:-2;background:url('https://commons.wikimedia.org/wiki/Special:FilePath/Texas_Capitol_night.jpg?width=1200'),url('/images/capitol-illustration.svg') center right/cover no-repeat;animation:capitol-drift 24s ease-in-out infinite alternate}.hero:after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,#081526 5%,#081526e8 35%,#08152655 100%)}.hero-copy{max-width:720px}.hero h1{max-width:650px;text-wrap:balance}.hero .eyebrow{letter-spacing:.07em;text-transform:uppercase}.headline{background:linear-gradient(135deg,#142740,#0b1b30);box-shadow:0 8px 24px #0003}article{transition:border-color .2s ease}article:hover{border-color:#b99a5d}header{position:sticky;top:0;z-index:5;background:#081526f5;backdrop-filter:blur(10px)}header details{position:relative}header details[open]{z-index:6}header details a{background:#142740;min-width:100px}@keyframes capitol-drift{from{transform:scale(1)}to{transform:scale(1.055)}}@media(max-width:700px){.hero{min-height:210px}.hero-art{background-position:70% center;opacity:.65}.hero:after{background:linear-gradient(90deg,#081526f5,#08152688)}.hero h1{font-size:clamp(1.65rem,6vw,2.4rem)}}@media(prefers-reduced-motion:reduce){.hero-art{animation:none}article{transition:none}}.brand{display:flex;align-items:center;gap:.4rem}.brand img{flex:none}header summary{list-style:none;font-size:1.5rem}header summary::-webkit-details-marker{display:none}header details[open] a{padding:.65rem}#gov-search{display:block;width:100%;padding:.8rem;margin:.5rem 0;background:#142740;color:white;border:1px solid #8295ae;border-radius:8px;font:inherit}#gov-results{padding-left:1.4rem;line-height:1.9}header nav{white-space:nowrap}@media(max-width:480px){header{gap:.5rem}.brand{font-size:.72rem}.brand img{width:28px;height:28px}header nav{font-size:.8rem}}.photo-credit{font-size:.72rem;color:#c4cfdd;margin:-.9rem 0 1rem}.hero-art{background-position:center 42%;background-size:cover}.hero:after{background:linear-gradient(90deg,#081526f5 5%,#081526c9 45%,#08152635 100%)}@media(max-width:700px){.hero-art{opacity:.8}.hero:after{background:linear-gradient(90deg,#081526ed,#08152685)}} .hero{display:block;padding:0;min-height:0;background:#0d1e32}.hero-art{position:relative;inset:auto;z-index:auto;width:100%;aspect-ratio:16/9;background-position:center center;background-size:cover;opacity:1;animation:none}.hero:after{display:none}.hero-copy{position:relative;max-width:none;padding:clamp(1rem,3vw,2rem);background:#0d1e32}.hero h1{max-width:850px}.hero .eyebrow{margin-top:0}@media(max-width:700px){.hero{min-height:0}.hero-art{opacity:1;aspect-ratio:4/3;background-position:center center}.hero-copy{padding:1rem}} .hero-art{background:none;aspect-ratio:auto}.hero-art img{display:block;width:100%;height:auto;max-height:440px;object-fit:contain;background:#081526}#statewide-search{display:block;width:100%;box-sizing:border-box;padding:.8rem;background:#142740;color:white;border:1px solid #8295ae;border-radius:8px;font:inherit}</style></head><body>
<a class="skip" href="#main">{t('Skip to content','Ir al contenido')}</a>
<header><a class="brand" href={es?'/es/':'/'}><img src="/images/texas-clock.svg" alt="" width="38" height="38"/> <span>TEXAS TAXPAYER CLOCK</span></a><nav aria-label={t('Language','Idioma')}><a href="/" lang="en" aria-label="English">🇺🇸 EN</a> · <a href="/es/" lang="es" aria-label="Español">🇵🇷 ES</a></nav><details><summary aria-label={t('Navigation menu','Menú de navegación')}><span aria-hidden="true">☰</span></summary><a href="#taxes">{t('Taxes','Impuestos')}</a><a href="#debt">{t('Debt','Deuda')}</a><a href="#explorer">{t("Government explorer","Explorador de gobiernos")}</a><a href="#sources">{t('Sources','Fuentes')}</a></details></header>
<main id="main"><section class="hero"><div class="hero-art"><img src="https://commons.wikimedia.org/wiki/Special:FilePath/Texas_Capitol_night.jpg?width=1200" alt={t("Texas State Capitol at night","Capitolio de Texas de noche")} width="1200" height="900" /></div><div class="hero-copy"><p class="eyebrow">{t('Independent financial transparency','Transparencia financiera independiente')}</p><h1>{t('254 Counties. Thousands of Governments. Your Money.','254 condados. Miles de gobiernos. Su dinero.')}</h1><p>{t('Follow the Debt. Follow the Taxes. Follow the Money.','Siga la deuda. Siga los impuestos. Siga el dinero.')}</p></div></section>
<p class="photo-credit"><a href="https://commons.wikimedia.org/wiki/File:Texas_Capitol_night.jpg">Photo: Larry D. Moore</a> · <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> · {t('Displayed with crop','Con recorte')}</p><section id="taxes" aria-labelledby="tax-title"><div class="headline"><p class="eyebrow">{t('Reported Texas taxes · 2023','Impuestos reportados de Texas · 2023')}</p><h2 id="tax-title">{money(taxes.total)}</h2><p>{t('Annual reported total, not a live balance','Total anual reportado, no saldo en tiempo real')}</p><a href={taxes.source}>{t('Official report · Exhibit 1, p. 5','Informe oficial · Cuadro 1, p. 5')}</a></div>
<div class="grid">{cards.map(c=><article><h3>{c.name}</h3><strong>{money(c.value)}</strong><small>2023</small></article>)}</div>
<article class="rate"><h3>{t('Average annual equivalent per second','Equivalente anual promedio por segundo')}</h3><strong>{(taxes.total/31536000).toLocaleString('en-US',{style:'currency',currency:'USD'})}</strong><p>{t('Annual total divided by 365 days. Not actual live collections.','Total anual dividido entre 365 días. No representa recaudación en tiempo real.')}</p></article></section>
<section aria-labelledby="clock-title"><article class="clock"><h2 id="clock-title">{t('Historical tax clock','Reloj histórico de impuestos')}</h2><p>{t('Modeled amount since this page opened, using the 2023 annual tax total.','Monto estimado desde que abrió esta página, según el total anual de impuestos de 2023.')}</p><strong id="modeled-clock" data-rate={taxes.total/31536000}>$0.00</strong><p>{t('Illustration only. Not actual collections or a current-year estimate.','Solo ilustrativo. No representa recaudación real ni una estimación del año actual.')}</p><button id="clock-toggle" type="button" data-pause={t('Pause','Pausar')} data-resume={t('Resume','Continuar')}>{t('Pause','Pausar')}</button><button id="clock-reset" type="button">{t('Reset','Reiniciar')}</button><noscript>{t('Animation requires JavaScript.','La animación requiere JavaScript.')}</noscript></article></section>
<section id="debt"><h2>{t('Government debt','Deuda gubernamental')} · FY 2025</h2><div class="grid">{[{name:t('State principal','Principal estatal'),value:debt.state.principal,url:debt.state.source},{name:t('Local principal','Principal local'),value:debt.local.principal,url:debt.local.source},{name:t('Local tax-supported debt','Deuda local respaldada por impuestos'),value:debt.local.tax,url:debt.local.source},{name:t('Local revenue-supported debt','Deuda local respaldada por ingresos'),value:debt.local.revenue,url:debt.local.source}].map(c=><article><h3>{c.name}</h3><strong>{money(c.value)}</strong><small>2025-08-31</small><a href={c.url}>{t('Official dataset','Datos oficiales')}</a></article>)}</div><p>{t('Reported outstanding principal, not total repayment or live borrowing. State and local balances are not consolidated.','Principal pendiente reportado, no pago total ni endeudamiento en tiempo real. Los saldos estatales y locales no están consolidados.')}</p><p>{t('Remaining interest and total repayment: pending source-level verification.','Intereses restantes y pago total: pendientes de verificación.')}</p><details><summary>{t('Source discrepancies under review','Discrepancias entre fuentes en revisión')}</summary><p>{t('Other official reports show different FY 2025 balances. The figures above use the BRB Data Center series; differences remain unresolved.','Otros informes oficiales muestran saldos distintos para 2025. Las cifras anteriores corresponden al centro de datos BRB; las diferencias siguen sin resolverse.')}</p>{debt.discrepancies.map(d=><p><a href={d.source}>{d.id} · {t('Official report','Informe oficial')}</a></p>)}</details></section>
<section id="debt-leaderboard"><h2>{t('Texas Debt Leaderboard','Clasificación de deuda de Texas')}</h2><p>{t('Compare 3,319 FY 2025 reporting entities by principal, interest and repayment.','Compare 3,319 entidades del AF 2025 por principal, intereses y pagos.')}</p><a href={es?'/es/debt/':'/debt/'}>{t('Explore statewide debt rankings','Explorar clasificación estatal de deuda')}</a></section><section id="explorer"><h2>{t('Government Explorer','Explorador de gobiernos')}</h2><p>{t('Pilot profiles · FY 2025 local debt records.','Perfiles piloto · deuda local del año fiscal 2025.')}</p><label for="gov-search">{t('Find a government','Buscar un gobierno')}</label><input id="gov-search" type="search" placeholder={t('City, county or school district','Ciudad, condado o distrito escolar')}/><ul id="gov-results">{governments.map(g=><li data-name={g.name.toLowerCase()}><a href={(es?'/es':'')+'/government/'+g.id+'/'}>{g.name}</a></li>)}</ul><p id="gov-empty" hidden>{t('No matches in pilot directory.','Sin coincidencias en el directorio piloto.')}</p></section>
<section id="statewide"><h2>{t('Statewide property tax directory','Directorio estatal de impuestos sobre propiedades')}</h2><p>{t('Official taxing unit IDs and annual rates per $100 taxable value. Missing rates are not zero.','Identificadores oficiales y tasas anuales por cada $100 de valor imponible. Datos faltantes no equivalen a cero.')}</p><label for="statewide-search">{t('Search name or taxing unit ID','Buscar nombre o identificador')}</label><input id="statewide-search" type="search" placeholder="Copperas Cove" /><p id="statewide-status" role="status">{t('Loading official directory…','Cargando directorio oficial…')}</p><div id="statewide-results"></div><a href="https://comptroller.texas.gov/taxes/property-tax/rates/index.php">{t('Official source','Fuente oficial')}</a></section><script>
const q=document.querySelector<HTMLInputElement>('#statewide-search'),out=document.querySelector<HTMLElement>('#statewide-results'),status=document.querySelector<HTMLElement>('#statewide-status');
if(q&&out&&status){const es=document.documentElement.lang==='es';fetch('/data/tax-units.json').then(r=>{if(!r.ok)throw Error();return r.json()}).then((units:{id:string,name:string,rates:Record<string,number|null>}[])=>{const render=()=>{const term=q.value.trim().toLowerCase();const matches=term?units.filter(u=>(u.name+(u.id.endsWith('-000-00')?' County Condado':'')+' '+u.id).toLowerCase().includes(term)):[];status.textContent=term?String(matches.length)+(es?' coincidencias':' matches'):(es?'Escriba un nombre.':'Enter a name to search.')+' ('+units.length+')';out.replaceChildren();for(const u of matches.slice(0,50)){const a=document.createElement('article'),h=document.createElement('h3');h.textContent=(u.id.endsWith('-000-00')?u.name+' County':u.name)+' · '+u.id;a.append(h);const link=document.createElement('a');const aliases:Record<string,string>={"227-104-03":"austin","141-000-00":"lampasas-county","050-101-03":"copperas-cove","050-902-02":"gatesville-isd","050-102-03":"gatesville","014-000-00":"bell-county","050-000-00":"coryell-county","050-910-02":"copperas-cove-isd"};link.href=(es?'/es':'')+'/government/'+(aliases[u.id]||u.id)+'/';link.textContent=es?'Ver perfil financiero':'View financial profile';a.append(link);for(const y of ['2021','2022','2023','2024','2025']){const p=document.createElement('p');const v=u.rates[y];p.textContent=y+': '+(v==null?(es?'No disponible':'Unavailable'):'$'+v.toFixed(6));a.append(p)}out.append(a)}};q.addEventListener('input',render);render()}).catch(()=>{status.textContent=es?'Importación pendiente.':'Data import pending.'})}
</script><section id="sources"><h2>{t('Source library','Biblioteca de fuentes')}</h2><p><a href={taxes.source}>Texas Comptroller · 2022–2023</a></p><p><a href="https://www.brb.texas.gov/">Texas Bond Review Board</a></p><p>{t('Historical snapshots are not live transactions. Missing figures are not zero.','Los datos históricos no son transacciones en tiempo real. Los datos faltantes no son cero.')}</p></section></main><footer>Texas Taxpayer Clock</footer><script>
const display=document.querySelector<HTMLElement>('#modeled-clock');
const toggle=document.querySelector<HTMLButtonElement>('#clock-toggle');
const reset=document.querySelector<HTMLButtonElement>('#clock-reset');
if(display && toggle && reset){
 const rate=Number(display.dataset.rate);
 const reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 let running=!reduced, elapsed=0, started=performance.now();
 const format=new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'});
 const render=()=>{display.textContent=format.format(rate*(elapsed+(running?performance.now()-started:0))/1000);};
 const label=()=>{toggle.textContent=running?toggle.dataset.pause!:toggle.dataset.resume!;};
 toggle.addEventListener('click',()=>{if(running)elapsed+=performance.now()-started;else started=performance.now();running=!running;label();render();});
 reset.addEventListener('click',()=>{elapsed=0;started=performance.now();render();});
 label();render();window.setInterval(()=>{if(running&&!document.hidden)render();},250);
}
const search=document.querySelector<HTMLInputElement>('#gov-search');
const entries=Array.from(document.querySelectorAll<HTMLElement>('#gov-results li'));
const empty=document.querySelector<HTMLElement>('#gov-empty');
search?.addEventListener('input',()=>{const q=search.value.trim().toLowerCase();let count=0;for(const e of entries){e.hidden=!(e.dataset.name||'').includes(q);if(!e.hidden)count++;}if(empty)empty.hidden=count!==0;});
</script></body></html>

---
import sales from '../../public/data/local-sales-tax-2026-11.json';
import crosswalk from '../data/sales-tax-crosswalk.json';
const {g,lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const key=(crosswalk as Record<string,(string|null)[]>)[g.taxId];
const row=sales.records.find(r=>key&&r[0]===key[0]&&r[1]===key[1]&&(r[2]??'')===(key[2]??''));
const money=(v:number|null)=>v==null?t('Unavailable','No disponible'):new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(v);
---
<section aria-labelledby="local-clock-title" class="local-clock"><h2 id="local-clock-title">{t('Government financial clock','Reloj financiero gubernamental')}</h2><article><h3>{t('Outstanding principal · FY2025','Principal pendiente · AF2025')}</h3><strong>{money(g.principal)}</strong><small>{t('Reported balance, not live debt.','Saldo reportado, no deuda en tiempo real.')}</small></article><div class="local-clock-grid">{[{n:t('Remaining interest · FY2025','Intereses restantes · AF2025'),v:g.interest},{n:t('Reported repayment · FY2025','Pago reportado · AF2025'),v:g.repayment}].map(c=><article><h3>{c.n}</h3><strong>{money(c.v)}</strong></article>)}{row&&<><article><h3>{t('Sales tax allocations · Jan–Nov 2026','Asignaciones de ventas · ene–nov 2026')}</h3><strong>{money(Number(row[6])/100)}</strong></article><article><h3>{t('Modeled daily allocation','Asignación diaria simulada')}</h3><strong data-local-rate={Number(row[6])/100/334/86400}>—</strong><small>{t('Illustration since midnight Central Time, based on Jan–Nov 2026 average. Not actual payments.','Ilustración desde medianoche hora central, basada en el promedio ene–nov 2026. No son pagos reales.')}</small><p><button id="local-pause" data-pause={t('Pause','Pausar')} data-resume={t('Resume','Continuar')}>{t('Pause','Pausar')}</button></p></article></>}</div><p>{t('Missing figures are not zero. See detailed sources and reporting periods below.','Los datos ausentes no son cero. Consulte fuentes y períodos detallados abajo.')}</p></section><style>.local-clock{border:1px solid #b99a5d;border-radius:12px;padding:1rem}.local-clock-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem}.local-clock-grid article{min-width:0;margin:0}.local-clock button{font:inherit;padding:.5rem;background:#e1bd75;color:#081526;border:0;border-radius:5px}.local-clock button:focus-visible{outline:3px solid white}@media(max-width:400px){.local-clock-grid{grid-template-columns:1fr}}</style><script>const el=document.querySelector<HTMLElement>('[data-local-rate]'),btn=document.querySelector<HTMLButtonElement>('#local-pause');if(el&&btn){let run=!matchMedia('(prefers-reduced-motion: reduce)').matches;const fmt=new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:2});const time=new Intl.DateTimeFormat('en-US',{timeZone:'America/Chicago',hourCycle:'h23',hour:'2-digit',minute:'2-digit',second:'2-digit'});const render=()=>{const parts=time.formatToParts(new Date());const get=(k:string)=>Number(parts.find(p=>p.type===k)?.value??0);el.textContent=fmt.format(Number(el.dataset.localRate)*(get('hour')*3600+get('minute')*60+get('second')))};const label=()=>{btn.textContent=run?btn.dataset.pause!:btn.dataset.resume!};btn.onclick=()=>{run=!run;label();if(run)render()};render();label();setInterval(()=>{if(run&&!document.hidden)render()},1000)}</script>
---
const {lang}=Astro.props;const es=lang==='es',t=(a:string,b:string)=>es?b:a;
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Household taxpayer burden','Carga tributaria familiar')} | Texas Taxpayer Clock</title><style is:inline>body{background:#081526;color:#f4f6fa;font:1rem system-ui;margin:0}main{max-width:850px;margin:auto;padding:1rem}a,h1,strong{color:#e1bd75}nav{display:flex;gap:1rem;flex-wrap:wrap}label{display:grid;gap:.35rem;margin:.7rem 0}input,button{font:inherit;padding:.65rem;background:#142740;color:white;border:1px solid #8190a4;border-radius:6px;box-sizing:border-box;max-width:100%}article,fieldset{background:#142740;border:1px solid #42536a;border-radius:8px;padding:1rem;margin:.7rem 0;min-width:0}strong{font-size:1.6rem} :focus-visible{outline:3px solid #e1bd75} .pair{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:.7rem}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href="/household-burden/">🇺🇸 EN</a><a href="/es/household-burden/">🇵🇷 ES</a></nav><h1>{t('Household taxpayer burden calculator','Calculadora de carga tributaria familiar')}</h1><p>{t('Enter your own taxable values and adopted rates from official tax statements. This is an estimate, not a tax bill. No inputs are transmitted or saved.','Ingrese valores imponibles y tasas adoptadas de documentos oficiales. Es una estimación, no una factura. No se transmiten ni guardan datos.')}</p><form id="calc"><fieldset><legend>{t('Annual property taxes','Impuestos anuales sobre propiedades')}</legend>{[t('City','Ciudad'),t('County','Condado'),t('School district','Distrito escolar'),t('Other district 1','Otro distrito 1'),t('Other district 2','Otro distrito 2'),t('Other district 3','Otro distrito 3')].map((name,i)=><div><h2 style="font-size:1rem">{name}</h2><div class="pair"><label>{t('Taxable value ($)','Valor imponible ($)')}<input id={'v'+i} type="number" min="0" max="1000000000" step="any" placeholder="0"/></label><label>{t('Rate per $100 taxable value','Tasa por $100 de valor imponible')}<input id={'r'+i} type="number" min="0" max="100" step="any" placeholder="0"/></label></div><p id={'p'+i}>—</p></div>)}</fieldset><fieldset><legend>{t('Other household costs','Otros costos familiares')}</legend><label>{t('Annual purchases subject to sales tax ($)','Compras anuales sujetas a impuesto sobre ventas ($)')}<input id="spend" type="number" min="0" max="1000000000" step="any"/></label><label>{t('Combined sales tax rate (%)','Tasa combinada de impuesto sobre ventas (%)')}<input id="sales" type="number" min="0" max="100" step="any"/></label><label>{t('Monthly government fees, excluding taxes already counted ($)','Cargos gubernamentales mensuales, sin impuestos ya contados ($)')}<input id="fees" type="number" min="0" max="1000000000" step="any"/></label><label>{t('Annual gross household income (optional)','Ingreso familiar bruto anual (opcional)')}<input id="income" type="number" min="0" max="1000000000" step="any"/></label></fieldset><button type="submit">{t('Calculate','Calcular')}</button> <button type="reset">{t('Clear','Borrar')}</button></form><section aria-live="polite"><h2>{t('Estimated costs entered','Costos estimados ingresados')}</h2>{[['property',t('Property taxes','Impuestos sobre propiedades')],['salesout',t('Sales taxes (state and local combined)','Impuestos sobre ventas (estatal y local)')],['feesout',t('Annual government fees','Cargos gubernamentales anuales')],['annual',t('Combined annual estimate','Estimación anual combinada')],['monthly',t('Monthly equivalent','Equivalente mensual')],['daily',t('Daily equivalent','Equivalente diario')],['share',t('Share of gross household income','Proporción del ingreso bruto')]].map(([id,label])=><article><p>{label}</p><strong id={id}>—</strong></article>)}</section><p>{t('Blank entries are excluded, not evidence of zero tax. Use a separate taxable value for each jurisdiction after applicable exemptions. This estimate excludes federal taxes and unentered charges. Debt per resident is not a household bill and is not included.','Campos vacíos excluidos, no evidencia de impuesto cero. Use valor imponible separado por jurisdicción tras exenciones aplicables. Excluye impuestos federales y cargos no ingresados. Deuda por habitante no es factura familiar y no se incluye.')}</p><a href="https://comptroller.texas.gov/taxes/property-tax/">{t('Texas property tax official information','Información oficial de impuestos sobre propiedades')}</a></main><script define:vars={{es}}>
const by=id=>document.getElementById(id),form=by('calc'),read=id=>by(id).value===''?null:by(id).valueAsNumber,money=n=>n===null?'—':n.toLocaleString('en-US',{style:'currency',currency:'USD'});function calc(){if(!form.checkValidity())return;let parts=[];for(let i=0;i<6;i++){const v=read('v'+i),r=read('r'+i),p=v===null||r===null?null:v*r/100;by('p'+i).textContent=money(p);if(p!==null)parts.push(p)}const property=parts.length?parts.reduce((a,b)=>a+b,0):null,s=read('spend'),r=read('sales'),sales=s===null||r===null?null:s*r/100,f=read('fees'),fees=f===null?null:f*12,values=[property,sales,fees].filter(v=>v!==null),annual=values.length?values.reduce((a,b)=>a+b,0):null,income=read('income');for(const [id,v] of Object.entries({property,salesout:sales,feesout:fees,annual,monthly:annual===null?null:annual/12,daily:annual===null?null:annual/365}))by(id).textContent=money(v);by('share').textContent=annual!==null&&income>0?(annual/income*100).toFixed(2)+'%':'—'}form.addEventListener('submit',e=>{e.preventDefault();calc()});form.addEventListener('input',calc);form.addEventListener('reset',()=>{for(const id of ['property','salesout','feesout','annual','monthly','daily','share',...Array.from({length:6},(_,i)=>'p'+i)])by(id).textContent='—'});
</script></body></html>

---
const {lang}=Astro.props;const es=lang==='es',t=(a:string,b:string)=>es?b:a;
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Pension accountability','Responsabilidad de pensiones')} | Texas Taxpayer Clock</title><style is:inline>body{background:#081526;color:#f4f6fa;font:1rem system-ui;margin:0}main{max-width:1000px;margin:auto;padding:1rem}a,h1,strong{color:#e1bd75}nav,.controls{display:flex;gap:1rem;flex-wrap:wrap}label{display:grid;gap:.4rem;max-width:100%}input,select{font:inherit;padding:.6rem;background:#142740;color:white;border:1px solid #8190a4;border-radius:6px;max-width:100%}article{background:#142740;border:1px solid #42536a;border-radius:8px;padding:1rem;margin:.6rem 0}summary{cursor:pointer}:focus-visible{outline:3px solid #e1bd75}h2{font-size:1.1rem}p{overflow-wrap:anywhere}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href="/pensions/">🇺🇸 EN</a><a href="/es/pensions/">🇵🇷 ES</a></nav><h1>{t('Texas pension accountability','Responsabilidad de pensiones de Texas')}</h1><p>{t('Actuarial liabilities are not bond debt. Unfunded liability is calculated as accrued liability minus actuarial assets. 2026 coverage is incomplete. Conflicting plan-year records are excluded from rankings. No statewide total or allocation to participating governments is calculated.','Las obligaciones actuariales no son deuda en bonos. El pasivo no financiado se calcula restando activos actuariales del pasivo acumulado. Cobertura 2026 incompleta. Registros contradictorios excluidos de clasificaciones. Sin total estatal ni asignación a gobiernos participantes.')}</p><div class="controls"><label>{t('Plan name or ID','Nombre o ID del plan')}<input id="q" type="search"/></label><label>{t('Actuarial year','Año actuarial')}<select id="y">{Array.from({length:21},(_,i)=>2026-i).map(y=><option selected={y===2025}>{y}</option>)}</select></label><label>{t('Rank by','Clasificar por')}<select id="m"><option value="gap">{t('Unfunded liability','Pasivo no financiado')}</option><option value="9">{t('Lowest funded ratio','Menor proporción financiada')}</option><option value="7">{t('Accrued liability','Pasivo acumulado')}</option><option value="8">{t('Actuarial assets','Activos actuariales')}</option><option value="5">{t('Finite amortization years','Años de amortización finita')}</option><option value="16">{t('Employer contribution rate','Tasa de aporte patronal')}</option></select></label></div><p id="status" role="status">{t('Loading…','Cargando…')}</p><div id="results"></div><a href="https://data.prb.texas.gov/downloads.html">{t('Texas Pension Review Board · source data','Texas Pension Review Board · datos originales')}</a></main><script define:vars={{es}}>
const by=id=>document.getElementById(id),q=by('q'),y=by('y'),m=by('m');let data;const valid=Number.isFinite,missing=es?'No disponible':'Unavailable',money=v=>valid(v)?v.toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}):missing,pct=v=>valid(v)?(v*100).toFixed(2)+'%':missing,gap=r=>valid(r[7])&&valid(r[8])?r[7]-r[8]:null,key=r=>r[0]+'|'+r[4];
function line(parent,label,value){const p=document.createElement('p');p.textContent=label+': '+value;parent.append(p)}
function render(){if(!data)return;const d=data.datasets.actuarial,groups=new Map();for(const r of d.records){if(String(r[4])!==y.value)continue;const k=key(r);if(!groups.has(k))groups.set(k,[]);groups.get(k).push(r)}const metric=m.value,query=q.value.toLowerCase().trim(),value=r=>metric==='gap'?gap(r):metric==='5'&&r[6]===1?null:r[Number(metric)];const rows=[...groups.values()].map(rs=>({r:rs[0],conflict:new Set(rs.map(r=>JSON.stringify(r))).size>1}));const ranked=rows.filter(x=>!x.conflict&&valid(value(x.r))).sort((a,b)=>metric==='9'?value(a.r)-value(b.r):value(b.r)-value(a.r));const list=[...ranked.map((x,i)=>({...x,rank:i+1})),...rows.filter(x=>x.conflict||!valid(value(x.r)))].filter(x=>(x.r[0]+' '+x.r[1]).toLowerCase().includes(query));by('results').replaceChildren();by('status').textContent=list.length+(es?' planes · ':' plans · ')+ranked.length+(es?' clasificables':' rankable')+(y.value==='2026'?' · '+(es?'incompleto':'incomplete'):'');for(const x of list){const r=x.r,a=document.createElement('article'),h=document.createElement('h2');h.textContent=(x.rank?'#'+x.rank+' · ':'')+r[1];a.append(h);line(a,'ID',r[0]);if(x.conflict){line(a,es?'Advertencia':'Warning',es?'Registros contradictorios; excluido':'Conflicting records; excluded')}else{line(a,es?'Pasivo no financiado':'Unfunded liability',money(gap(r)));line(a,es?'Proporción financiada':'Funded ratio',pct(r[9]));line(a,es?'Pasivo acumulado':'Accrued liability',money(r[7]));line(a,es?'Activos actuariales':'Actuarial assets',money(r[8]));line(a,es?'Amortización':'Amortization',r[6]===1?(es?'Infinita':'Infinite'):r[5]??missing);line(a,es?'Aporte patronal':'Employer contribution',pct(r[16]));line(a,es?'Aporte del empleado':'Employee contribution',pct(r[15]));line(a,es?'Aporte determinado actuarialmente':'Actuarially determined contribution',pct(r[17]));line(a,es?'Rendimiento supuesto':'Assumed return',pct(r[12]))}for(const [kind,ds] of Object.entries(data.datasets)){const det=document.createElement('details'),s=document.createElement('summary');s.textContent=({actuarial:es?'Historial actuarial':'Actuarial history',financial:es?'Historial financiero':'Financial history',demographics:es?'Historial demográfico':'Membership history'})[kind]||kind;det.append(s);det.addEventListener('toggle',()=>{if(!det.open||det.dataset.loaded)return;det.dataset.loaded='1';const idIndex=ds.fields.indexOf('Plan ID'),yearIndex=ds.fields.indexOf('Fiscal Year');for(const row of ds.records.filter(row=>String(row[idIndex])===String(r[0])).sort((a,b)=>b[yearIndex]-a[yearIndex])){const hh=document.createElement('h3');hh.textContent=String(row[yearIndex]??missing);det.append(hh);for(let i=0;i<ds.fields.length;i++)line(det,ds.fields[i],row[i]??missing)}});a.append(det)}by('results').append(a)}}
for(const el of [q,y,m])el.addEventListener(el===q?'input':'change',render);fetch('/data/texas-pension-history.json').then(r=>{if(!r.ok)throw Error();return r.json()}).then(d=>{data=d;render()}).catch(()=>by('status').textContent=es?'Error al cargar datos.':'Unable to load data.');
</script></body></html>

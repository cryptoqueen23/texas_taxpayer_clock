---
import data from '../data/property-levies.json';
const {lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const money=(v:number)=>new Intl.NumberFormat(es?'es-US':'en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(v);
const total=(i:number)=>data.rows.reduce((s,r)=>s+Number(r[i]),0);
const rows=[...data.rows,[t('Total','Total'),'Total',total(2),total(3)]];
---
<section id="property-levies"><h2>{t('Property tax levies','Gravámenes del impuesto predial')}</h2><p>{t('Official historical snapshot: amounts levied, not actual collections. Nominal dollars.','Corte histórico oficial: montos gravados, no recaudación efectiva. Dólares nominales.')}</p><div style="overflow-x:auto" tabindex="0" role="region" aria-label={t("Historical property tax table","Tabla histórica de impuestos sobre propiedades")}><table><thead><tr><th scope="col">{t('Government type','Tipo de gobierno')}</th><th scope="col">2022</th><th scope="col">2023</th><th scope="col">{t('Change','Cambio')}</th></tr></thead><tbody>{rows.map(r=><tr><th scope="row">{r[es?1:0]}</th><td>{money(Number(r[2]))}</td><td>{money(Number(r[3]))}</td><td>{((Number(r[3])/Number(r[2])-1)*100).toFixed(2)}%</td></tr>)}</tbody></table></div><p>{t('The Comptroller calculates levies using appraisal district reports and adjustments. Later revisions may differ from this static report.','La Contraloría calcula los gravámenes con informes de tasación y ajustes. Revisiones posteriores pueden diferir de este informe.')}</p><p>{t('2023 school levy comparison: the separate district dataset totals $39,500,944,744, versus $39,496,580,852 in Exhibit 9, a difference of $4,363,892. The cause has not been independently established; both published series are retained.','Comparación escolar 2023: el conjunto por distrito suma $39,500,944,744, frente a $39,496,580,852 del cuadro 9, diferencia de $4,363,892. La causa no se ha verificado; se conservan ambas series.')}</p><a href={data.source}>{t('Official source: Exhibit 9, page 10','Fuente oficial: cuadro 9, página 10')}</a></section>

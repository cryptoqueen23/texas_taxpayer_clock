---
import data from '../../public/data/school-levies-2021-2025.json';
import {profiles} from '../data/profiles';
const {lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const links=Object.fromEntries(profiles.filter(g=>g.taxId.endsWith('-02')).map(g=>[g.taxId,g.id]));
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Texas school district rankings','Clasificación de distritos escolares de Texas')}</title><style is:inline>body{background:#081526;color:#f4f6fa;font:1rem system-ui;margin:0}main{max-width:1000px;margin:auto;padding:1rem}a,h1{color:#e1bd75}nav,.controls{display:flex;gap:1rem;flex-wrap:wrap}label{display:grid;gap:.4rem;max-width:100%}input,select,button{font:inherit;padding:.65rem;background:#142740;color:white;border:1px solid #8190a4;border-radius:6px;max-width:100%;box-sizing:border-box}a:focus-visible,input:focus-visible,select:focus-visible,button:focus-visible{outline:3px solid #e1bd75}article{background:#142740;border:1px solid #42536a;border-radius:8px;padding:.8rem;margin:.6rem 0}article h2{font-size:1rem;margin:0 0 .5rem}article strong{color:#e1bd75;font-size:1.3rem}article p{margin:.4rem 0}button:disabled{opacity:.5}.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(135px,1fr));gap:.5rem}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href="/school-rankings/">🇺🇸 EN</a><a href="/es/school-rankings/">🇵🇷 ES</a></nav><h1>{t('Texas school district financial rankings','Clasificación financiera de distritos escolares de Texas')}</h1><p>{t('Official calculated property tax levies and rates, 2021–2025. Levies are not actual collections. Rates per $100 taxable value.','Gravámenes calculados y tasas oficiales, 2021–2025. No equivalen a recaudaciones efectivas. Tasas por $100 de valor imponible.')}</p><div class="controls"><label>{t('District name or ID','Nombre o identificador')}<input id="school-search" type="search"/></label><label>{t('Year','Año')}<select id="school-year">{[2025,2024,2023,2022,2021].map(y=><option value={y}>{y}</option>)}</select></label><label>{t('Rank by','Clasificar por')}<select id="school-metric"><option value="levy">{t('Largest levy','Mayor gravamen')}</option><option value="total">{t('Highest total rate','Mayor tasa total')}</option><option value="mo">{t('Highest M&O rate','Mayor tasa M&O')}</option><option value="is">{t('Highest I&S rate','Mayor tasa I&S')}</option><option value="increase">{t('Annual levy increase (%)','Aumento anual (%)')}</option><option value="decrease">{t('Annual levy decrease (%)','Reducción anual (%)')}</option><option value="growth">{t('Levy growth since 2021 (%)','Crecimiento desde 2021 (%)')}</option></select></label></div><p id="school-status" role="status"></p><div id="school-results"></div><p><button id="school-prev">{t('Previous','Anterior')}</button> <button id="school-next">{t('Next','Siguiente')}</button></p><p>{t('Ranks are calculated before search. Missing values and percentage comparisons with missing or nonpositive baselines are excluded. Growth since 2021 requires a later year. Nominal dollars; rankings do not measure efficiency or per-household burden.','La clasificación precede a la búsqueda. Se excluyen valores faltantes y comparaciones sin base positiva. El crecimiento desde 2021 requiere un año posterior. Dólares nominales; no mide eficiencia ni carga por hogar.')}</p><a href={data.source}>{t('Official Comptroller source','Fuente oficial de la Contraloría')}</a></main><script define:vars={{data,links,es}}>
const by=id=>document.getElementById(id),search=by('school-search'),year=by('school-year'),metric=by('school-metric'),out=by('school-results'),prev=by('school-prev'),next=by('school-next');let page=0;
const money=v=>v==null?'—':v.toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}),rate=v=>v==null?'—':v.toFixed(6),pct=v=>v==null?'—':v.toFixed(2)+'%',change=(v,b)=>v==null||b==null||b<=0?null:(v/b-1)*100;
function render(){const y=year.value,m=metric.value,q=search.value.trim().toLowerCase();const rows=Object.entries(data.years[y]).map(([id,r])=>{const annual=change(r[4],data.years[Number(y)-1]?.[id]?.[4]),growth=y==='2021'?null:change(r[4],data.years['2021'][id]?.[4]);return {id,r,annual,growth,value:({levy:r[4],total:r[3],mo:r[1],is:r[2],increase:annual,decrease:annual,growth})[m]}}).filter(x=>Number.isFinite(x.value)).sort((a,b)=>(m==='decrease'?a.value-b.value:b.value-a.value)||a.id.localeCompare(b.id)).map((x,i)=>({...x,rank:i+1})).filter(x=>!q||(x.id+' '+x.r[0]).toLowerCase().includes(q));page=Math.max(0,Math.min(page,Math.ceil(rows.length/25)-1));out.replaceChildren();for(const x of rows.slice(page*25,page*25+25)){const article=document.createElement('article'),h=document.createElement('h2');h.textContent='#'+x.rank+' · ';const name=document.createElement(links[x.id]?'a':'span');name.textContent=x.r[0];if(links[x.id])name.href=(es?'/es':'')+'/government/'+links[x.id]+'/';h.append(name);article.append(h);const strong=document.createElement('strong');strong.textContent=m==='levy'?money(x.value):['total','mo','is'].includes(m)?rate(x.value):pct(x.value);article.append(strong);const details=document.createElement('p');details.textContent=(es?'Gravamen: ':'Levy: ')+money(x.r[4])+' · M&O: '+rate(x.r[1])+' · I&S: '+rate(x.r[2])+' · Total: '+rate(x.r[3]);article.append(details);const p=document.createElement('p');p.textContent=(es?'Cambio anual: ':'Annual change: ')+pct(x.annual)+' · '+(es?'Desde 2021: ':'Since 2021: ')+pct(x.growth);article.append(p);out.append(article)}by('school-status').textContent=rows.length+' '+(es?'resultados':'results')+' · '+(es?'Página ':'Page ')+(rows.length?page+1:0)+' / '+Math.ceil(rows.length/25);prev.disabled=page===0;next.disabled=(page+1)*25>=rows.length}
for(const el of [search,year,metric])el.addEventListener(el===search?'input':'change',()=>{page=0;render()});prev.onclick=()=>{page--;render()};next.onclick=()=>{page++;render()};render();
</script></body></html>

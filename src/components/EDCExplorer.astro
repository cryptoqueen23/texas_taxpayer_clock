---
import data from '../data/edc-statewide.json';
const {lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const money=(v:number)=>v.toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0});
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Texas economic development corporations','Corporaciones de desarrollo económico de Texas')}</title><style is:inline>body{background:#081526;color:#f4f6fa;font:1rem system-ui;margin:0}main{max-width:1000px;margin:auto;padding:1rem}a,h1,h2,strong{color:#e1bd75}nav{display:flex;gap:1rem;flex-wrap:wrap}article{background:#142740;border:1px solid #42536a;border-radius:8px;padding:1rem;margin:.6rem 0}h3{font-size:1rem;margin:0 0 .5rem}.values{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:.5rem}a:focus-visible{outline:3px solid #e1bd75}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href="/economic-development/">🇺🇸 EN</a><a href="/es/economic-development/">🇵🇷 ES</a></nav><p><a href={es?'/es/edc-history/':'/edc-history/'}>{t('Explore individual corporation histories','Explorar historiales individuales')}</a></p><h1>{t('Texas economic development corporations','Corporaciones de desarrollo económico de Texas')}</h1><p>{t('Statewide Type A and B EDC reported figures, FY2024–2025. 713 corporations in 2024; 710 in 2025. Not consolidated municipal accounts.','Cifras estatales de corporaciones tipo A y B, AF2024–2025. 713 corporaciones en 2024; 710 en 2025. No son cuentas municipales consolidadas.')}</p>{[[t('Sources of funds','Fuentes de fondos'),data.sources],[t('Uses of funds','Usos de fondos'),data.uses]].map(([heading,rows])=><section><h2>{heading}</h2>{(rows as (string|number)[][]).map(r=><article><h3>{r[es?1:0]}</h3><div class="values"><span>2024 · <strong>{money(Number(r[2]))}</strong></span><span>2025 · <strong>{money(Number(r[3]))}</strong></span></div><p>{t('Change','Cambio')}: {((Number(r[3])/Number(r[2])-1)*100).toFixed(2)}%</p></article>)}</section>)}<p>{t('Borrowing proceeds are not outstanding debt. Sales taxes may already appear in local allocation totals; payments to taxing units may be intergovernmental flows. Do not add these figures to statewide totals. Reported categories may differ from reported totals due to source discrepancies.','Los préstamos no son deuda pendiente. Los impuestos y pagos pueden aparecer en otros totales gubernamentales. No sumar a los totales estatales. Las categorías pueden diferir del total reportado.')}</p><a href={data.source}>{t('Official Comptroller report · Exhibits 1 and 3','Informe oficial · cuadros 1 y 3')}</a><p><a href="https://comptroller.texas.gov/transparency/reports/economic-development-corporation/">{t('Individual corporation data dashboard','Datos por corporación')}</a></p></main></body></html>

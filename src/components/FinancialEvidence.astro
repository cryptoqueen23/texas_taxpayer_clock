---
import debt from '../../public/data/local-debt-2025.json';
import units from '../../public/data/tax-units.json';
const {lang='en'}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const ids=new Set(units.map(r=>r.id));
const unmatched=debt.records.filter(r=>!ids.has(r.id));
const sum=(rows:typeof debt.records,key:'principal'|'interest'|'repayment')=>rows.reduce((s,r)=>s+r[key],0);
const principal=sum(debt.records,'principal'),interest=sum(debt.records,'interest'),repayment=sum(debt.records,'repayment');
const money=(n:number)=>n.toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0});
const differences=debt.records.map(r=>({...r,delta:r.repayment-r.principal-r.interest})).filter(r=>r.delta!==0);
const cards=[
{label:t('Outstanding principal','Principal pendiente'),value:principal,formula:'SUM(records.principal)'},
{label:t('Remaining interest','Intereses restantes'),value:interest,formula:'SUM(records.interest)'},
{label:t('Reported repayment','Total de pagos de deuda informado'),value:repayment,formula:'SUM(records.repayment)'},
{label:t('Unmatched principal (subset, not additional debt)','Principal sin coincidencia (subconjunto, no deuda adicional)'),value:sum(unmatched,'principal'),formula:'SUM(records.principal WHERE id NOT IN tax-units.id)'}
];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Financial evidence','Evidencia financiera')}</title><style>body{background:#081526;color:#f4f6fa;font:1rem/1.6 system-ui;margin:0}main{max-width:900px;margin:auto;padding:1rem}a,h1,h2{color:#e1bd75}nav{display:flex;gap:1rem;flex-wrap:wrap}article{background:#142740;padding:1rem;margin:1rem 0;border:1px solid #42536a;border-radius:8px}code,dd,strong{overflow-wrap:anywhere}dd{margin:0 0 1rem}strong{font-size:1.6rem}:focus-visible{outline:3px solid #e1bd75}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href="/evidence/">English</a><a href="/es/evidence/">Español</a></nav><h1>{t('Financial evidence: local debt','Evidencia financiera: deuda local')}</h1><p>{t('Repository calculations reproduced from published site datasets. Independent reconciliation with the original agency file remains pending.','Cálculos del repositorio reproducidos con los datos publicados en el sitio. La conciliación independiente con el archivo original de la agencia sigue pendiente.')}</p><dl><dt>{t('Reporting period','Período')}</dt><dd>{es?'AF':'FY'}{debt.fiscalYear}</dd><dt>{t('Source agency','Organismo responsable de los datos')}</dt><dd><a href="https://data.brb.texas.gov/local/">Texas Bond Review Board</a></dd><dt>{t('Recorded original filename','Nombre registrado del archivo original')}</dt><dd>{debt.sourceFile}</dd><dt>{t('Recorded original SHA-256 (not independently reverified)','SHA-256 original registrado (sin nueva verificación independiente)')}</dt><dd><code>{debt.sourceSha256}</code></dd><dt>{t('Record count','Cantidad de registros')}</dt><dd>{debt.records.length}</dd></dl><p><a href="/data/local-debt-2025.json">{t('Download site debt dataset','Descargar datos de deuda del sitio')}</a> · <a href="/data/tax-units.json">{t('Download tax directory','Descargar directorio tributario')}</a></p>{cards.map(c=><article><h2>{c.label}</h2><strong>{money(c.value)}</strong><p><code>{c.formula}</code></p></article>)}<h2>{t('Reconciliation difference','Diferencia de conciliación')}</h2><p>{money(repayment-principal-interest)} · <code>SUM(repayment) - SUM(principal) - SUM(interest)</code></p><p>{t('Reported values retained; cause unresolved.','Se conservan los valores reportados; causa sin resolver.')}</p><h2>{t('Record-level reconciliation','Conciliación por registro')}</h2><p>{differences.length} {t('records with differences; absolute differences total','registros con diferencias; suma absoluta de diferencias')} {money(differences.reduce((s,r)=>s+Math.abs(r.delta),0))}. {t('Rounding is a possible explanation, not a verified cause.','El redondeo es una explicación posible, no una causa verificada.')}</p><div style="overflow:auto" tabindex="0"><table style="width:100%;text-align:left"><thead><tr><th scope="col">ID</th><th scope="col">{t('Government','Gobierno')}</th><th scope="col">{t('Difference','Diferencia')}</th></tr></thead><tbody>{differences.map(r=><tr><td>{r.id}</td><td>{r.name}</td><td>{money(r.delta)}</td></tr>)}</tbody></table></div><h2>{t('Other unresolved publication differences','Otras diferencias pendientes entre publicaciones')}</h2><p>{t('Local dashboard principal: $365,500,296,024; site record sum: $365,500,296,028. Difference: $4.','Principal del panel local: $365,500,296,024; suma de registros del sitio: $365,500,296,028. Diferencia: $4.')}</p><p>{t('2023 school levy dataset: $39,500,944,744; Exhibit 9: $39,496,580,852. Difference: $4,363,892.','Gravámenes escolares 2023: $39,500,944,744; cuadro 9: $39,496,580,852. Diferencia: $4,363,892.')} <a href="https://comptroller.texas.gov/taxes/property-tax/docs/96-1728-22-23.pdf">{t('Exhibit 9, printed page 10','Cuadro 9, página impresa 10')}</a></p><p>{t('State debt dashboard: $77,051,105,337; recorded study figures: $77.898185 billion (Figure 2.2) and $81.31 billion (Figure 2.3). Scope and revisions unresolved.','Panel de deuda estatal: $77,051,105,337; cifras registradas del estudio: $77.898185 mil millones (figura 2.2) y $81.31 mil millones (figura 2.3). Alcance y revisiones pendientes.')} <a href="https://www.brb.texas.gov/wp-content/uploads/2026/04/DAS2026.pdf">{t('Study','Estudio')}</a></p><p>{t('Local annual report executive summary: $368.30 billion (rounded); scope and revision differences unresolved.','Resumen ejecutivo del informe local: $368.30 mil millones (redondeado); diferencias de alcance y revisión pendientes.')} <a href="https://www.brb.texas.gov/wp-content/uploads/2026/02/2025LocalARFinal.pdf">{t('Annual report','Informe anual')}</a></p><p>{t('Publication references are recorded in repository metadata; original documents have not been independently rechecked in this phase.','Las referencias constan en los metadatos del repositorio; los documentos originales no se han vuelto a verificar de forma independiente en esta fase.')}</p><p><a href={es?'/es/unmatched-debt/':'/unmatched-debt/'}>{t('Inspect unmatched records','Examinar registros sin coincidencia')}</a></p><p><a href={es?'/es/methodology/':'/methodology/'}>{t('Methodology and limitations','Metodología y limitaciones')}</a></p></main></body></html>

---
import actual from '../../public/data/tea-school-actual-2009-2025.json';
import {profiles} from '../data/profiles';
const {lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const links=Object.fromEntries(profiles.filter(g=>g.taxId.endsWith('-02')).map(g=>[g.taxId.slice(0,7).replace('-',''),g.id]));
const fields=[0,44,36,54,76,62,137];
const data=Object.fromEntries(Object.entries(actual.years).map(([y,rs])=>[y,Object.fromEntries(Object.entries(rs).map(([id,row])=>[id,fields.map(i=>row[i])]))]));
const metrics=[['spend','Operating expenditure','Gasto operativo'],['per','Operating expenditure per student','Gasto operativo por estudiante'],['admin','General administration (41,92)','Administración general (41,92)'],['share','General administration / operating expenditure (%)','Administración general / gasto operativo (%)'],['instruction','Instruction and transfers (11,95)','Instrucción y transferencias (11,95)'],['payroll','Payroll','Nómina'],['growth','Annual operating expenditure change (%)','Cambio anual del gasto operativo (%)'],['enroll','Annual enrollment change (%)','Cambio anual de matrícula (%)']];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Texas school spending explorer','Explorador de gastos escolares de Texas')}</title><style is:inline>body{background:#081526;color:#f4f6fa;font:1rem system-ui;margin:0}main{max-width:1000px;margin:auto;padding:1rem}a,h1{color:#e1bd75}nav,.controls{display:flex;gap:1rem;flex-wrap:wrap}label{display:grid;gap:.4rem;max-width:100%}input,select,button{font:inherit;padding:.65rem;background:#142740;color:white;border:1px solid #8190a4;border-radius:6px;max-width:100%;box-sizing:border-box}article{background:#142740;border:1px solid #42536a;border-radius:8px;padding:.8rem;margin:.6rem 0}article h2{font-size:1rem}strong{color:#e1bd75;font-size:1.3rem}button:disabled{opacity:.5}a:focus-visible,input:focus-visible,select:focus-visible,button:focus-visible{outline:3px solid #e1bd75}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href={es?'/es/school-rankings/':'/school-rankings/'}>{t('Tax rankings','Clasificación tributaria')}</a><a href="/school-spending/">🇺🇸 EN</a><a href="/es/school-spending/">🇵🇷 ES</a></nav><h1>{t('Texas school spending explorer','Explorador de gastos escolares de Texas')}</h1><p>{t('TEA actual all-funds results, 2009–2025. Includes charter and traditional districts. Nominal dollars, not budgets.','Resultados reales de todos los fondos de TEA, 2009–2025. Incluye distritos tradicionales y charter. Dólares nominales, no presupuestos.')}</p><div class="controls"><label>{t('District name or ID','Nombre o identificador')}<input id="q" type="search"/></label><label>{t('Year','Año')}<select id="y">{Object.keys(data).sort().reverse().map(y=><option>{y}</option>)}</select></label><label>{t('Rank by','Clasificar por')}<select id="m">{metrics.map(([k,a,b])=><option value={k}>{t(a,b)}</option>)}</select></label><label>{t('Filter','Filtro')}<select id="filter"><option value="all">{t('All entities','Todas las entidades')}</option><option value="diverge">{t('Spending up, enrollment down','Gasto sube, matrícula baja')}</option></select></label></div><p id="status" role="status"></p><div id="results"></div><button id="prev">{t('Previous','Anterior')}</button> <button id="next">{t('Next','Siguiente')}</button><p>{t('Rankings precede search and filter. Missing values excluded; ratios require positive denominators. Administration includes functions 41 and 92; instruction includes 11 and 95. Payroll overlaps functional spending. Spending per student uses fall enrollment, not ADA. These measures do not establish waste or efficiency.','Clasificación antes de búsqueda y filtro. Se excluyen datos faltantes; razones requieren denominadores positivos. Administración incluye funciones 41 y 92; instrucción 11 y 95. Nómina se superpone con gastos funcionales. Gasto por estudiante usa matrícula de otoño, no ADA. No mide desperdicio ni eficiencia.')}</p><a href="https://tea.texas.gov/about-tea/state-funding/state-funding-reports-and-data/peims-financial-data-downloads">TEA · PEIMS</a></main><script define:vars={{data,links,es}}>
const by=id=>document.getElementById(id),q=by('q'),y=by('y'),m=by('m'),filter=by('filter');let page=0;const valid=Number.isFinite,ratio=(a,b)=>valid(a)&&valid(b)&&b>0?a/b:null,change=(a,b)=>{const v=ratio(a,b);return v===null?null:(v-1)*100},money=v=>valid(v)?v.toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}):'—',pct=v=>valid(v)?v.toFixed(2)+'%':'—';
function render(){const year=y.value,metric=m.value,query=q.value.trim().toLowerCase();const rows=Object.entries(data[year]).map(([id,r])=>{const p=data[Number(year)-1]?.[id],growth=change(r[1],p?.[1]),enroll=change(r[6],p?.[6]),share=ratio(r[4],r[1]);return {id,r,growth,enroll,value:({spend:r[1],per:ratio(r[1],r[6]),admin:r[4],share:share===null?null:share*100,instruction:r[3],payroll:r[2],growth,enroll})[metric]}}).filter(x=>valid(x.value)).sort((a,b)=>b.value-a.value||a.id.localeCompare(b.id)).map((x,i)=>({...x,rank:i+1})).filter(x=>(!query||(x.id+' '+x.r[0]).toLowerCase().includes(query))&&(filter.value==='all'||(x.growth>0&&x.enroll<0)));page=Math.max(0,Math.min(page,Math.ceil(rows.length/25)-1));const out=by('results');out.replaceChildren();for(const x of rows.slice(page*25,page*25+25)){const a=document.createElement('article'),h=document.createElement('h2'),n=document.createElement(links[x.id]?'a':'span');h.textContent='#'+x.rank+' · ';n.textContent=x.r[0];if(links[x.id])n.href=(es?'/es':'')+'/government/'+links[x.id]+'/';h.append(n);a.append(h);const s=document.createElement('strong');s.textContent=['share','growth','enroll'].includes(metric)?pct(x.value):money(x.value);a.append(s);const p=document.createElement('p');p.textContent=(es?'Gasto: ':'Spending: ')+money(x.r[1])+' · '+(es?'Matrícula: ':'Enrollment: ')+(valid(x.r[6])?x.r[6].toLocaleString():'—')+' · '+(es?'Por estudiante: ':'Per student: ')+money(ratio(x.r[1],x.r[6]));a.append(p);const d=document.createElement('p');d.textContent=(es?'Cambio gasto: ':'Spending change: ')+pct(x.growth)+' · '+(es?'Cambio matrícula: ':'Enrollment change: ')+pct(x.enroll);a.append(d);out.append(a)}by('status').textContent=rows.length+' '+(es?'resultados':'results')+' · '+(rows.length?page+1:0)+' / '+Math.ceil(rows.length/25);by('prev').disabled=page===0;by('next').disabled=(page+1)*25>=rows.length}
for(const el of [q,y,m,filter])el.addEventListener(el===q?'input':'change',()=>{page=0;render()});by('prev').onclick=()=>{page--;render()};by('next').onclick=()=>{page++;render()};render();
</script></body></html>

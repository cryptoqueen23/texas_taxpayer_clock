---
const {lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('EDC historical explorer','Explorador histórico de desarrollo económico')}</title><style is:inline>body{background:#081526;color:#f4f6fa;font:1rem system-ui;margin:0}main{max-width:1000px;margin:auto;padding:1rem}a,h1,strong{color:#e1bd75}nav,.controls{display:flex;gap:1rem;flex-wrap:wrap}label{display:grid;gap:.4rem;max-width:100%}input,select,button{font:inherit;padding:.65rem;background:#142740;color:white;border:1px solid #8190a4;border-radius:6px;max-width:100%;box-sizing:border-box}article{background:#142740;border:1px solid #42536a;border-radius:8px;padding:1rem;margin:.6rem 0}h2{font-size:1.1rem}summary{cursor:pointer}button:disabled{opacity:.5}a:focus-visible,input:focus-visible,select:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid #e1bd75}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href={es?'/es/economic-development/':'/economic-development/'}>{t('Statewide report','Informe estatal')}</a><a href="/edc-history/">🇺🇸 EN</a><a href="/es/edc-history/">🇵🇷 ES</a></nav><h1>{t('Historical EDC financial explorer','Explorador financiero histórico de EDC')}</h1><p>{t('1997–2024 reported records. 2024 is incomplete; 2025 individual records unavailable. Borrowing proceeds are not outstanding debt. Cash is not necessarily unrestricted.','Registros 1997–2024. 2024 incompleto; sin registros individuales de 2025. Préstamos no equivalen a deuda pendiente. Efectivo no necesariamente disponible.')}</p><div class="controls"><label>{t('City or corporation','Ciudad o corporación')}<input id="q" type="search"/></label><label>{t('Fiscal year','Año fiscal')}<select id="y">{Array.from({length:28},(_,i)=>2024-i).map(y=><option selected={y===2023}>{y}</option>)}</select></label><label>{t('Corporation type','Tipo de corporación')}<select id="type"><option value="">{t('All','Todos')}</option><option>Type A</option><option>Type B</option></select></label><label>{t('Rank by','Clasificar por')}<select id="m"><option value="10">{t('Expenditures','Gastos')}</option><option value="7">{t('Sales tax','Impuesto sobre ventas')}</option><option value="9">{t('Total revenue','Ingresos totales')}</option><option value="11">{t('Cash balance','Saldo de efectivo')}</option><option value="4">{t('Borrowing proceeds','Bonos y préstamos')}</option><option value="gap">{t('Expenditures minus revenue','Gastos menos ingresos')}</option></select></label></div><p id="status" role="status">{t('Loading data…','Cargando datos…')}</p><div id="results"></div><button id="prev" disabled>{t('Previous','Anterior')}</button> <button id="next" disabled>{t('Next','Siguiente')}</button><p>{t('Ranks apply to numeric responses within selected year and type before text search. Exact city, type and corporation name identify historical records; name changes may split histories. Missing values are not zero. Nominal dollars.','Clasificación por respuestas numéricas del año y tipo antes de búsqueda. Historial por ciudad, tipo y nombre exactos; cambios de nombre pueden separar historiales. Datos faltantes no son cero. Dólares nominales.')}</p><a href="https://data.texas.gov/resource/5tkg-skra.csv">Texas Open Data · 5tkg-skra</a></main><script define:vars={{es}}>
const by=id=>document.getElementById(id),q=by('q'),y=by('y'),type=by('type'),m=by('m');let page=0,data;q.value=new URLSearchParams(location.search).get('q')||'';const valid=Number.isFinite,money=v=>valid(v)?v.toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}):'—',key=r=>JSON.stringify(r.slice(0,3)),gap=r=>valid(r[10])&&valid(r[9])?r[10]-r[9]:null;
const labels=es?['Impuesto sobre ventas','Ingresos totales','Gastos totales','Saldo de efectivo','Bonos y préstamos','Gastos menos ingresos']:['Sales tax','Total revenue','Total expenditures','Cash balance','Borrowing proceeds','Expenditures minus revenue'];
function detail(r){const p=document.createElement('p');p.textContent=[r[7],r[9],r[10],r[11],r[4],gap(r)].map((v,i)=>labels[i]+': '+money(v)).join(' · ');return p}
function render(){if(!data)return;const year=y.value,metric=m.value,query=q.value.trim().toLowerCase();const all=data.years[year].filter(r=>!type.value||r[1]===type.value).map(r=>({r,value:metric==='gap'?gap(r):r[Number(metric)]}));const ranked=all.filter(x=>valid(x.value)).sort((a,b)=>b.value-a.value||key(a.r).localeCompare(key(b.r))).map((x,i)=>({...x,rank:i+1}));const rows=[...ranked,...all.filter(x=>!valid(x.value))].filter(x=>x.r.slice(0,3).join(' ').toLowerCase().includes(query));page=Math.max(0,Math.min(page,Math.ceil(rows.length/25)-1));const out=by('results');out.replaceChildren();for(const x of rows.slice(page*25,page*25+25)){const a=document.createElement('article'),h=document.createElement('h2');h.textContent=(x.rank?'#'+x.rank+' · ':'')+x.r[2];a.append(h);const city=document.createElement('p');city.textContent=x.r[0]+' · '+x.r[1];a.append(city);const s=document.createElement('strong');s.textContent=money(x.value);a.append(s,detail(x.r));const hist=document.createElement('details'),sum=document.createElement('summary');sum.textContent=es?'Historial financiero':'Financial history';hist.append(sum);hist.addEventListener('toggle',()=>{if(!hist.open||hist.dataset.loaded)return;hist.dataset.loaded='1';for(const yr of Object.keys(data.years).sort().reverse()){const row=data.years[yr].find(r=>key(r)===key(x.r));if(!row)continue;const heading=document.createElement('h3');heading.textContent=yr+(yr==='2024'?(es?' · incompleto':' · incomplete'):'');hist.append(heading,detail(row))}});a.append(hist);out.append(a)}by('status').textContent=(year==='2024'?(es?'2024 incompleto · ':'2024 incomplete · '):'')+ranked.length+'/'+all.length+(es?' respuestas numéricas · ':' numeric responses · ')+rows.length+(es?' resultados · ':' results · ')+(rows.length?page+1:0)+' / '+Math.ceil(rows.length/25);by('prev').disabled=page===0;by('next').disabled=(page+1)*25>=rows.length}
for(const el of [q,y,type,m])el.addEventListener(el===q?'input':'change',()=>{page=0;render()});by('prev').onclick=()=>{page--;render()};by('next').onclick=()=>{page++;render()};fetch('/data/edc-history-1997-2024.json').then(r=>{if(!r.ok)throw Error('HTTP '+r.status);return r.json()}).then(d=>{data=d;render()}).catch(()=>{by('status').textContent=es?'No se pudieron cargar los datos.':'Unable to load data. Please reload.'});
</script></body></html>

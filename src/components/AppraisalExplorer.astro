---
import data from '../../public/data/appraisal-operations-2024-2025.json';
const {lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const metrics=[['budget','Appraisal district budget','Presupuesto del distrito de tasación'],['arbBudget','Appraisal review board budget','Presupuesto de junta de revisión'],['litigationBudget','Litigation budget','Presupuesto de litigios'],['salary','Chief appraiser base salary','Salario base del tasador jefe'],['protests','Protests filed','Protestas presentadas'],['lawsuits','Lawsuits filed','Demandas presentadas'],['litigationCost','Actual litigation costs','Costos reales de litigios'],['growth','Budget change (%)','Cambio del presupuesto (%)']];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Texas appraisal district explorer','Explorador de distritos de tasación de Texas')}</title><style is:inline>body{background:#081526;color:#f4f6fa;font:1rem system-ui;margin:0}main{max-width:1000px;margin:auto;padding:1rem}a,h1{color:#e1bd75}nav,.controls{display:flex;gap:1rem;flex-wrap:wrap}label{display:grid;gap:.4rem;max-width:100%}input,select,button{font:inherit;padding:.65rem;background:#142740;color:white;border:1px solid #8190a4;border-radius:6px;max-width:100%;box-sizing:border-box}article{background:#142740;border:1px solid #42536a;border-radius:8px;padding:.8rem;margin:.6rem 0}article h2{font-size:1rem}strong{color:#e1bd75;font-size:1.3rem}button:disabled{opacity:.5}a:focus-visible,input:focus-visible,select:focus-visible,button:focus-visible{outline:3px solid #e1bd75}dl{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.5rem}dd{margin:0;text-align:right}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href="/appraisal-districts/">🇺🇸 EN</a><a href="/es/appraisal-districts/">🇵🇷 ES</a></nav><h1>{t('Texas appraisal district explorer','Explorador de distritos de tasación de Texas')}</h1><p>{t('Comptroller operations surveys, 2024–2025. Reported budgets are not actual expenditures. District budget includes ARB operations and excludes tax collection costs. Chief appraiser salary excludes benefits and other compensation.','Encuestas de operaciones, 2024–2025. Presupuestos no equivalen a gastos reales. El presupuesto incluye la junta de revisión y excluye recaudación. El salario base excluye beneficios y otras compensaciones.')}</p><div class="controls"><label>{t('District name','Nombre del distrito')}<input id="q" type="search"/></label><label>{t('Year','Año')}<select id="y"><option>2025</option><option>2024</option></select></label><label>{t('Rank by','Clasificar por')}<select id="m">{metrics.map(([k,a,b])=><option value={k}>{t(a,b)}</option>)}</select></label></div><p id="summary"></p><p id="status" role="status"></p><div id="results"></div><button id="prev">{t('Previous','Anterior')}</button> <button id="next">{t('Next','Siguiente')}</button><p>{t('Rankings precede search. Missing responses remain unavailable and are excluded from rankings, not treated as zero. Growth requires a positive 2024 baseline. Reported totals have varying response counts. Do not add ARB budgets to district budgets.','Clasificación antes de búsqueda. Respuestas faltantes se excluyen, no son cero. Crecimiento requiere base positiva de 2024. Totales con cobertura variable. No sumar presupuesto de junta al presupuesto distrital.')}</p><details><summary>{t('Original survey definitions','Definiciones originales de encuesta')}</summary>{Object.entries(data.sources).map(([y,s])=><section><h2>{y}</h2><p>{s.file}</p>{Object.values(s.fields).map(v=><p>{v.question}</p>)}</section>)}</details><a href="https://comptroller.texas.gov/taxes/property-tax/">{t('Texas Comptroller · property tax','Contraloría de Texas · impuesto predial')}</a></main><script define:vars={{data,metrics,es}}>
const by=id=>document.getElementById(id),q=by('q'),y=by('y'),m=by('m');let page=0;const valid=Number.isFinite,fmt=(v,k)=>!valid(v)?'—':k==='growth'?v.toFixed(2)+'%':['protests','lawsuits'].includes(k)?v.toLocaleString('en-US'):v.toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:2}),growth=(r,p)=>valid(r?.budget)&&valid(p?.budget)&&p.budget>0?(r.budget/p.budget-1)*100:null;
function render(){const year=y.value,k=m.value,query=q.value.trim().toLowerCase();const all=Object.entries(data.years[year]).map(([name,r])=>({name,r,value:k==='growth'?(year==='2025'?growth(r,data.years['2024'][name]):null):r[k]}));const ranked=all.filter(x=>valid(x.value)).sort((a,b)=>b.value-a.value||a.name.localeCompare(b.name)).map((x,i)=>({...x,rank:i+1}));const ranks=new Map(ranked.map(x=>[x.name,x.rank]));const rows=[...ranked,...all.filter(x=>!valid(x.value))].filter(x=>x.name.toLowerCase().includes(query));by('summary').textContent=(es?'Respuestas numéricas: ':'Numeric responses: ')+ranked.length+' / '+all.length+(k==='growth'?'': ' · '+(es?'Total reportado: ':'Reported total: ')+fmt(ranked.reduce((s,x)=>s+x.value,0),k));page=Math.max(0,Math.min(page,Math.ceil(rows.length/25)-1));const out=by('results');out.replaceChildren();for(const x of rows.slice(page*25,page*25+25)){const a=document.createElement('article'),h=document.createElement('h2');h.textContent=(ranks.has(x.name)?'#'+ranks.get(x.name)+' · ':'')+x.name;a.append(h);const s=document.createElement('strong');s.textContent=fmt(x.value,k);a.append(s);const dl=document.createElement('dl');for(const [key,en,sp] of metrics){const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=es?sp:en;dd.textContent=fmt(key==='growth'?(year==='2025'?growth(x.r,data.years['2024'][x.name]):null):x.r[key],key);dl.append(dt,dd)}a.append(dl);out.append(a)}by('status').textContent=rows.length+' '+(es?'resultados':'results')+' · '+(rows.length?page+1:0)+' / '+Math.ceil(rows.length/25);by('prev').disabled=page===0;by('next').disabled=(page+1)*25>=rows.length}
for(const el of [q,y,m])el.addEventListener(el===q?'input':'change',()=>{page=0;render()});by('prev').onclick=()=>{page--;render()};by('next').onclick=()=>{page++;render()};render();
</script></body></html>

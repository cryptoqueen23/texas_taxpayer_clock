---
import {profiles} from '../data/profiles';
const {lang}=Astro.props;const es=lang==='es';const t=(a:string,b:string)=>es?b:a;
const options=profiles.map(g=>({id:g.id,name:g.name,taxId:g.taxId})).sort((a,b)=>a.name.localeCompare(b.name));
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('My taxpayer watchlist','Mi lista de vigilancia tributaria')} | Texas Taxpayer Clock</title><style is:inline>body{background:#081526;color:#f4f6fa;font:1rem/1.6 system-ui;margin:0}main{max-width:900px;margin:auto;padding:1rem}a,h1,h2{color:#e1bd75}article{background:#142740;border:1px solid #42536a;border-radius:10px;padding:1rem;margin:.65rem 0}input,button{font:inherit;min-height:44px;border-radius:8px;padding:.5rem}input{background:#142740;color:white;border:1px solid #8295ae;width:100%}button{background:#e1bd75;color:#081526;border:0;cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid white;outline-offset:2px}.entry{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}.entry p{margin:.25rem 0}.hint{color:#c4cfdd}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a> · <a href="/watchlist/" lang="en">English</a> · <a href="/es/watchlist/" lang="es">Español</a></nav><h1>{t('My taxpayer watchlist','Mi lista de vigilancia tributaria')}</h1><p>{t('Save government profiles for quick access on this device. No account, email or payment required.','Guarde perfiles gubernamentales para acceso rápido en este dispositivo. Sin cuenta, correo electrónico ni pago.')}</p><p class="hint">{t('Your selections stay in this browser. Clearing browser data may erase them. This is not an automatic alert or notification service.','Sus selecciones permanecen en este navegador. Borrar los datos del navegador puede eliminarlas. No es un servicio de alertas ni notificaciones automáticas.')}</p><label for="search">{t('Find a government by name or tax ID','Busque un gobierno por nombre o identificación tributaria')}</label><input id="search" type="search" autocomplete="off" placeholder={t('Search governments','Buscar gobiernos')}/><p id="status" role="status" aria-live="polite"></p><section aria-labelledby="saved-title"><h2 id="saved-title">{t('Saved governments','Gobiernos guardados')}</h2><div id="saved"></div></section><section aria-labelledby="results-title"><h2 id="results-title">{t('Search results','Resultados de búsqueda')}</h2><div id="results"></div></section></main><script define:vars={{options,es}}>
const key='ttc-watchlist-v1',search=document.querySelector('#search'),saved=document.querySelector('#saved'),results=document.querySelector('#results'),status=document.querySelector('#status');const index=new Map(options.map(g=>[g.id,g]));let selected=[];try{const x=JSON.parse(localStorage.getItem(key)||'[]');if(Array.isArray(x))selected=x.filter(id=>typeof id==='string'&&index.has(id)).slice(0,100)}catch{};const msg=(en,sp)=>es?sp:en;function persist(){try{localStorage.setItem(key,JSON.stringify(selected));return true}catch{status.textContent=msg('Browser storage unavailable; selections will last only until this page closes.','Almacenamiento no disponible; las selecciones durarán solo hasta cerrar esta página.');return false}}function renderList(target,items,isSaved){target.replaceChildren();if(!items.length){const p=document.createElement('p');p.textContent=isSaved?msg('No saved governments yet.','Aún no hay gobiernos guardados.'):msg('No matching results.','Sin resultados.');target.append(p)}for(const g of items){const article=document.createElement('article');article.className='entry';const info=document.createElement('div');const a=document.createElement('a');a.href=(es?'/es':'')+'/government/'+encodeURIComponent(g.id)+'/';a.textContent=g.name;const p=document.createElement('p');p.className='hint';p.textContent=g.taxId;info.append(a,p);const button=document.createElement('button');const has=selected.includes(g.id);button.textContent=has?msg('Remove','Quitar'):msg('Save','Guardar');button.setAttribute('aria-label',(has?msg('Remove ','Quitar '):msg('Save ','Guardar '))+g.name);button.addEventListener('click',()=>{selected=has?selected.filter(id=>id!==g.id):selected.length<100?[...selected,g.id]:selected;if(!has&&selected.length===100)status.textContent=msg('Maximum 100 saved governments.','Máximo 100 gobiernos guardados.');persist();render()});article.append(info,button);target.append(article)}}function render(){renderList(saved,selected.map(id=>index.get(id)).filter(Boolean),true);const term=search.value.trim().toLocaleLowerCase();if(!term){results.replaceChildren();status.textContent=msg('Enter a search term to find a government.','Escriba para buscar un gobierno.');return}const matches=options.filter(g=>(g.name+' '+g.taxId).toLocaleLowerCase().includes(term));renderList(results,matches.slice(0,30),false);status.textContent=matches.length+' '+msg('matches; showing up to 30.','coincidencias; se muestran hasta 30.')}search.addEventListener('input',render);render();
</script></body></html>

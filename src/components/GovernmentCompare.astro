---
import {profiles} from '../data/profiles';
import denominators from '../../public/data/local-debt-denominators-2025.json';
import historyData from '../../public/data/local-debt-history.json';
const {lang}=Astro.props;const es=lang==='es';const t=(a:string,b:string)=>es?b:a;
const data=profiles.map(g=>({id:g.id,taxId:g.taxId,name:g.name,type:g.type,rates:g.rates,principal:g.principal,interest:g.interest,repayment:g.repayment,population:(denominators.records as Record<string,(number|null)[]>)[g.taxId]?.[0]??null,history:(historyData.records as Record<string,Record<string,number[]>>)[g.taxId]??{}})).sort((a,b)=>a.name.localeCompare(b.name));
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Compare Texas governments','Comparar gobiernos de Texas')} | Texas Taxpayer Clock</title><style is:inline>body{margin:0;background:#081526;color:#f4f6fa;font:1rem/1.55 system-ui}main{max-width:1050px;margin:auto;padding:1rem}a,h1,h2{color:#e1bd75}a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid white;outline-offset:2px}input{width:100%;box-sizing:border-box;padding:.8rem;background:#142740;color:white;border:1px solid #8295ae;border-radius:8px;font:inherit}button:disabled{opacity:.55;cursor:not-allowed}button{background:#e1bd75;color:#081526;border:0;border-radius:8px;padding:.65rem;min-height:44px;font:inherit;cursor:pointer}.row{display:flex;justify-content:space-between;align-items:center;gap:.7rem;flex-wrap:wrap}.card{border:1px solid #42536a;background:#142740;padding:1rem;border-radius:10px;margin:.5rem 0;min-width:0}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:.75rem}.metric{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid #42536a;padding:.45rem 0}.metric strong{overflow-wrap:anywhere;text-align:right}.metric span{min-width:0}.card h3{overflow-wrap:anywhere}.card a{overflow-wrap:anywhere}.flag{border-left:4px solid #e1bd75;background:#20354c;padding:.7rem;margin:.5rem 0;border-radius:4px}.flag strong{display:block}.flag small{display:block;color:#c4cfdd}.hint{color:#c4cfdd}.trend{height:9px;background:#30465e;border-radius:5px;overflow:hidden;margin:.25rem 0 .6rem}.trend span{display:block;height:100%;background:#e1bd75}.trend-label{display:flex;justify-content:space-between;gap:.5rem;font-size:.85rem}#results{max-height:350px;overflow:auto;overscroll-behavior:contain}h1{font-size:clamp(1.6rem,5vw,2.5rem)}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a> · <a href="/compare/" lang="en">English</a> · <a href="/es/compare/" lang="es">Español</a></nav><h1>{t('Compare Texas governments','Compare gobiernos de Texas')}</h1><p>{t('Select up to three governments. Rates are dollars per $100 taxable value. FY2025 population-based debt is principal divided by the reported population, not household liability. Historical figures are separate annual reports, not a continuous live balance. Automated review flags are screening signals, not findings of wrongdoing.','Seleccione hasta tres gobiernos. Las tasas son dólares por cada $100 de valor imponible. La deuda por residente del AF2025 es el principal dividido por la población reportada, no una obligación familiar. Las cifras históricas son informes anuales separados. Las alertas automáticas son señales para revisar, no conclusiones de irregularidad.')}</p><label for="search">{t('Search government name or tax ID','Busque nombre del gobierno o identificación tributaria')}</label><input id="search" type="search" autocomplete="off" placeholder={t('Type to search','Escriba para buscar')}/><p id="status" role="status" aria-live="polite"></p><div id="results" role="region" aria-label={t('Government search results','Resultados de búsqueda de gobiernos')} tabindex="0"></div><h2>{t('Side-by-side comparison','Comparación lado a lado')}</h2><div id="chosen" class="cards" aria-live="polite" aria-relevant="additions removals"></div><p class="hint">{t('Not reported is not zero. Comparisons across different government types do not represent the same tax bill or population. Historical debt and tax data may have different coverage.','No reportado no significa cero. Comparar distintos tipos de gobierno no representa la misma factura tributaria ni población. La cobertura histórica de deuda e impuestos puede variar.')}</p><p><a href={es?'/es/methodology/':'/methodology/'}>{t('Methodology and limitations','Metodología y limitaciones')}</a></p></main><script define:vars={{data,es}}>
const search=document.querySelector('#search'),results=document.querySelector('#results'),chosen=document.querySelector('#chosen'),status=document.querySelector('#status');const index=new Map(data.map(g=>[g.id,g]));const label=(en,sp)=>es?sp:en;const usd=n=>n==null?label('Not reported','No reportado'):new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);let selected=[];const params=new URLSearchParams(location.search);const ids=(params.get('ids')||'').split(',').slice(0,3);for(const id of ids)if(index.has(id)&&!selected.includes(id))selected.push(id);function updateUrl(){const u=new URL(location.href);if(selected.length)u.searchParams.set('ids',selected.join(','));else u.searchParams.delete('ids');history.replaceState(null,'',u)}function node(tag,txt,cls){const n=document.createElement(tag);if(txt!=null)n.textContent=txt;if(cls)n.className=cls;return n}function metric(parent,k,v){const p=node('div',null,'metric');p.append(node('span',k),node('strong',v));parent.append(p)}function flag(parent,title,detail,source){const el=node('aside',null,'flag');el.append(node('strong',title),node('span',detail));const small=node('small',label('Review source data and reporting definitions before interpreting this change.','Revise los datos originales y las definiciones antes de interpretar el cambio.'));el.append(small);const link=node('a',label('Sources and methodology','Fuentes y metodología'));link.href=es?'/es/methodology/':'/methodology/';el.append(link);if(source==='tax'||source==='debt'){const official=node('a',source==='tax'?label('Texas Comptroller property tax data (agency reference)','Datos de impuestos del Contralor de Texas (referencia institucional)'):label('Texas Bond Review Board (agency reference)','Junta de Revisión de Bonos de Texas (referencia institucional)'));official.href=source==='tax'?'https://comptroller.texas.gov/transparency/open-data/tableau/property-tax-rates.php':'https://www.brb.texas.gov/';official.target='_blank';official.rel='noopener noreferrer';el.append(node('p',label('Official agency reference, not a verified row-level citation.','Referencia institucional oficial, no una cita verificada de la fila.')));el.append(official)}parent.append(el)}function pct(a,b){return a!=null&&b!=null&&Number.isFinite(a)&&Number.isFinite(b)&&a>0?(b-a)/a*100:null}function review(g,card){const years=['2021','2022','2023','2024','2025'];let n=0;for(let i=1;i<years.length;i++){const prev=g.rates?.[years[i-1]],cur=g.rates?.[years[i]],change=pct(prev,cur);if(change!=null&&Math.abs(change)>=20){flag(card,label('Tax-rate change needs review','Revisar cambio de tasa'),years[i-1]+'–'+years[i]+': '+(change>0?'+':'')+change.toFixed(1)+'% '+label('reported rate change','de cambio en tasa reportada'),'tax');n++}const a=g.history?.[years[i-1]]?.[0],b=g.history?.[years[i]]?.[0],dc=pct(a,b);if(dc!=null&&Math.abs(dc)>=20){flag(card,label('Debt-principal change needs review','Revisar cambio del principal de deuda'),years[i-1]+'–'+years[i]+': '+(dc>0?'+':'')+dc.toFixed(1)+'% '+label('reported principal change','de cambio en principal reportado'),'debt');n++}}if(!n)card.append(node('p',label('No changes exceeded the 20% review threshold in available adjacent-year data. This does not certify the figures.','Ningún cambio superó el umbral de revisión del 20% en los años consecutivos disponibles. Esto no certifica las cifras.'),'hint'))}function draw(){chosen.replaceChildren();if(!selected.length)chosen.append(node('p',label('Choose a government to begin.','Elija un gobierno para comenzar.')));for(const id of selected){const g=index.get(id),card=node('article',null,'card'),top=node('div',null,'row'),heading=node('h3',g.name),remove=node('button',label('Remove','Quitar'));remove.setAttribute('aria-label',label('Remove ','Quitar ')+g.name);remove.addEventListener('click',()=>{selected=selected.filter(x=>x!==id);updateUrl();draw()});top.append(heading,remove);card.append(top,node('p',g.taxId+' · '+g.type,'hint'));card.append(node('h4',label('Automatic review flags','Alertas automáticas de revisión')));review(g,card);for(const y of ['2021','2022','2023','2024','2025']){const rate=g.rates?.[y];metric(card,label('Property tax rate ','Tasa de propiedad ')+y,rate==null?label('Not reported','No reportado'):'$'+Number(rate).toFixed(6))}metric(card,label('Debt principal FY2025','Principal deuda AF2025'),usd(g.principal));metric(card,label('Reported population FY2025','Población reportada AF2025'),g.population==null?label('Not reported','No reportado'):new Intl.NumberFormat('en-US').format(g.population));metric(card,label('Debt principal per resident FY2025','Principal de deuda por residente AF2025'),g.population>0&&g.principal!=null?usd(g.principal/g.population):label('Not available','No disponible'));const trendYears=['2021','2022','2023','2024','2025'];const hist=g.history||{};const vals=trendYears.map(y=>hist[y]?.[0]??null);if(vals.some(v=>v!=null)){card.append(node('h4',label('Reported debt principal trend','Tendencia del principal de deuda reportado')));const max=Math.max(1,...vals.filter(v=>v!=null));for(let i=0;i<trendYears.length;i++){const v=vals[i],line=node('div',null,'trend-label');line.append(node('span',trendYears[i]),node('span',usd(v)));card.append(line);const bar=node('div',null,'trend');bar.setAttribute('role','img');bar.setAttribute('aria-label',trendYears[i]+': '+usd(v));const fill=node('span');fill.style.width=v==null?'0%':Math.max(0,Math.min(100,v/max*100))+'%';bar.append(fill);card.append(bar)}}metric(card,label('Remaining interest FY2025','Intereses restantes AF2025'),usd(g.interest));metric(card,label('Reported repayment FY2025','Pago reportado AF2025'),usd(g.repayment));const a=node('a',label('Full government profile','Perfil completo del gobierno'));a.href=(es?'/es':'')+'/government/'+encodeURIComponent(g.id)+'/';card.append(a);chosen.append(card)}renderSearch()}function renderSearch(){results.replaceChildren();const term=search.value.trim().toLocaleLowerCase();if(!term){status.textContent=label('Enter a name or tax ID.','Escriba un nombre o identificación.');return}const matches=data.filter(g=>(g.name+' '+g.taxId).toLocaleLowerCase().includes(term));status.textContent=matches.length+' '+label('matches, first 20 shown.','coincidencias, se muestran 20.');for(const g of matches.slice(0,20)){const row=node('div',null,'card row'),info=node('div');info.append(node('strong',g.name),node('p',g.taxId,'hint'));const add=node('button',selected.includes(g.id)?label('Selected','Seleccionado'):label('Compare','Comparar'));add.disabled=selected.includes(g.id)||selected.length>=3;add.setAttribute('aria-label',label('Compare ','Comparar ')+g.name);add.addEventListener('click',()=>{if(selected.length>=3||selected.includes(g.id))return;selected.push(g.id);updateUrl();draw()});row.append(info,add);results.append(row)}}search.addEventListener('input',renderSearch);draw();
</script></body></html>

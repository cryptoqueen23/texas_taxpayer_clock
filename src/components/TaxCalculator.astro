---
import units from '../../public/data/tax-units.json';
const {lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Household Property Tax Calculator','Calculadora de impuestos sobre propiedades')}</title><style is:inline>body{background:#081526;color:#f4f6fa;font:1rem system-ui;margin:0}main{max-width:950px;margin:auto;padding:1rem}a,h1,strong{color:#e1bd75}nav{display:flex;gap:1rem;flex-wrap:wrap}label{display:grid;gap:.4rem;margin:.6rem 0}input,select,button{font:inherit;padding:.6rem;background:#142740;color:#fff;border:1px solid #8190a4;border-radius:6px;max-width:100%;box-sizing:border-box}button{cursor:pointer}article{border:1px solid #42536a;border-radius:10px;padding:1rem;margin:.8rem 0}a:focus-visible,input:focus-visible,select:focus-visible,button:focus-visible{outline:3px solid #e1bd75}strong{font-size:1.5rem}table{width:100%;border-collapse:collapse}td,th{padding:.5rem;text-align:left;border-bottom:1px solid #42536a}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href="/calculator/">🇺🇸 EN</a><a href="/es/calculator/">🇵🇷 ES</a></nav><h1>{t('Household Property Tax Calculator','Calculadora de impuestos sobre propiedades')}</h1><p>{t('Estimate annual and monthly property taxes using historical official rates. Select only jurisdictions that actually tax your property. Enter taxable value after applicable exemptions separately for each jurisdiction.','Estime impuestos anuales y mensuales con tasas oficiales históricas. Seleccione solo las jurisdicciones que gravan su propiedad. Introduzca el valor imponible después de exenciones para cada jurisdicción.')}</p><label>{t('Tax year','Año fiscal')}<select id="year">{[2025,2024,2023,2022,2021].map(y=><option>{y}</option>)}</select></label><label>{t('Find taxing unit by name or ID','Buscar entidad por nombre o identificador')}<input id="search" type="search" placeholder="Copperas Cove"/></label><label>{t('Matching jurisdictions (up to 50)','Jurisdicciones coincidentes (hasta 50)')}<select id="matches"></select></label><button id="add">{t('Add jurisdiction','Añadir jurisdicción')}</button><p id="searchstatus" role="status"></p><div id="selected"></div><article aria-live="polite"><h2>{t('Estimated total','Total estimado')}</h2><p>{t('Annual','Anual')}: <strong id="annual">N/A</strong></p><p>{t('Monthly equivalent','Equivalente mensual')}: <strong id="monthly">N/A</strong></p><p id="status"></p></article><p>{t('Not an official bill. Exemptions, appraisal caps, tax ceilings, special assessments, penalties and other charges are not automatically calculated. Monthly equivalent is annual divided by 12, not a payment schedule. No property address or values are transmitted by this calculator.','No es una factura oficial. No calcula automáticamente exenciones, límites de avalúo, topes fiscales, cuotas especiales, multas ni otros cargos. El equivalente mensual es el anual dividido por 12, no un calendario de pagos. La calculadora no transmite direcciones ni valores de propiedad.')}</p><a href="https://comptroller.texas.gov/taxes/property-tax/rates/index.php">{t('Official rate source','Fuente oficial de tasas')}</a></main><script is:inline define:vars={{units,es}}>
const byId=new Map(units.map(u=>[u.id,u])),chosen=new Map(),q=document.getElementById('search'),matches=document.getElementById('matches'),year=document.getElementById('year'),selected=document.getElementById('selected'),add=document.getElementById('add');const tr=(a,b)=>es?b:a,money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(n);const name=u=>u.name+(u.id.endsWith('-000-00')&&!/ County$/i.test(u.name)?' County':'');
function search(){const term=q.value.trim().toLowerCase();const list=term?units.filter(u=>(name(u)+' '+u.id).toLowerCase().includes(term)&&!chosen.has(u.id)):[];matches.replaceChildren();for(const u of list.slice(0,50)){const o=document.createElement('option');o.value=u.id;o.textContent=name(u)+' · '+u.id;matches.append(o)}add.disabled=!matches.value;document.getElementById('searchstatus').textContent=list.length+tr(' available matches',' coincidencias disponibles')}
function calculate(){let total=0,valid=chosen.size>0;for(const [id,v] of chosen){const rate=byId.get(id).rates[year.value];const ok=rate!=null&&v!==''&&Number.isFinite(Number(v))&&Number(v)>=0;valid=valid&&ok;const amount=ok?Number(v)*rate/100:null;if(ok)total+=amount;document.getElementById('amount-'+id).textContent=tr('Rate: ','Tasa: ')+(rate==null?tr('Unavailable','No disponible'):rate.toFixed(6))+ ' · '+(amount==null?'N/A':money(amount))}document.getElementById('annual').textContent=valid?money(total):'N/A';document.getElementById('monthly').textContent=valid?money(total/12):'N/A';document.getElementById('status').textContent=valid?tr('Estimate for selected jurisdictions only.','Estimación solo para jurisdicciones seleccionadas.'):tr('Select jurisdictions and enter all taxable values. Missing rates prevent a complete total.','Seleccione jurisdicciones e introduzca todos los valores. Las tasas faltantes impiden un total completo.')}
function render(){selected.replaceChildren();for(const [id,v] of chosen){const u=byId.get(id),a=document.createElement('article'),h=document.createElement('h2');h.textContent=name(u)+' · '+id;a.append(h);const label=document.createElement('label');label.textContent=tr('Taxable value ($)','Valor imponible ($)');const input=document.createElement('input');input.type='number';input.min='0';input.step='0.01';input.value=v;input.addEventListener('input',()=>{chosen.set(id,input.value);calculate()});label.append(input);a.append(label);const p=document.createElement('p');p.id='amount-'+id;a.append(p);const button=document.createElement('button');button.textContent=tr('Remove','Eliminar');button.onclick=()=>{chosen.delete(id);render();search()};a.append(button);selected.append(a)}calculate()}
q.addEventListener('input',search);year.addEventListener('change',calculate);add.onclick=()=>{if(byId.has(matches.value)&&!chosen.has(matches.value)){chosen.set(matches.value,'');render();search()}};search();render();
</script></body></html>
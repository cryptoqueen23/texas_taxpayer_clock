---
import catalog from '../data/commercial-catalog.json';
const {lang}=Astro.props;const es=lang==='es',t=(a:string,b:string)=>es?b:a;
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Support Texas Taxpayer Clock','Apoye Texas Taxpayer Clock')}</title><style is:inline>body{background:#081526;color:#f4f6fa;font:1rem/1.6 system-ui;margin:0}main{max-width:850px;margin:auto;padding:1rem}a,h1,h2,strong{color:#e1bd75}nav{display:flex;gap:1rem;flex-wrap:wrap}article{border:1px solid #42536a;border-radius:10px;padding:1rem;margin:1rem 0;background:#142740}a:focus-visible{outline:3px solid white}</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href="/support/" lang="en">English</a><a href="/es/support/" lang="es">Español</a></nav><h1>{t('Support independent financial transparency','Apoye la transparencia financiera independiente')}</h1><p>{t('Public financial information remains free. We are preparing optional paid services to support the platform.','La información financiera pública sigue siendo gratuita. Estamos preparando servicios opcionales de pago para sostener la plataforma.')}</p><p role="status">{t('Preview only. Proposed prices are not final. Purchases and subscriptions are not open.','Vista previa. Precios propuestos no definitivos. Compras y suscripciones aún no disponibles.')}</p>{catalog.offers.map(o=><article><h2>{es?o.es:o.en}</h2><strong>{(o.priceCents/100).toLocaleString('en-US',{style:'currency',currency:catalog.currency})} {o.interval==='year'?t('/year','/año'):o.interval==='month'?t('/month','/mes'):t('per report','por informe')}</strong><p>{o.id==='founding-supporter'?t('Help sustain the free public platform. Benefits will be announced before enrollment.','Ayude a sostener la plataforma gratuita. Los beneficios se anunciarán antes de la inscripción.'):o.id==='county-sponsor'?t('Clearly labeled advertising, subject to editorial independence rules and availability.','Publicidad identificada, sujeta a reglas de independencia editorial y disponibilidad.'):t('Research and presentation services, subject to scope and availability.','Servicios de investigación y presentación, sujetos a alcance y disponibilidad.')}</p></article>)}<h2>{t('Editorial independence','Independencia editorial')}</h2><p>{t('Payment does not buy favorable findings, changes to rankings, removal of accurate public information or influence over investigations. Sponsorships will be labeled.','El pago no compra resultados favorables, cambios en clasificaciones, eliminación de información pública correcta ni influencia sobre investigaciones. Los patrocinios serán identificados.')}</p><a href={es?'/es/methodology/':'/methodology/'}>{t('Read our methodology and limitations','Lea nuestra metodología y limitaciones')}</a></main></body></html>

---
import debt from '../../public/data/local-debt-2025.json';
import units from '../../public/data/tax-units.json';
import aliases from '../data/profile-aliases.json';
import denominators from '../../public/data/local-debt-denominators-2025.json';
const {lang}=Astro.props;
const den=denominators.records as Record<string,(number|null)[]>;
const ratio=(n:number,d:number|null|undefined,m=1)=>d!=null&&d>0?n/d*m:null;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const types=[...new Set(debt.records.map(r=>r.type))].sort();
const ids=new Set(units.map(u=>u.id));
const records=debt.records.map(r=>({...r,perResident:['CITY','COUNTY'].includes(r.type)?ratio(r.principal,den[r.id]?.[0]):null,repaymentPerResident:['CITY','COUNTY'].includes(r.type)?ratio(r.repayment,den[r.id]?.[0]):null,perADA:r.type==='ISD'?ratio(r.principal,den[r.id]?.[4]):null,valueRatio:ratio(r.principal,den[r.id]?.[2],100),budgetRatio:ratio(r.principal,den[r.id]?.[3],100),profile:ids.has(r.id)?(aliases as Record<string,string>)[r.id]??r.id:null}));
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t('Texas Debt Leaderboard','Clasificación de deuda de Texas')}</title><style is:inline>
body{background:#081526;color:#f4f6fa;font:1rem system-ui;margin:0}main{max-width:1100px;margin:auto;padding:1rem}a,h1{color:#e1bd75}nav,.controls{display:flex;gap:1rem;flex-wrap:wrap}label{display:grid;gap:.4rem}input,select,button{font:inherit;padding:.6rem;background:#142740;color:#fff;border:1px solid #8190a4;border-radius:6px}button{cursor:pointer}a:focus-visible,input:focus-visible,select:focus-visible,button:focus-visible{outline:3px solid #e1bd75}table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}th,td{padding:.7rem;text-align:left;border-bottom:1px solid #42536a}td:last-child{text-align:right;white-space:nowrap}.scroll{overflow:auto}button:disabled{opacity:.5}
</style></head><body><main><nav><a href={es?'/es/':'/'}>{t('Home','Inicio')}</a><a href="/debt/">🇺🇸 EN</a><a href="/es/debt/">🇵🇷 ES</a></nav><h1>{t('Texas Debt Leaderboard','Clasificación de deuda de Texas')}</h1><p>{t('FY 2025 · 3,319 reporting entities. Historical balances, not live debt. Absolute debt is not a measure of affordability or financial health.','AF 2025 · 3,319 entidades informantes. Saldos históricos, no deuda en tiempo real. La deuda absoluta no mide la capacidad de pago ni la salud financiera.')}</p><div class="controls"><label>{t('Government name or ID','Nombre o identificador')}<input id="search" type="search"/></label><label>{t('Government type (source codes)','Tipo de gobierno (códigos de fuente)')}<select id="type"><option value="">{t('All types','Todos los tipos')}</option>{types.map(x=><option value={x}>{({CITY:t('City','Ciudad'),COUNTY:t('County','Condado'),ISD:t('School district','Distrito escolar'),WD:t('Water district','Distrito de agua')} as Record<string,string>)[x]??x}</option>)}</select></label><label>{t('Rank by','Clasificar por')}<select id="metric"><option value="principal">{t('Outstanding principal','Principal pendiente')}</option><option value="interest">{t('Remaining interest','Intereses restantes')}</option><option value="repayment">{t('Reported repayment','Pago restante reportado')}</option><option value="perResident">{t('Principal per resident','Principal por habitante')}</option><option value="repaymentPerResident">{t('Repayment per resident','Pago por habitante')}</option><option value="perADA">{t('Principal per ADA','Principal por ADA')}</option><option value="valueRatio">{t('Principal / taxable value (%)','Principal / valor imponible (%)')}</option><option value="budgetRatio">{t('Principal / budget (%)','Principal / presupuesto (%)')}</option></select></label></div><p id="status" role="status"></p><div class="scroll" tabindex="0" aria-label={t('Debt rankings','Clasificación de deuda')}><table><thead><tr><th scope="col">#</th><th scope="col">{t('Government','Gobierno')}</th><th scope="col">{t('Type','Tipo')}</th><th scope="col">{t('Selected debt amount','Monto de deuda seleccionado')}</th></tr></thead><tbody id="results"></tbody></table></div><p><button id="prev">{t('Previous','Anterior')}</button> <button id="next">{t('Next','Siguiente')}</button></p><p>{t('Rankings apply to the selected government type before name filtering. Unmatched tax directory records remain visible without profile links. Missing entities are not assumed to have zero debt.','La clasificación se aplica al tipo seleccionado antes de filtrar por nombre. Los registros sin coincidencia permanecen visibles sin enlaces a perfiles. Las entidades ausentes no se consideran libres de deuda.')}</p><a href="https://data.brb.texas.gov/local/">{t('Texas Bond Review Board · source','Texas Bond Review Board · fuente')}</a><p>{t('Relative rankings exclude missing or nonpositive denominators. Per-resident metrics cover cities and counties; ADA covers school districts and is not enrollment. Ratios are not personal liabilities or annual debt service.','Las clasificaciones relativas excluyen denominadores faltantes o no positivos. Los indicadores por habitante cubren ciudades y condados; ADA cubre distritos escolares y no es matrícula. Los indicadores no son obligaciones personales ni servicio anual de deuda.')}</p><noscript>{t('Enable JavaScript to filter rankings.','Active JavaScript para filtrar la clasificación.')}</noscript></main><script is:inline define:vars={{records,es}}>
const q=document.getElementById('search'),type=document.getElementById('type'),metric=document.getElementById('metric'),out=document.getElementById('results'),status=document.getElementById('status'),prev=document.getElementById('prev'),next=document.getElementById('next');let page=0;const money=new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0});
function render(){const term=q.value.trim().toLowerCase();const ranked=records.filter(r=>!type.value||r.type===type.value).filter(r=>r[metric.value]!=null).sort((a,b)=>b[metric.value]-a[metric.value]||a.id.localeCompare(b.id)).map((r,i)=>({...r,rank:i+1}));const matches=ranked.filter(r=>(r.name+' '+r.id).toLowerCase().includes(term));out.replaceChildren();for(const r of matches.slice(page*50,page*50+50)){const tr=document.createElement('tr');for(const value of [r.rank,r.name,r.type,metric.value.endsWith('Ratio')?r[metric.value].toFixed(2)+'%':money.format(r[metric.value])]){const td=document.createElement('td');if(value===r.name&&r.profile){const a=document.createElement('a');a.href=(es?'/es':'')+'/government/'+r.profile+'/';a.textContent=value;td.append(a)}else td.textContent=String(value);tr.append(td)}out.append(tr)}status.textContent=matches.length+(es?' resultados · página ':' results · page ')+(page+1)+' / '+Math.max(1,Math.ceil(matches.length/50));prev.disabled=page===0;next.disabled=(page+1)*50>=matches.length}
for(const el of [q,type,metric])el.addEventListener('input',()=>{page=0;render()});prev.onclick=()=>{page--;render()};next.onclick=()=>{page++;render()};render();
</script></body></html>
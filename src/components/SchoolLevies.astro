---
import data from '../../public/data/school-levies-2021-2025.json';
const {g,lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const years=Object.keys(data.years).sort();
const rows=years.map(y=>({y,r:(data.years as Record<string,Record<string,(string|number|null)[]>>)[y][g.taxId]}));
const fmt=(v:any)=>v==null?'—':Number(v).toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0});
const rate=(v:any)=>v==null?'—':Number(v).toFixed(6);
---
{g.taxId.endsWith('-02')&&<section><h2>{t('School district calculated property tax levies','Gravámenes calculados del distrito escolar')}</h2><article class="levy-desktop" style="overflow-x:auto"><table style="width:100%;text-align:left"><thead><tr><th scope="col">{t('Year','Año')}</th><th scope="col">M&amp;O</th><th scope="col">I&amp;S</th><th scope="col">Total</th><th scope="col">{t('Levy','Gravamen')}</th><th scope="col">{t('Annual change','Cambio anual')}</th></tr></thead><tbody>{rows.map(({y,r},i)=>{const prev=rows[i-1]?.r?.[4];return <tr><td>{y}</td><td>{rate(r?.[1])}</td><td>{rate(r?.[2])}</td><td>{rate(r?.[3])}</td><td>{fmt(r?.[4])}</td><td>{r?.[4]==null||prev==null||Number(prev)<=0?'—':((Number(r[4])/Number(prev)-1)*100).toFixed(2)+'%'}</td></tr>})}</tbody></table></article><div class="levy-mobile">{[...rows].reverse().map(({y,r})=><article><h3>{y} · {fmt(r?.[4])}</h3><div class="levy-rates"><span>M&amp;O: {rate(r?.[1])}</span><span>I&amp;S: {rate(r?.[2])}</span><span>Total: {rate(r?.[3])}</span><span>{t("Levy change","Cambio del gravamen")}: {(()=>{const prev=rows[years.indexOf(y)-1]?.r?.[4];return r?.[4]==null||prev==null||Number(prev)<=0?"—":((Number(r[4])/Number(prev)-1)*100).toFixed(2)+"%"})()}</span></div></article>)}</div><p>{t('Rates per $100 taxable value. Calculated levies are not actual collections. Missing values and unavailable prior-year comparisons are shown as dashes.','Tasas por $100 de valor imponible. Los gravámenes calculados no son recaudaciones efectivas. Los guiones indican datos o comparaciones no disponibles.')}</p><a href={data.source}>{t('Official Comptroller source','Fuente oficial de la Contraloría')}</a></section>}

<style>.levy-mobile{display:none}.levy-desktop th,.levy-desktop td{padding:.4rem}.levy-rates{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;font-size:.9rem}@media(max-width:640px){.levy-desktop{display:none}.levy-mobile{display:block}}</style>
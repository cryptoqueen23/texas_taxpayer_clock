---
import data from '../../public/data/school-levies-2021-2025.json';
const {g,lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const years=Object.keys(data.years).sort();
const rows=years.map(y=>({y,r:(data.years as Record<string,Record<string,(string|number|null)[]>>)[y][g.taxId]}));
const fmt=(v:any)=>v==null?'—':Number(v).toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0});
const rate=(v:any)=>v==null?'—':Number(v).toFixed(6);
---
{g.taxId.endsWith('-02')&&<section><h2>{t('School district calculated property tax levies','Gravámenes calculados del distrito escolar')}</h2><article style="overflow-x:auto"><table style="width:100%;text-align:left"><thead><tr><th scope="col">{t('Year','Año')}</th><th scope="col">M&amp;O</th><th scope="col">I&amp;S</th><th scope="col">Total</th><th scope="col">{t('Levy','Gravamen')}</th><th scope="col">{t('Annual change','Cambio anual')}</th></tr></thead><tbody>{rows.map(({y,r},i)=>{const prev=rows[i-1]?.r?.[4];return <tr><td>{y}</td><td>{rate(r?.[1])}</td><td>{rate(r?.[2])}</td><td>{rate(r?.[3])}</td><td>{fmt(r?.[4])}</td><td>{r?.[4]==null||prev==null||Number(prev)<=0?'—':((Number(r[4])/Number(prev)-1)*100).toFixed(2)+'%'}</td></tr>})}</tbody></table></article><p>{t('Rates per $100 taxable value. Calculated levies are not actual collections. Missing values and unavailable prior-year comparisons are shown as dashes.','Tasas por $100 de valor imponible. Los gravámenes calculados no son recaudaciones efectivas. Los guiones indican datos o comparaciones no disponibles.')}</p><a href={data.source}>{t('Official Comptroller source','Fuente oficial de la Contraloría')}</a></section>}

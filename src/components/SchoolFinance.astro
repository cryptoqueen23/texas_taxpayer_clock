---
import actual from '../../public/data/tea-school-actual-2009-2025.json';
import budget from '../../public/data/tea-school-budget-2026.json';
const {g,lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const id=g.taxId.slice(0,7).replace('-','');
const years=Object.entries(actual.years).map(([y,rs])=>({y,r:(rs as Record<string,any[]>)[id]})).filter(x=>x.r).reverse();
const af=(budget.sheets['25_26 AF Bud'].records as Record<string,any[]>)[id];
const en=(budget.sheets['25_26 Enroll Bud'].records as Record<string,any[]>)[id];
const metrics=[['Operating revenue','Ingresos operativos',10,7],['Operating expenditures (object)','Gastos operativos (objeto)',44,25],['Payroll','Nómina',36,21],['Instruction and transfers (11,95)','Instrucción y transferencias (11,95)',54,31],['General administration (41,92)','Administración general (41,92)',76,42],['School leadership (23)','Dirección escolar (23)',62,35],['Transportation','Transporte',70,39],['Facilities maintenance','Mantenimiento',78,43],['Security','Seguridad',80,44],['Debt service (object)','Servicio de deuda (objeto)',46,27],['Total disbursements','Desembolsos totales',136,78]];
const fmt=(v:any)=>typeof v==='number'?v.toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}):'—';
const num=(v:any)=>typeof v==='number'?v.toLocaleString('en-US'):'—';
const latest=years.find(x=>x.y==='2025')?.r;
---
{(years.length>0||af)&&<section><h2>{t('School revenue and spending','Ingresos y gastos escolares')}</h2><p>{t('TEA all-funds actual results and separately reported budget. Nominal dollars. Budget is not actual spending. Categories overlap; do not add payroll to functional expenditures.','Resultados reales de todos los fondos y presupuesto separado de TEA. Dólares nominales. El presupuesto no es gasto real. Las categorías se superponen.')}</p><div class="finance-grid">{metrics.map(([a,b,i,j])=><article><h3>{t(String(a),String(b))}</h3><p>2025 · {t('Actual','Real')}: <strong>{fmt(latest?.[Number(i)])}</strong></p><p>2025–26 · {t('Budget','Presupuesto')}: <strong>{fmt(af?.[Number(j)])}</strong></p></article>)}</div><article><h3>{t('Enrollment and operating spending per student','Matrícula y gasto operativo por estudiante')}</h3><p>2025: {num(latest?.[137])} · {fmt(latest?.[137]>0?latest[44]/latest[137]:null)}</p><p>2025–26: {num(en?.[3])} · {fmt(en?.[3]>0&&af?.[25]!=null?af[25]/en[3]:null)}</p></article><h3>{t('Historical actual results','Resultados históricos reales')}</h3>{years.map(({y,r})=><details><summary>{y} · {t('Operating expenditures','Gastos operativos')}: {fmt(r[44])}</summary>{metrics.map(([a,b,i])=><p>{t(String(a),String(b))}: {fmt(r[Number(i)])}</p>)}<p>{t('Enrollment','Matrícula')}: {num(r[137])}</p></details>)}<p>{t('District matched by six-digit identifier. Missing values are not zero. Historical and budget definitions may differ.','Distrito vinculado por identificador de seis dígitos. Los datos faltantes no son cero. Las definiciones históricas y presupuestarias pueden diferir.')}</p><a href="https://tea.texas.gov/about-tea/state-funding/state-funding-reports-and-data/peims-financial-standard-reports">TEA · PEIMS</a></section>}
<style>.finance-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:.6rem}details{padding:.7rem;border-bottom:1px solid #42536a}summary{cursor:pointer}</style>

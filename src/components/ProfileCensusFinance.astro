---
import data from '../../public/data/texas-census-local-finance-2022-2024.json';
const {g,lang}=Astro.props;
const es=lang==='es',t=(a:string,b:string)=>es?b:a;
const county=g.taxId.endsWith('-000-00')||g.type==='COUNTY';
const norm=(s:string)=>s.trim().replace(/^city of\s+/i,'').replace(/\s+\(.*\)$/,'').toUpperCase();
const name=norm(g.name);
const matches=Object.entries(data.years).map(([year,rows])=>({year,rows:Object.entries(rows).filter(([id,r])=>id[2]===(county?'1':'2')&&norm(r.name)===name)}));
const money=(v:number)=> (v*1000).toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0});
---
<section><h2>{t('Census local finance survey','Encuesta financiera local del Censo')}</h2><p>{t('Possible records matched by government name and type only, not a verified identifier crosswalk. Confirm county and Census ID before use. Survey estimates are not audited accounts or a reliable individual-government time series.','Posibles registros por nombre y tipo de gobierno, sin equivalencia verificada de identificadores. Confirme condado e identificador del Censo. No son cuentas auditadas ni series históricas fiables.')}</p>{matches.map(({year,rows})=><article><h3>{year}</h3>{rows.length===0?<p>{t('No matching record; not zero.','Sin registro coincidente; no equivale a cero.')}</p>:rows.map(([id,r])=><details><summary>{r.name} · {r.county} · {id}</summary><p>{t('Fiscal year end (MMDD)','Cierre fiscal (MMDD)')}: {r.fiscalEnd}</p>{Object.entries(r.items).map(([code,item])=><p>{code} · {(data.codes as Record<string,string>)[code]}: {money(item[0] as number)} · {item[1]}</p>)}</details>)}</article>)}<p>{t('R = reported; I = imputed. Other flags and original item descriptions are available in the explorer. Do not sum overlapping items.','R = reportado; I = imputado. Otros indicadores y descripciones originales en el explorador. No sumar partidas superpuestas.')}</p><a href={(es?'/es':'')+'/local-finances/?q='+encodeURIComponent(name)}>{t('Open finance survey explorer','Abrir explorador financiero')}</a></section>
